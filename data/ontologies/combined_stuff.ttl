        :definition   :_1.0e-3_kilogram;
        :dimension    :mass-dimension;
        :symbol       "g" .

:Gram_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
