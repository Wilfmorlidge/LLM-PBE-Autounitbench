:Hubble_constant_at_present_epoch
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "The Hubble constant at the present epoch (a constant)."@en;
        rdfs:label        "constante van Hubble tijdens het huidige epoch"@nl , "Hubble constant at present epoch"@en;
        rdfs:subClassOf   :Hubble_constant;
        :symbol           "H_0";
        :unit_of_measure  :metre_per_second-time_per_metre , :kilometre_per_second-time_per_megaparsec .

:Hubble_constant_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
