:hertz  rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The hertz is a unit of frequency defined as 1 divided by second."@en;
        rdfs:label    "赫兹"@zh , "hertz"@nl , "hertz"@en;
        :definition   :reciprocal_second-time;
        :dimension    :frequency-dimension;
        :longcomment  "The hertz is a unit of frequency defined as 1 divided by second. The hertz is a derived unit in the International System of Units.";
        :symbol       "Hz" .

:Hertz_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :hertz;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :hertz;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:Frequency_unit  rdf:type    owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Hertz_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :hertz :reciprocal_day :reciprocal_hour :reciprocal_minute-time :reciprocal_second-time :reciprocal_year )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Hertz_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :hertz :reciprocal_day :reciprocal_hour :reciprocal_minute-time :reciprocal_second-time :reciprocal_year )
                                              ]
                                            )
                             ] .

