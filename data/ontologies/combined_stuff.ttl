:farad_per_metre  rdf:type   owl:NamedIndividual , :Unit_division;
        rdfs:label           "farad per metre"@en , "farad per meter"@nl;
        :alternative_symbol  "F·m-1" , "F m-1";
        :denominator         :metre;
