                                              ]
                                            )
                             ] .

:Electrical_resistance
        rdf:type            owl:Class , owl:NamedIndividual;
        rdfs:comment        "Electrical resistance is the degree to which an object opposes an electric current through it. It is a derived quantity in the International System of Units.  Electrical resistance is electric potential divided by electric current."@en;
        rdfs:label          "electrical resistance"@en;
        rdfs:subClassOf     :Quantity;
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :electrical_resistance-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Electrical_resistance_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :electrical_resistance-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Electrical_resistance_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        :alternative_label  "electric resistance"@en , "resistance"@en;
        :symbol             "R";
        :unit_of_measure    :teraohm , :picoohm , :petaohm , :nanoohm , :milliohm , :microohm , :megohm , :kilohm , :hectoohm , :gigaohm , :femtoohm , :abohm , :ohm , :statohm , :volt_per_ampere , :attoohm , :centiohm , :decaohm , :deciohm , :exaohm .

:statmho  rdf:type          owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The statmho is a unit of electrical conductance defined as 1.112650e-12 siemens."@en;
        rdfs:label          "statmho"@nl , "statmho"@en;
        :alternative_label  "statsiemens"@nl , "statsiemens"@en;
