    owl:cardinality "1"^^xsd:nonNegativeInteger
  ] .

<http://www.demcare.eu/ontologies/combined.owl#CountingType>
  a owl:Class ;
  owl:equivalentClass [
    a owl:Class ;
    owl:oneOf (
