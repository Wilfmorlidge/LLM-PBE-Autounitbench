:Mass   rdf:type           owl:Class , owl:NamedIndividual;
        rdfs:comment       "Mass is the amount of matter of a phenomenon. It is a base quantity in the International System of Units. Mass is force divided by acceleration."@en;
        rdfs:label         "mass"@en , "massa"@nl , "质量"@zh;
        rdfs:subClassOf    :Quantity;
        rdfs:subClassOf    [ rdf:type        owl:Restriction;
                             owl:hasValue    :mass-dimension;
                             owl:onProperty  :dimension
                           ];
        rdfs:subClassOf    [ rdf:type           owl:Restriction;
                             owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                  owl:allValuesFrom  :Mass_unit;
                                                  owl:onProperty     :unit_of_measure_or_measurement_scale
                                                ];
                             owl:onProperty     :value
                           ];
        rdfs:subClassOf    [ rdf:type        owl:Restriction;
                             owl:hasValue    :mass-dimension;
                             owl:onProperty  :dimension
                           ];
        rdfs:subClassOf    [ rdf:type           owl:Restriction;
                             owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                  owl:allValuesFrom  :Mass_unit;
                                                  owl:onProperty     :unit_of_measure_or_measurement_scale
                                                ];
                             owl:onProperty     :value
                           ];
        :symbol            "m";
        :unit_of_measure   :teragram , :picogram , :petagram , :nanounified_atomic_mass_unit , :nanogram , :milligram , :microgram , :megatonne , :megagram , :kilotonne , :kilogram , :hectogram , :gigagram , :femtogram , :exagram , :decigram , :decagram , :centigram , :attogram , :unified_atomic_mass_unit , :tonne , :ton-short_assay , :ton-short , :ton-long , :solar_mass , :slug , :pound-avoirdupois , :pound-apothecaries , :pennyweight-Troy , :ounce-avoirdupois , :gram , :International_Unit , :carat-mass , :grain , :hundredweight-British , :hundredweight-US , :milligram_RAE , :ounce-apothecaries;
        :unofficial_label  "weight" .

:Atomic_mass  rdf:type    owl:Class , owl:NamedIndividual;
        rdfs:label        "atomic mass"@en;
        rdfs:subClassOf   :Mass;
        :symbol           "m_a";
        :unit_of_measure  :teragram , :picogram , :petagram , :nanounified_atomic_mass_unit , :nanogram , :milligram , :microgram , :megatonne , :megagram , :kilotonne , :kilogram , :hectogram , :gigagram , :femtogram , :exagram , :decigram , :decagram , :centigram , :attogram , :unified_atomic_mass_unit , :tonne , :ton-short_assay , :ton-short , :ton-long , :solar_mass , :slug , :gram , :International_Unit , :carat-mass , :grain , :hundredweight-British , :hundredweight-US , :milligram_RAE , :ounce-apothecaries , :ounce-avoirdupois , :pennyweight-Troy , :pound-apothecaries , :pound-avoirdupois .

:Atomic_attenuation_coefficient
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "atomic attenuation coefficient"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "μ_a" .

:square_metre  rdf:type  owl:NamedIndividual , :Unit_exponentiation;
        rdfs:comment  "Square metre is a unit of area defined as the area of a square whose sides measure exactly one metre."@en;
        rdfs:label    "平方米"@zh , "vierkante meter"@nl , "square metre"@en;
        :base         :metre;
        :dimension    :area-dimension;
        :exponent     2;
        :longcomment  "Square metre is a unit of area defined as the area of a square whose sides measure exactly one metre. Square metre is a derived unit in the International System of Units.";
        :symbol       "m2" .

:circular_mil  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The cicular mil is a unit of area defined as 5.067075e-10 square metre."@en;
        rdfs:label    "circular mil"@en;
        :definition   :_5.067075e-10_square_metre;
        :dimension    :area-dimension .

:barn   rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The barn is a unit of area defined as 1.0e-28 square metre."@en;
        rdfs:label    "barn"@en;
        :definition   :_1.0e-28_square_metre;
        :dimension    :area-dimension;
        :symbol       "b" .

:acre-international  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment       "The international acre is a unit of area defined as 4.0468564224e3 square metre."@en;
        rdfs:label         "英亩（国际）"@zh , "acre (international)"@en;
        :alternativeLabel  "international acre"@en;
        :definition        :_4.0468564224e3_square_metre;
        :dimension         :area-dimension;
        :symbol            "ac" .

:acre-US_survey  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment       "The US survey acre is a unit of area defined as 4.046872609874252e3 square metre."@en;
        rdfs:label         "英亩（美国调查）"@zh , "acre (US survey)"@en;
        :alternativeLabel  "US survey acre"@en;
        :definition        :_4.046872609874252e3_square_metre;
        :dimension         :area-dimension;
        :symbol            "ac" .

:Square_metre_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_exponentiation;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :Metre_multiple_or_submultiple;
                                                       owl:onProperty     :base
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :base
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    "2"^^xsd:nonNegativeInteger;
                                                       owl:onProperty  :exponent
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :exponent
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :Metre_multiple_or_submultiple;
                                                       owl:onProperty     :base
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :base
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    "2"^^xsd:nonNegativeInteger;
                                                       owl:onProperty  :exponent
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :exponent
                                                     ]
                                                   )
                             ] .

:square_metre_per_square_metre
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "vierkante meter per vierkante meter"@nl , "square metre per square metre"@en;
        :alternative_symbol  "m2·m-2" , "m2 m-2";
        :denominator         :square_metre;
        :dimension           :dimension_one;
        :numerator           :square_metre;
        :symbol              "m2/m2" .

:Area_fraction_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :one :parts_per_million :percent :square_metre_per_square_metre )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :one :parts_per_million :percent :square_metre_per_square_metre )
                             ] .

:Area_fraction  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label        "oppervlaktefractie"@nl , "area fraction"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Area_fraction_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Area_fraction_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :unit_of_measure  :square_metre_per_square_metre , :percent , :parts_per_million , :one .

:kilogram_per_square_metre
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "kilogram per vierkante meter"@nl , "kilogram per square metre"@en;
        :alternative_symbol  "kg·m-2" , "kg m-2";
        :denominator         :square_metre;
        :numerator           :kilogram;
        :symbol              "kg/m2" .

:kilogram_per_hectare
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "kilogram per hectare"@nl , "kilogram per hectare"@en;
        :alternative_symbol  "kg·ha-1" , "kg ha-1";
        :denominator         :hectare;
        :numerator           :kilogram;
        :symbol              "kg/ha" .

:gram_per_square_metre
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "gram per vierkante meter"@nl , "gram per square metre"@en;
        :alternative_symbol  "g·m-2" , "g m-2";
        :denominator         :square_metre;
        :numerator           :gram;
        :symbol              "g/m2" .

:kilogram_per_hectare_day
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "kilogram per hectare day"@en , "kilogram per hectare dag"@nl;
        :alternative_symbol  "kg·ha-1·d-1" , "kg ha-1 d-1";
        :denominator         :hectare_day;
        :numerator           :kilogram;
        :symbol              "kg/(ha d)" .

:Area_density_rate_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :kilogram_per_hectare_day )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :kilogram_per_hectare_day )
                             ] .

:Area_density_rate  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label        "area density rate"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Area_density_rate_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Area_density_rate_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :unit_of_measure  :kilogram_per_hectare_day .

:Area_density_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :gram_per_square_metre :kilogram_per_hectare :kilogram_per_square_metre )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :gram_per_square_metre :kilogram_per_hectare :kilogram_per_square_metre )
                             ] .

:Area_density  rdf:type   owl:NamedIndividual , owl:Class;
        rdfs:label        "oppervlaktedichtheid"@nl , "area density"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Area_density_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Area_density_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :unit_of_measure  :kilogram_per_square_metre , :kilogram_per_hectare , :gram_per_square_metre .

:area-dimension  rdf:type              owl:NamedIndividual , :Dimension;
        rdfs:label                     "oppervlaktedimensie"@nl , "area dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  2;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    0 .

:Area_unit  rdf:type         owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Are_multiple_or_submultiple :Square_metre_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :acre-US_survey :acre-international :are :barn :circular_mil :square_metre )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Are_multiple_or_submultiple :Square_metre_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :acre-US_survey :acre-international :are :barn :circular_mil :square_metre )
                                              ]
                                            )
                             ] .

:Area   rdf:type             owl:Class , owl:NamedIndividual;
        rdfs:comment         "Area expresses the two-dimensional size of a defined part of a surface, typically a region bounded by a closed curve. It is a derived quantity in the International System of Units. Area is length squared."@en;
        rdfs:label           "area"@en , "oppervlakte"@nl , "面积"@zh;
        rdfs:subClassOf      :Quantity;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :area-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Area_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :area-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Area_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        :alternative_label   "oppervlak"@nl;
        :alternative_symbol  "S";
        :symbol              "A";
        :unit_of_measure     :square_terametre , :square_picometre , :square_petametre , :square_nanometre , :square_millimetre , :square_micrometre , :square_megametre , :square_kilometre , :square_hectometre , :square_gigametre , :square_femtometre , :square_exametre , :square_decimetre , :square_decametre , :square_centimetre , :square_attometre , :hectare , :are , :acre-US_survey , :acre-international , :barn , :circular_mil , :square_metre , :centiare .

:are    rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The are is a unit of area defined as 100 square metre."@en;
        rdfs:label    "are"@nl , "are"@en;
        :definition   :_1.0e2_square_metre;
        :dimension    :area-dimension;
        :symbol       "a" .

:Are_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :are;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :are;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:Apparent_magnitude  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "Logarithmic measure of the apparent brightness of an object. Units usually not indicated"@en;
        rdfs:label        "schijnbare magnitude"@nl , "apparent magnitude"@en;
        rdfs:subClassOf   :Magnitude;
        :symbol           "m";
        :unit_of_measure  :millimagnitude , :micromagnitude , :magnitude , :one .

:Distance_modulus  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "The difference between the apparent magnitude (m) of an astronomical object, such as a star, and its absolute magnitude (M), used as a distance measurement. Distances can be expressed in distance modulii as $$m-M = 5\\log d + 10 = 10-5 log \\varpi$$ where \\(d\\) is the distance in kiloparsec and \\(\\varpi\\) is the parallax in milliarcseconds.\n    "@en;
        rdfs:label        "distance modulus"@en;
        rdfs:subClassOf   :Distance;
        :symbol           "m-M";
        :unit_of_measure  :magnitude .

:Apparent_distance_modulus
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:label        "apparent distance modulus"@en;
        rdfs:subClassOf   :Distance_modulus;
        :unit_of_measure  :magnitude .

:Apparent_diameter  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "The angle that the actual diameter of an object makes in the sky; also known as angular size. Most often small, so units are mostly arcminutes, arcseconds, or even milli- or microarcseconds."@en;
        rdfs:label        "apparent diameter"@en;
        rdfs:subClassOf   :Plane_angle;
        :unit_of_measure  :second-plane_angle , :radian , :minute-plane_angle , :millisecond-plane_angle , :microsecond-plane_angle , :degree .

:Anticommutator_of_A_and_B
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "anticommutator of A and B"@en;
        rdfs:subClassOf  :Quantity .

:Annual_aberration  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "The component of the stellar abberation resulting from the motion of the Earth about the Sun. The abberation is the apparent angular displacement of the observed position of a celestial object from its geometric position, caused by the finite velocity of light in combination with the motions of the observer and of the observed object."@en;
        rdfs:label        "annual aberration"@en;
        rdfs:subClassOf   :Angular_displacement;
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/Glossary_Astronomical_Almanac>;
        :unit_of_measure  :second-plane_angle , :millisecond-plane_angle , :microsecond-plane_angle , :degree .

:Annihilation_operators
        rdf:type             owl:NamedIndividual , owl:Class;
        rdfs:label           "annihilation operators"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_symbol  "β" , "α" , "b";
        :symbol              "a" .

:Angular_wavenumber  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "cirkelgolfgetal"@nl , "angular wavenumber"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "k" .

:Angular_wave_vector_of_phonons
        rdf:type            owl:NamedIndividual , owl:Class;
        rdfs:label          "angular wave vector of phonons"@en;
        rdfs:subClassOf     :Angular_wave_vector;
        :alternative_label  "propagation vector of particles"@en;
        :symbol             "q" .

:Angular_wave_vector_of_particles
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "angular wave vector of particles"@en;
        rdfs:subClassOf  :Angular_wave_vector;
        :symbol          "k" .

:Angular_wave_vector  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label          "angular wave vector"@en;
        rdfs:subClassOf     :Quantity;
        :alternative_label  "propagation vector"@en;
        :symbol             "k" .

:Angular_velocity  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label        "angular velocity"@en;
        rdfs:subClassOf   :Angular_speed;
        :symbol           "ω";
        :unit_of_measure  :radian_per_second-time .

:radian_per_second-time
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "radian per second"@en , "radiaal per seconde"@nl;
        :alternative_symbol  "rad·s-1" , "rad s-1";
        :denominator         :second-time;
        :dimension           :angular_speed-dimension;
        :numerator           :radian;
        :symbol              "rad/s" .

:millisecond-plane_angle_per_year
        rdf:type      owl:NamedIndividual , :Unit_division;
        rdfs:comment  "Wordt gebruikt om de waargenomen verandering van de positie van sterren uit te drukken (de proper motion)."@en;
        rdfs:label    "milliseconde (hoek) per jaar"@nl , "millisecond (plane_angle) per year"@en;
        :denominator  :year;
        :dimension    :angular_speed-dimension;
        :numerator    :millisecond-plane_angle;
        :symbol       "mas/yr" .

:angular_speed-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "angular speed dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  0;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    -1 .

:Angular_speed_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :millisecond-plane_angle_per_year :radian_per_second-time )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :millisecond-plane_angle_per_year :radian_per_second-time )
                             ] .

:Angular_speed  rdf:type     owl:NamedIndividual , owl:Class;
        rdfs:label           "hoeksnelheid"@nl , "angular speed"@en;
        rdfs:subClassOf      :Quantity;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :angular_speed-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Angular_speed_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :angular_speed-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Angular_speed_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        :alternative_label   "hoekfrequentie"@nl , "angular frequency"@en;
        :alternative_symbol  "Ω";
        :symbol              "ω";
        :unit_of_measure     :radian_per_second-time , :millisecond-plane_angle_per_year .

:Solid_angle  rdf:type       owl:Class , owl:NamedIndividual;
        rdfs:comment         "Solid angle is the ratio of the surface of a portion of a sphere enclosed by the conical surface that forms an angle to the square of the radius of the sphere."@en;
        rdfs:label           "ruimtehoek"@nl , "solid angle"@en , "立体角"@zh;
        rdfs:subClassOf      :Quantity;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :dimension_one;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Solid_angle_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :dimension_one;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Solid_angle_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        :alternative_symbol  "ω";
        :symbol              "Ω";
        :unit_of_measure     :picosteradian , :nanosteradian , :millisteradian , :microsteradian , :square_metre_per_square_metre , :degree_squared , :second-plane_angle_squared , :steradian , :attosteradian , :centisteradian , :decisteradian , :femtosteradian .

:Angular_size  rdf:type   owl:NamedIndividual , owl:Class;
        rdfs:label        "angular size"@en;
        rdfs:subClassOf   :Solid_angle;
        :unit_of_measure  :second-plane_angle_squared , :degree_squared .

:Angular_momentum  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label           "impulsmoment"@nl , "angular momentum"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_label   "hoekmoment"@nl , "draaimoment"@nl , "draaiimpuls"@nl;
        :alternative_symbol  "J";
        :symbol              "L" .

:Angular_impulse  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "angular impulse"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "H" .

:radian_per_second-time_squared
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "radian per second squared"@en , "radiaal per seconde kwadraat"@nl;
        :alternative_symbol  "rad·s-2" , "rad s-2";
        :denominator         :second-time_squared;
        :dimension           :angular_acceleration-dimension;
        :numerator           :radian;
        :symbol              "rad/s2" .

:angular_acceleration-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "angular acceleration dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  0;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    -2 .

:Angular_acceleration_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :radian_per_second-time_squared )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :radian_per_second-time_squared )
                             ] .

:Angular_acceleration
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:label        "hoekversnelling"@nl , "angular acceleration"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :angular_acceleration-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Angular_acceleration_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :angular_acceleration-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Angular_acceleration_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "α";
        :unit_of_measure  :radian_per_second-time_squared .

:Amplitude  rdf:type      owl:NamedIndividual , owl:Class;
        rdfs:comment      "The difference between the maximum and minimum magnitudes of a variable star, i.e., the total range of its brightness."@en;
        rdfs:label        "amplitude"@en;
        rdfs:subClassOf   :Quantity;
        :unit_of_measure  :magnitude .

:Amphiphilicity  rdf:type  owl:Class;
        rdfs:label       "amphiphilicity"@en , "amfifiliciteit"@nl;
        rdfs:subClassOf  :Quantity .

:ampere  rdf:type     owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The ampere is a unit of electric current defined as the constant current that produces an attractive force of 2e–7 newton per metre of length between two straight, parallel conductors of infinite length and negligible circular cross section placed one metre apart in a vacuum."@en;
        rdfs:label    "ampère"@nl , "ampere"@en;
        :definition   :constant_current_that_produces_an_attractive_force_of_2e-7_newton_per_metre_of_length_between_two_straight_parallel_conductors_of_infinite_length_and_negligible_circular_cross_section_placed_one_metre_apart_in_a_vacuum;
        :dimension    :electric_current-dimension;
        :longcomment  "The ampere is a unit of electric current defined as the constant current that produces an attractive force of 2e–7 newton per metre of length between two straight, parallel conductors of infinite length and negligible circular cross section placed one metre apart in a vacuum. The ampere is a base unit in the International System of Units.";
        :symbol       "A" .

:SI_prefix  rdf:type     owl:Class;
        rdfs:label       "SI prefix"@en;
        rdfs:subClassOf  :Prefix .

:Ampere_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :ampere;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :ampere;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:mole   rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The mole is a unit of amount of substance defined as the amount of substance of a system that contains as many elementary entities as there are atoms in 0.012 kilogram of carbon 12."@en;
        rdfs:label    "mole"@en , "mol"@nl;
        :definition   :amount_of_substance_of_a_system_that_contains_as_many_elementary_entities_as_there_are_atoms_in_0.012_kilogram_of_carbon_12;
        :dimension    :amount_of_substance-dimension;
        :longcomment  "The mole is a unit of amount of substance defined as the amount of substance of a system that contains as many elementary entities as there are atoms in 0.012 kilogram of carbon 12. The mole is a base unit in the International System of Units.";
        :symbol       "mol" .

:Mole_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :mole;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :mole;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:Amount_of_substance_ratio
        rdf:type            owl:NamedIndividual , owl:Class;
        rdfs:label          "amount of substance ratio"@en;
        rdfs:subClassOf     :Quantity;
        :alternative_label  "mole ratio"@en , "molar ratio of solution"@en , "amount-of-substance ratio"@en;
        :symbol             "r" .

:percent  rdf:type     owl:NamedIndividual , :Singular_unit;
        rdfs:comment   "The percent is a unit of dimension one defined as 1/100."@en;
        rdfs:label     "百分"@zh , "procent"@nl , "percent"@en;
        :LaTeX_symbol  "\\%";
        :definition    :_0.01-one;
        :dimension     :dimension_one;
        :symbol        "%" .

:parts_per_million  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "Parts per million is a unit of dimension one defined as 1/1 000 000."@en;
        rdfs:label    "parts per million"@en;
        :definition   :_0.000001-one;
        :dimension    :dimension_one;
        :symbol       "ppm" .

:mole_per_mole  rdf:type     owl:NamedIndividual , :Unit_division;
        rdfs:label           "mole per mole"@en , "mol per mol"@nl;
        :alternative_symbol  "mol·mol-1" , "mol mol-1";
        :denominator         :mole;
        :dimension           :dimension_one;
        :numerator           :mole;
        :symbol              "mol/mol" .

:micromole_per_mole  rdf:type  owl:NamedIndividual , :Unit_division;
        rdfs:label           "micromole per mole"@en , "micromol per mol"@nl;
        :alternative_symbol  "μmol·mol-1" , "μmol mol-1";
        :denominator         :mole;
        :dimension           :dimension_one;
        :numerator           :micromole;
        :symbol              "μmol/mol" .

:Amount_of_substance_fraction_flow
        rdf:type            owl:Class;
        rdfs:label          "amount of substance fraction flow"@en;
        rdfs:subClassOf     :Quantity;
        :alternative_label  "mole fraction flow"@en , "amount-of-substance fraction flow"@en .

:Amount_of_substance_fraction_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :micromole_per_mole :mole_per_mole :one :parts_per_million :percent )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :micromole_per_mole :mole_per_mole :one :parts_per_million :percent )
                             ] .

:Amount_of_substance_fraction
        rdf:type             owl:Class , owl:NamedIndividual;
        rdfs:label           "amount of substance fraction"@en;
        rdfs:subClassOf      :Quantity;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :dimension_one;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Amount_of_substance_fraction_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Amount_of_substance_fraction_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :dimension_one;
                               owl:onProperty  :dimension
                             ];
        :alternative_label   "amount-of-substance fraction"@en , "mole fraction"@en , "molfractie"@nl;
        :alternative_symbol  "y";
        :symbol              "x";
        :unit_of_measure     :one , :micromole_per_mole , :mole_per_mole , :parts_per_million , :percent .

:mole_per_second-time
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "mole per second"@en , "mol per seconde"@nl;
        :alternative_symbol  "mol·s-1" , "mol s-1";
        :denominator         :second-time;
        :dimension           :catalytic_activity-dimension;
        :numerator           :mole;
        :symbol              "mol/s" .

:micromole_per_second-time
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "micromole per second"@en , "micromol per seconde"@nl;
        :alternative_symbol  "μmol·s-1" , "μmol s-1";
        :denominator         :second-time;
        :dimension           :catalytic_activity-dimension;
        :numerator           :micromole;
        :symbol              "μmol/s" .

:Amount_of_substance_flow_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :micromole_per_second-time :mole_per_second-time )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :micromole_per_second-time :mole_per_second-time )
                             ] .

:Amount_of_substance_flow
        rdf:type            owl:NamedIndividual , owl:Class;
        rdfs:label          "amount of substance flow"@en;
        rdfs:subClassOf     :Quantity;
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Amount_of_substance_flow_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Amount_of_substance_flow_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        :alternative_label  "molar flow"@en , "amount-of-substance flow"@en;
        :unit_of_measure    :mole_per_second-time , :micromole_per_second-time .

:mole_per_litre  rdf:type    owl:NamedIndividual , :Unit_division;
        rdfs:comment         "Mole per litre is a unit of amount of substance concentration defined as mole divided by litre."@en;
        rdfs:label           "mole per litre"@en , "mole per liter"@nl;
        :alternative_symbol  "mol·l-1" , "mol l-1";
        :denominator         :litre;
        :dimension           :amount_of_substance_concentration-dimension;
        :longcomment         "Mole per litre is a unit of amount of substance concentration defined as mole divided by litre. Mole per litre is a derived unit in the International System of Units.";
        :numerator           :mole;
        :symbol              "mol/l" .

:mole_per_cubic_metre
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:comment         "Mole per cubic metre is a unit of amount of substance concentration defined as mole divided by cubic metre."@en;
        rdfs:label           "mole per cubic metre"@en , "mol per kubieke meter"@nl;
        :alternative_symbol  "mol·m-3" , "mol m-3";
        :denominator         :cubic_metre;
        :dimension           :amount_of_substance_concentration-dimension;
        :longcomment         "Mole per cubic metre is a unit of amount of substance concentration defined as mole divided by cubic metre. Mole per cubic metre is a derived unit in the International System of Units.";
        :numerator           :mole;
        :symbol              "mol/m3" .

:molair  rdf:type     owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "Molair is a unit of amount of substance concentration defined as 1 mole per litre."@en;
        rdfs:label    "molair"@nl , "molair"@en;
        :definition   :mole_per_litre;
        :dimension    :amount_of_substance_concentration-dimension;
        :symbol       "M" .

