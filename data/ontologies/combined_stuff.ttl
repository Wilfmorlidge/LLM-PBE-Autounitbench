                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:Metre_multiple_or_submultiple_per_second-time_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_division;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :Second-time_multiple_or_submultiple;
                                                       owl:onProperty     :denominator
                                                     ]
                                                     [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :Metre_multiple_or_submultiple;
                                                       owl:onProperty     :numerator
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :denominator
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :numerator
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :Second-time_multiple_or_submultiple;
                                                       owl:onProperty     :denominator
                                                     ]
                                                     [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :Metre_multiple_or_submultiple;
                                                       owl:onProperty     :numerator
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :denominator
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :numerator
                                                     ]
                                                   )
                             ] .

:second-time  rdf:type            owl:NamedIndividual , :Singular_unit;
        rdfs:comment              "The second is a unit of time defined as the duration of 9 192 631 770 periods of the radiation corresponding to the transition between the two hyperfine levels of the ground state of the cesium 133 atom."@en;
        rdfs:label                "秒"@zh , "seconde"@nl , "second"@en;
        :definition               :duration_of_9_192_631_770_periods_of_the_radiation_corresponding_to_the_transition_between_the_two_hyperfine_levels_of_the_ground_state_of_the_cesium_133_atom;
        :dimension                :time-dimension;
        :longcomment              "The second is a unit of time defined as the duration of 9 192 631 770 periods of the radiation corresponding to the transition between the two hyperfine levels of the ground state of the cesium 133 atom. The second is a base unit in the International System of Units.";
        :symbol                   "s";
        :unofficial_abbreviation  "sec" .

:Metre_multiple_or_submultiple_per_second-time
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_division;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :Metre_multiple_or_submultiple;
                                                       owl:onProperty     :numerator
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :second-time;
                                                       owl:onProperty  :denominator
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :denominator
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :numerator
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :Metre_multiple_or_submultiple;
                                                       owl:onProperty     :numerator
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :second-time;
                                                       owl:onProperty  :denominator
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :denominator
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :numerator
                                                     ]
                                                   )
                             ] .

:Metre_multiple_or_submultiple_gram_multiple_or_submultiple
        rdf:type             owl:Class;
