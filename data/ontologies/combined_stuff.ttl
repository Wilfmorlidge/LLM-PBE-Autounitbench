                                                owl:oneOf  ( :abfarad :coulomb_per_volt :farad :statfarad )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Farad_multiple_or_submultiple
