        rdfs:comment      "The Grashof number is a dimensionless number that approximates the ratio of buoyancy to viscous force that acts on a fluid."@en;
        rdfs:label        "getal van Grashof"@nl , "Grashof number"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Grashof_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Grashof_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "Gr";
        :unit_of_measure  :one .

