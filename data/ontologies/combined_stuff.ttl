:Magnitude_at_minimum_brightness
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "The magnitude at minimum brightness of a variable star."@en;
        rdfs:label        "magnitude at minimum brightness"@en;
        rdfs:subClassOf   :Magnitude;
        :symbol           "m_min";
        :unit_of_measure  :magnitude , :one .

:B_magnitude_at_minimum_brightness
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "Johnson B magnitude at minimum brightness (i.e. for a variable star). The Johnson B band is a standard filter in the blue area. The central wavelength is 440nm and the bandwidth is 100nm.  The filter to be used is the Corning 5030 filter plus the Schott GG13 filter."@en;
        rdfs:label        "B magnitude at minimum brightness"@en;
        rdfs:subClassOf   :Magnitude_at_minimum_brightness , :B_magnitude;
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/Astrophysical_Techniques_chapter3>;
        :symbol           "B_min";
        :unit_of_measure  :magnitude , :one .

:Magnitude_at_maximum_brightness
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "The magnitude at maximum brightness of a variable star."@en;
        rdfs:label        "magnitude at maximum brightness"@en;
        rdfs:subClassOf   :Magnitude;
        :symbol           "m_max";
        :unit_of_measure  :magnitude , :one .

:B_magnitude_at_maximum_brightness
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "Johnson B magnitude at maximum brightness (i.e. for a variable star). The Johnson B band is a standard filter in the blue area. The central wavelength is 440nm and the bandwidth is 100nm.  The filter to be used is the Corning 5030 filter plus the Schott GG13 filter."@en;
        rdfs:label        "B magnitude at maximum brightness"@en;
        rdfs:subClassOf   :Magnitude_at_maximum_brightness , :B_magnitude;
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/Astrophysical_Techniques_chapter3>;
        :symbol           "B_max";
        :unit_of_measure  :magnitude , :one .

:Johnson_magnitude  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment     "A magnitude measured in one of Johnson's standard passbands (using a standard filter, i.e. U, B, or V)."@en;
        rdfs:label       "Johnson magnitude"@en;
        rdfs:subClassOf  :Magnitude;
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/Astrophysical_Techniques_chapter3>;
        :longcomment     "\n    \tFor accurate photometry the magnitude needs to be determined over well-defined spectral regions as the spectrum of to objects may be quite different. These magnitudes are measured using filters that allows only radiation within specific spectral regions (passbands) to pass through to the detector. These filters have accurately defined transmission curves characterised by a central wavelength and a bandwidth. \n    \tThe UBV system devised by Harold Johnson and William Morgan has been the most important general system until recently. The precise definition requires a reflecting telescope with aluminised mirrors fitted with an RCA 1P21 photomultiplier. The U region corresponds to a region in the violet and ultraviolet, the B region corresponds to typical photographic response and the V region to the visual response region (approximating the eye's response curve).\n    ".

:B_magnitude  rdf:type       owl:NamedIndividual , owl:Class;
        rdfs:comment         "Johnson B magnitude. The Johnson B band is a standard filter in the blue area. The central wavelength is 440nm and the bandwidth is 100nm.  The filter to be used is the Corning 5030 filter plus the Schott GG13 filter."@en;
        rdfs:label           "B magnitude"@en;
        rdfs:subClassOf      :Johnson_magnitude;
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/Astrophysical_Techniques_chapter3>;
        :alternative_symbol  "m_B";
        :symbol              "B";
        :unit_of_measure     :millimagnitude , :micromagnitude , :magnitude , :one .

:Azimuth  rdf:type           owl:NamedIndividual , owl:Class;
        rdfs:comment         "The angular distance measured clockwise along the horizon from a specified reference point (usually north) to the intersection with the great circle drawn from the zenith through a body on the celestial sphere."@en;
        rdfs:label           "azimuth"@en , "azimut"@nl;
        rdfs:subClassOf      :Plane_angle;
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/Glossary_Astronomical_Almanac>;
        :alternative_symbol  "Az";
        :symbol              "A";
        :unit_of_measure     :second-plane_angle , :minute-plane_angle , :degree .

