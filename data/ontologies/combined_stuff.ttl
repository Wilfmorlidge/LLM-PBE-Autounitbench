:pascal  rdf:type     owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The pascal is a unit of pressure and stress defined as newton divided by square metre = joule divided by cubic metre = kilogram divided by metre second squared."@en;
        rdfs:label    "pascal"@nl , "pascal"@en;
        :definition   :newton_per_square_metre;
        :dimension    :pressure-dimension;
        :longcomment  "The pascal is a unit of pressure and stress defined as newton divided by square metre = joule divided by cubic metre = kilogram divided by metre second squared. The pascal is a derived unit in the International System of Units.";
        :symbol       "Pa" .

:Pascal_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :pascal;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :pascal;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

