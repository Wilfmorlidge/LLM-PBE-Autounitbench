:ampere_per_square_metre
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:comment         "Ampere per square metre is a unit of current density defined as ampere divided by square metre."@en;
        rdfs:label           "ampère per vierkante meter"@nl , "ampere per square metre"@en;
        :alternative_symbol  "A·m-2" , "A m-2";
        :denominator         :square_metre;
        :dimension           :current_density-dimension;
        :longcomment         "Ampere per square metre is a unit of current density defined as ampere divided by square metre. Ampere per square metre is a derived unit in the International System of Units.";
        :numerator           :ampere;
        :symbol              "A/m2" .

