     <http://www.demcare.eu/ontologies/combined.owl#_305_285>
   )
  ] ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#Type> .

<http://www.demcare.eu/ontologies/combined.owl#DemographicCharacteristicsRecord>
  a owl:Class ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#gender> ;
    owl:allValuesFrom <http://www.demcare.eu/ontologies/combined.owl#GenderType>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#laterality> ;
