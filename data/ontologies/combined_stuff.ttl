:inductance_or_permeance-electromagnetic-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "inductance or permeance (electromagnetic) dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
