:steradian  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The steradian is a unit of solid angle defined as the solid angle subtended at the center of a sphere by a portion of the surface of the sphere that has an area equal to the square of the radius of the sphere."@en;
        rdfs:label    "球面度"@zh , "steradian"@en , "steradiaal"@nl;
        :definition   :square_metre_per_square_metre;
        :dimension    :dimension_one;
        :longcomment  "The steradian is a unit of solid angle defined as the solid angle subtended at the center of a sphere by a portion of the surface of the sphere that has an area equal to the square of the radius of the sphere. The steradian is a derived unit in the International System of Units.";
        :symbol       "sr" .

:second-plane_angle_squared
        rdf:type            owl:NamedIndividual , :Unit_exponentiation;
        rdfs:label          "second (plane angle) squared"@en;
        :alternative_label  "arcsecond squared"@en;
        :base               :second-plane_angle;
        :dimension          :dimension_one;
        :exponent           2;
        :symbol             "arcsec2" .

:degree_squared  rdf:type  owl:NamedIndividual , :Unit_exponentiation;
        rdfs:label  "degree squared"@en;
        :base       :degree;
        :dimension  :dimension_one;
        :exponent   2 .

:Steradian_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :steradian;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :steradian;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:Solid_angle_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Steradian_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :degree_squared :second-plane_angle_squared :square_metre_per_square_metre :steradian )
                                              ]
                                            )
                             ];
