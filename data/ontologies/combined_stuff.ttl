:Space_coordinates  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:label           "ruimtelijke coördinaten"@nl , "space coordinates"@en;
        rdfs:subClassOf      :Length;
        :alternative_symbol  "(r,θ,φ)" , "(x_1,x_2,x_3)";
        :symbol              "(x,y,z)";
        :unit_of_measure     :terametre , :picometre , :petametre , :nanometre , :millimetre , :micrometre , :megametre , :kilometre , :hectometre , :gigametre , :femtometre , :exametre , :decimetre , :decametre , :centimetre , :attometre , :yard-international , :rod-US , :parsec , :nautical_mile-international , :mile-statute , :mile-US_survey , :mil-length , :micron , :metre , :megaparsec , :light_year , :inch-international , :furlong-international , :foot-international , :foot-US_survey , :fermi , :fathom-US_survey , :chain , :astronomical_unit , :cicero , :pica-ATA , :pica-Postscript , :pica-TeX , :point-ATA , :point-Didot , :point-Postscript , :point-TeX , :angstrom .

:Space_coordinate  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:label           "ruimtelijke coördinaat"@nl , "space coordinate"@en;
        rdfs:subClassOf      :Length;
        :alternative_symbol  "r" , "y" , "z" , "θ" , "φ";
        :symbol              "x";
        :unit_of_measure     :terametre , :picometre , :petametre , :nanometre , :millimetre , :micrometre , :megametre , :kilometre , :hectometre , :gigametre , :femtometre , :exametre , :decimetre , :decametre , :centimetre , :attometre , :yard-international , :rod-US , :parsec , :nautical_mile-international , :mile-statute , :mile-US_survey , :mil-length , :micron , :metre , :megaparsec , :light_year , :inch-international , :furlong-international , :foot-international , :foot-US_survey , :fermi , :fathom-US_survey , :chain , :astronomical_unit , :angstrom , :point-TeX , :point-Postscript , :cicero , :pica-ATA , :pica-Postscript , :pica-TeX , :point-ATA , :point-Didot .

