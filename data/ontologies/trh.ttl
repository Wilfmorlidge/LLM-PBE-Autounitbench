                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty TrhOnt:hasPatient ;
                                                                                    owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                         owl:unionOf ( TrhOnt:Relative
                                                                                                                       <http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#Self.>
