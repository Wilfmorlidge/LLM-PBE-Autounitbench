###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#CA1.4
TrhOnt:CA1.4 rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( TrhOnt:Answer
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty KiReSOntFM:hasVASvalue ;
                                                          owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                               owl:onDatatype xsd:double ;
                                                                               owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:double
                                                                                                      ]
                                                                                                      [ xsd:maxInclusive "10.0"^^xsd:double
                                                                                                      ]
                                                                                                    )
                                                                             ]
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:subClassOf TrhOnt:Answer ;
             rdfs:comment "How much pain does the patient report on the Visual Analogue Scale (VAS)?" ;
             rdfs:label "CA1.4"@en .


