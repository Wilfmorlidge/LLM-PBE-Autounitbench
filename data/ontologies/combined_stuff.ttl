        :numerator           :microgram;
        :symbol              "μg/cm3" .

:kilogram_per_cubic_metre
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:comment         "Kilogram per cubic metre is a unit of density defined as kilogram divided by cubic metre."@en;
