            rdfs:subClassOf fma:fma5898 ;

            fma:FMAID "7490" ;
            fma:definition "Anatomical junction which consists of parts of two or more adjacent bones or cartilages which are interconnected by organs and/or organ parts that consist of various types of connective tissue. Together with other joints and bones, a joint constitutes the skeletal system. Examples: pubic symphysis, knee joint, temporomandibular joint." ;
            fma:non-English_equivalent "Jointure" ,
