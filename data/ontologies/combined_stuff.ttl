:       rdf:type         owl:NamedIndividual , owl:Ontology;
        rdfs:comment     "The Ontology of units of Measure and related concepts (OM) models concepts and relations important to scientific research. It has a strong focus on units and quantities, measurements, and dimensions."@en;
        rdfs:label       "Ontology of units of Measure (OM)"@en;
        <http://purl.org/dc/elements/1.1/creator>
                "Hajo Rijgersberg, Mark van Assem, Don Willems, Xin-Ying Ren, Mari Wigham, Jeen Broekstra, Jan Top"@en;
        <http://purl.org/dc/elements/1.1/date>
                "2018/06/04";
        <http://purl.org/dc/elements/1.1/identifier>
                "http://www.wurvoc.org/vocabularies/om-1.8/";
        <http://purl.org/dc/terms/license>
                <https://creativecommons.org/licenses/by/4.0/>;
        owl:versionInfo  "1.8.9"@en;
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.openisbn.com/isbn/9789462280618/>;
        <http://www.wurvoc.org/vocabularies/WV/illustration>
                "http://www.wurvoc.org/images/vocabularies/om-illustration.jpg";
        <http://www.wurvoc.org/vocabularies/WV/logo>
                "http://www.wurvoc.org/images/vocabularies/om-logo.jpg" .
