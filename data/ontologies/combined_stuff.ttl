        rdf:type             owl:NamedIndividual , owl:Class;
        rdfs:label           "first Righi-Leduc coefficient"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_symbol  "S_RL";
        :symbol              "A_RL" .

:First_Ettinghausen-Nernst_coefficient
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "first Ettinghausen-Nernst coefficient"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "A_N" .

:First_Cowling_number_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :one )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :one )
                             ] .

:First_Cowling_number
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:label        "first Cowling number"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :First_Cowling_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :First_Cowling_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "Co_1";
        :unit_of_measure  :one .

:Firmness-penetrometer-method_2
        rdf:type            owl:NamedIndividual , owl:Class;
        rdfs:comment        "Stevigheid gemeten met penetrometer methode 2."@nl;
        rdfs:label          "stevigheid (penetrometer) (methode 2)"@nl , "firmness (penetrometer) (method 2)"@en;
        rdfs:subClassOf     :Quantity;
        :alternative_label  "firmness_pen_2"@en;
        :unit_of_measure    :kilogram_per_square_metre .

:Firmness-penetrometer-method_1
        rdf:type            owl:NamedIndividual , owl:Class;
        rdfs:comment        "Stevigheid gemeten met penetrometer methode 1."@nl;
        rdfs:label          "stevigheid (penetrometer) (methode 1)"@nl , "firmness (penetrometer) (method 1)"@en;
        rdfs:subClassOf     :Quantity;
        :alternative_label  "firmness_pen_1"@en;
        :unit_of_measure    :kilogram_per_square_metre .

:Fermi_energy  rdf:type      owl:Class , owl:NamedIndividual;
        rdfs:label           "Fermi energy"@en , "Fermi-energy"@nl;
        rdfs:subClassOf      :Energy;
        :alternative_symbol  "ε_F";
        :symbol              "E_F";
        :unit_of_measure     :terajoule , :picojoule , :petajoule , :nanojoule , :millijoule , :microjoule , :megajoule , :megaerg , :kilojoule , :kilocalorie-mean , :hectojoule , :gigajoule , :femtojoule , :exajoule , :decijoule , :decajoule , :centijoule , :attojoule , :ton_of_TNT , :therm-US , :therm-EC , :terawatt_hour , :quad , :newton_metre , :millinewton_metre , :micronewton_metre , :megaelectronvolt , :kilowatt_hour , :kiloelectronvolt , :joule , :gigaelectronvolt , :foot_poundal , :erg , :calorie-thermochemical , :calorie-International_Table , :calorie-mean , :electronvolt , :British_thermal_unit-39_F , :British_thermal_unit-59_F , :British_thermal_unit-60_F , :British_thermal_unit-International_Table , :British_thermal_unit-mean , :British_thermal_unit-thermochemical , :calorie-15_C , :calorie-20_C .

:Fermi_angular_wave_vector
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "Fermi angular wave vector"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "k_F" .

:Fat_mass_fraction  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "The fraction of the mass of fat in a phenomenon"@en;
        rdfs:label        "fat mass fraction"@en;
        rdfs:subClassOf   :Mass_fraction;
        :unit_of_measure  :gram_per_gram , :percent , :one .

:degree_Fahrenheit  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The degree Fahrenheit is a unit of temperature defined as 5.555556e-1 kelvin."@en;
        rdfs:label    "graad Fahrenheit"@nl , "degree Fahrenheit"@en;
        :definition   :_5.555556e-1_kelvin;
        :dimension    :thermodynamic_temperature-dimension;
        :symbol       "°F" .

:Fahrenheit_temperature_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Temperature_unit;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( [ rdf:type   owl:Class;
                                                owl:oneOf  ( :degree_Fahrenheit )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( [ rdf:type   owl:Class;
                                                owl:oneOf  ( :degree_Fahrenheit )
                                              ]
                                            )
                             ] .

:Fahrenheit_temperature
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:label        "Fahrenheittemperatuur"@nl , "Fahrenheit temperature"@en;
        rdfs:subClassOf   :Temperature;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :Fahrenheit_scale;
                            owl:onProperty  :measurement_scale
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  [ rdf:type     owl:Class;
                                                                      owl:unionOf  ( :Fahrenheit_temperature_scale :Fahrenheit_temperature_unit )
                                                                    ];
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :Fahrenheit_scale;
                            owl:onProperty  :measurement_scale
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  [ rdf:type     owl:Class;
                                                                      owl:unionOf  ( :Fahrenheit_temperature_scale :Fahrenheit_temperature_unit )
                                                                    ];
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "T";
        :unit_of_measure  :degree_Fahrenheit .

:Fahrenheit_temperature_scale
        rdf:type         owl:Class;
        rdfs:subClassOf  :Measurement_scale .

:Fahrenheit_scale  rdf:type      owl:NamedIndividual , :Interval_scale , owl:Class;
        rdfs:label               "华氏温标"@zh , "Fahrenheitschaal"@nl , "Fahrenheit scale"@en;
        owl:equivalentClass      :Fahrenheit_temperature_scale;
        :definition_factor       "1.8"^^xsd:float;
        :definition_off-set      "-459.67"^^xsd:float;
        :definition_relative_to  :Kelvin_scale;
        :dimension               :thermodynamic_temperature-dimension;
        :unit_of_measure         :degree_Fahrenheit .

:Extinction_in_V  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label        "extinction in V"@en;
        rdfs:subClassOf   :Extinction_at_waveband;
        :symbol           "A_V";
        :unit_of_measure  :magnitude .

:Extinction_in_U  rdf:type  owl:NamedIndividual , owl:Class;
