                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Reynolds_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "Re";
        :unit_of_measure  :one .

:volt_per_watt  rdf:type     owl:NamedIndividual , :Unit_division;
        rdfs:comment         "Volt per watt is a unit of responsivity."@en;
        rdfs:label           "volt per watt"@nl , "volt per watt"@en;
        :alternative_symbol  "V·W-1" , "V W-1";
        :denominator         :watt;
        :longcomment         "Volt per watt is a unit of responsivity defined as volt divided by watt. Volt per watt is a derived unit in the International System of Units.";
        :numerator           :volt;
        :symbol              "V/W" .

:ampere_per_watt  rdf:type   owl:NamedIndividual , :Unit_division;
        rdfs:comment         "Ampere per watt is a unit of responsivity."@en;
