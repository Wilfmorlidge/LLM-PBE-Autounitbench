        :alternative_label  "International Table British thermal unit"@en;
        :definition         :_1.055056e3_joule;
        :dimension          :energy-dimension;
        :symbol             "Btu_IT" .

:British_thermal_unit-60_F
        rdf:type            owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The 60 °F British thermal unit is a unit of energy defined as 1.05468e3 joule."@en;
        rdfs:label          "英国热力单位（60°F）"@zh , "British thermal unit (60 °F)"@en;
        :LaTeX_command      "\\BritishTermalUnitSixtyF";
        :alternative_label  "60 °F British thermal unit"@en;
        :definition         :_1.05468e3_joule;
        :dimension          :energy-dimension;
        :symbol             "Btu" .

:British_thermal_unit-59_F
        rdf:type            owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The 59 °F British thermal unit is a unit of energy defined as 1.05480e3 joule."@en;
        rdfs:label          "英国热力单位（59°F）"@zh , "British thermal unit (59 °F)"@en;
        :LaTeX_command      "\\BritishTermalUnitFiftyNineF";
        :alternative_label  "59 °F British thermal unit"@en;
        :definition         :_1.05480e3_joule;
        :dimension          :energy-dimension;
        :symbol             "Btu" .

:British_thermal_unit-39_F
        rdf:type            owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The 39 °F British thermal unit is a unit of energy defined as 1.05967e3 joule."@en;
        rdfs:label          "英国热力单位（39°F）"@zh , "British thermal unit (39 °F)"@en;
        :LaTeX_command      "\\BritishTermalUnitThirtyNineF";
        :alternative_label  "39 °F British thermal unit"@en;
        :definition         :_1.05967e3_joule;
        :dimension          :energy-dimension;
        :symbol             "Btu" .

:Joule_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :joule;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :joule;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:Energy_of_particle  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:label        "energy of particle"@en;
        rdfs:subClassOf   :Energy;
        :symbol           "ε";
