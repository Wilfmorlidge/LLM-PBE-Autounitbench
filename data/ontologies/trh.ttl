###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#Condition
KiReSOntFM:Condition rdf:type owl:Class ;
                     rdfs:subClassOf KiReSOntFM:KiReSOntFMConcept ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty KiReSOntFM:hasPain ;
                                       owl:allValuesFrom KiReSOntFM:TrueOrFalse
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty KiReSOntFM:ROMAbdu ;
                                       owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                                           owl:onDatatype xsd:double ;
                                                           owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:double
                                                                                  ]
                                                                                )
                                                         ]
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty KiReSOntFM:ROMAddu ;
                                       owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                                           owl:onDatatype xsd:double ;
                                                           owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:double
                                                                                  ]
                                                                                )
                                                         ]
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty KiReSOntFM:ROMExt ;
                                       owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                                           owl:onDatatype xsd:double ;
                                                           owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:double
                                                                                  ]
                                                                                )
                                                         ]
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty KiReSOntFM:ROMExtRot ;
                                       owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                                           owl:onDatatype xsd:double ;
                                                           owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:double
                                                                                  ]
                                                                                )
                                                         ]
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty KiReSOntFM:ROMFlex ;
                                       owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                                           owl:onDatatype xsd:double ;
                                                           owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:double
                                                                                  ]
                                                                                )
                                                         ]
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty KiReSOntFM:ROMHorAbdu ;
                                       owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                                           owl:onDatatype xsd:double ;
                                                           owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:double
                                                                                  ]
                                                                                )
                                                         ]
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty KiReSOntFM:ROMHorAddu ;
                                       owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                                           owl:onDatatype xsd:double ;
                                                           owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:double
                                                                                  ]
                                                                                )
                                                         ]
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty KiReSOntFM:ROMIntRot ;
                                       owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                                           owl:onDatatype xsd:double ;
                                                           owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:double
                                                                                  ]
                                                                                )
                                                         ]
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty KiReSOntFM:hasVASvalue ;
                                       owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                                           owl:onDatatype xsd:double ;
                                                           owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:double
                                                                                  ]
                                                                                  [ xsd:maxInclusive "10.0"^^xsd:double
                                                                                  ]
                                                                                )
                                                         ]
                                     ] ;
                     rdfs:comment "Condition of a phase" ;
                     rdfs:label "Condition"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#Exercise
KiReSOntFM:Exercise rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty KiReSOntFM:hasMovement ;
                                          owl:someValuesFrom KiReSOntFM:Movement
                                        ] ;
                    rdfs:subClassOf KiReSOntFM:KiReSOntFMConcept ;
                    rdfs:comment "Physiotherapy exercise" ;
                    rdfs:label "Exercise"@en .


