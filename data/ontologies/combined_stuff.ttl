:delta_A450_per_second-time
        rdf:type      owl:NamedIndividual , :Unit_division;
        rdfs:label    "delta A450 per seconde"@nl , "delta A450 per second"@en;
        :denominator  :second-time;
        :dimension    :catalytic_activity-dimension;
        :numerator    :delta_A450 .

