    owl:onClass <http://www.demcare.eu/ontologies/combined.owl#PhysicalQuality>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#refersTo> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass <http://www.demcare.eu/ontologies/combined.owl#Entity>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#hasValue> ;
    owl:someValuesFrom rdfs:Literal
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#hasValue> ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
  ] .

