        :dimension          :electrical_conductance-dimension .

:siemens  rdf:type    owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The siemens is a unit of electrical conductance defined as 1 divided by ohm = ampere divided by volt = coulomb squared times second divided by kilogram times square metre = ampere squared times second to the power 3 divided by kilogram times square metre."@en;
        rdfs:label    "siemens"@nl , "siemens"@en;
        :definition   :ampere_per_volt;
        :dimension    :electrical_conductance-dimension;
        :longcomment  "The siemens is a unit of electrical conductance defined as 1 divided by ohm = ampere divided by volt = coulomb squared times second divided by kilogram times square metre = ampere squared times second to the power 3 divided by kilogram times square metre. The siemens is a derived unit in the International System of Units.";
        :symbol       "S" .

:mho    rdf:type        owl:NamedIndividual , :Singular_unit;
