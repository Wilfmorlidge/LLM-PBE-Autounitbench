                             ] .

:kilogram_per_second-time
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "kilogram per seconde"@nl , "kilogram per second"@en;
        :alternative_symbol  "kg·s-1" , "kg s-1";
        :denominator         :second-time;
        :dimension           :mass_flow-dimension;
        :numerator           :kilogram;
        :symbol              "kg/s" .

:mass_flow-dimension  rdf:type         owl:NamedIndividual , :Dimension;
        rdfs:label                     "mass flow dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  0;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    1;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    -1 .

:Mass_flow_unit  rdf:type    owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :kilogram_per_second-time )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :kilogram_per_second-time )
                             ] .

:Mass_flow  rdf:type      owl:NamedIndividual , owl:Class;
        rdfs:comment      "Mass flow is the movement of substances at equal rates or as a single body."@en;
        rdfs:label        "mass flow"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :mass_flow-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Mass_flow_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :mass_flow-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Mass_flow_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :unit_of_measure  :kilogram_per_second-time .

:Mass_excess  rdf:type   owl:NamedIndividual , owl:Class;
        rdfs:label       "mass excess"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "Δ" .

:Mass_attenuation_coefficient
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:comment     "The mass attenuation coefficient is a measure of how strongly a chemical species or substance absorbs or scatters light at a given wavelength per unit mass."@en;
        rdfs:label       "mass attenuation coefficient"@en;
        rdfs:subClassOf  :Quantity;
        :LaTeX_symbol    "\\mu_{m}";
        :symbol          "μ_m" .

:mass-dimension  rdf:type              owl:NamedIndividual , :Dimension;
        rdfs:label                     "massadimensie"@nl , "mass dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  0;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    1;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    0;
        :symbol                        "M" .

:Mass_unit  rdf:type         owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Gram_multiple_or_submultiple :Tonne_multiple_or_submultiple :Unified_atomic_mass_unit_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :International_Unit :carat-mass :grain :gram :hundredweight-British :hundredweight-US :milligram_RAE :ounce-apothecaries :ounce-avoirdupois :pennyweight-Troy :pound-apothecaries :pound-avoirdupois :slug :solar_mass :ton-long :ton-short :ton-short_assay :tonne :unified_atomic_mass_unit )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Gram_multiple_or_submultiple :Tonne_multiple_or_submultiple :Unified_atomic_mass_unit_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :International_Unit :carat-mass :grain :gram :hundredweight-British :hundredweight-US :milligram_RAE :ounce-apothecaries :ounce-avoirdupois :pennyweight-Troy :pound-apothecaries :pound-avoirdupois :slug :solar_mass :ton-long :ton-short :ton-short_assay :tonne :unified_atomic_mass_unit )
                                              ]
                                            )
                             ] .

:Manual_firmness  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment        "Firmness manueel: code 0 - 5."@nl;
        rdfs:label          "manuele stevigheid"@nl , "manual firmness"@en;
        rdfs:subClassOf     :Quantity;
        :alternative_label  "firmness_m"@en;
        :unit_of_measure    :_0-5 .

:millimagnitude  rdf:type  owl:NamedIndividual , :Unit_multiple_or_submultiple;
        rdfs:comment    "The millimagnitude is a unit of magnitude defined as 1.0e-3 magnitude."@en;
        rdfs:label      "millimagnitude"@nl , "millimagnitude"@en;
        :dimension      :dimension_one;
        :prefix         :milli;
        :singular_unit  :magnitude;
        :symbol         "mmag" .

:micromagnitude  rdf:type  owl:NamedIndividual , :Unit_multiple_or_submultiple;
        rdfs:comment    "The micromagnitude is a unit of magnitude defined as 1.0e-6 magnitude."@en;
        rdfs:label      "micromagnitude"@nl , "micromagnitude"@en;
        :dimension      :dimension_one;
        :prefix         :micro;
        :singular_unit  :magnitude;
        :symbol         "μmag" .

:magnitude  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "Eenheid waarmee de helderheid van sterren wordt aangegeven. Meestal wordt het symbool niet aangeduid ("@en;
        rdfs:label    "magnitude"@nl , "magnitude"@en;
        :definition   :one;
        :dimension    :dimension_one;
        :symbol       "mag" .

:Magnitude_unit  rdf:type    owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :magnitude :micromagnitude :millimagnitude :one )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :magnitude :micromagnitude :millimagnitude :one )
                             ] .

:Magnetomotive_force  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment     "Magnetomotive force at a point is the work that is required to bring unit positive pole from an infinite distance (zero potential) to the point."@en;
        rdfs:label       "magnetomotive force"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "F_m" .

:Magnetization  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "magnetization"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "M" .

:Magnetic_vector_potential
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "magnetic vector potential"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "A" .

:Magnetic_susceptibility
        rdf:type             owl:NamedIndividual , owl:Class;
        rdfs:comment         "Magnetic susceptibility is the degree of magnetization of a material in response to an applied magnetic field."@en;
        rdfs:label           "magnetic susceptibility"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_symbol  "χ_m";
        :symbol              "χ" .

:Magnetic_quantum_number
        rdf:type             owl:NamedIndividual , owl:Class;
        rdfs:label           "magnetic quantum number"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_symbol  "m_i";
        :symbol              "M" .

:Magnetic_pressure_ratio
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "magnetic pressure ratio"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "β" .

:Magnetic_pressure  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment     "Magnetic pressure is the energy density associated with a magnetic field."@en;
        rdfs:label       "magnetic pressure"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "p_m" .

:Magnetic_potential_difference
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "magnetic potential difference"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "U_m" .

:Magnetic_moment_of_a_particle
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "magnetic moment of a particle"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "μ" .

:Magnetic_moment  rdf:type  owl:Class;
        rdfs:comment     "Magnetic moment of a magnet is the torque experienced when it is at right angles to a uniform field of unit intensity."@en;
        rdfs:label       "magnetic moment"@en;
        rdfs:subClassOf  :Quantity .

:weber  rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The weber is a unit of magnetic flux defined as kilogram times square metre divided by second squared times ampere = volt times second = joule divided by ampere."@en;
        rdfs:label    "weber"@nl , "weber"@en;
        :definition   :volt_second-time;
        :dimension    :magnetic_flux-dimension;
        :longcomment  "The weber is a unit of magnetic flux defined as kilogram times square metre divided by second squared times ampere = volt times second = joule divided by ampere. The weber is a derived unit in the International System of Units.";
        :symbol       "Wb" .

:volt_second-time  rdf:type  owl:NamedIndividual , :Unit_multiplication;
        rdfs:label           "volt seconde"@nl , "volt second"@en;
        :alternative_symbol  "V·s";
        :dimension           :magnetic_flux-dimension;
        :symbol              "V s";
        :term_1              :volt;
        :term_2              :second-time .

:unit_pole  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The unit pole is a unit of magnetic flux defined as 1.256637e-7 weber."@en;
        rdfs:label    "unit pole"@en;
        :definition   :_1.256637e-7_weber;
        :dimension    :magnetic_flux-dimension .

:statweber  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The statweber is a unit of magnetic flux defined as 2.9979e2 weber."@en;
        rdfs:label    "statweber"@nl , "statweber"@en;
        :definition   :_2.9979e2_weber;
        :dimension    :magnetic_flux-dimension;
        :symbol       "statWb" .

:maxwell  rdf:type    owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The maxwell is a unit of magnetic flux defined as 1.0e-8 weber."@en;
        rdfs:label    "maxwell"@nl , "maxwell"@en;
        :definition   :_1.0e-8_weber;
        :dimension    :magnetic_flux-dimension;
        :symbol       "Mx" .

:Weber_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :weber;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :weber;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:weber_per_square_metre
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "weber per vierkante meter"@nl , "weber per square metre"@en;
        :alternative_symbol  "Wb·m-2" , "Wb m-2";
        :denominator         :square_metre;
        :dimension           :magnetic_flux_density-dimension;
        :numerator           :weber;
        :symbol              "Wb/m2" .

:tesla  rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The tesla is a unit of magnetic flux density defined as volt times second divided by square metre = newton divided by ampere times metre = weber divided by square metre = kilogram divided by coulomb times second = kilogram divided by ampere times second squared."@en;
        rdfs:label    "tesla"@nl , "tesla"@en;
        :definition   :weber_per_square_metre;
        :dimension    :magnetic_flux_density-dimension;
        :longcomment  "The tesla is a unit of magnetic flux density defined as volt times second divided by square metre = newton divided by ampere times metre = weber divided by square metre = kilogram divided by coulomb times second = kilogram divided by ampere times second squared. The tesla is a derived unit in the International System of Units.";
        :symbol       "T" .

:stattesla  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The stattesla is a unit of magnetic flux density defined as 2.9979e6 tesla."@en;
        rdfs:label    "stattesla"@nl , "stattesla"@en;
        :definition   :_2.9979e6_tesla;
        :dimension    :magnetic_flux_density-dimension;
        :symbol       "statT" .

:milligauss  rdf:type   owl:NamedIndividual , :Unit_multiple_or_submultiple;
        rdfs:comment    "The milligauss is a unit of magnetic flux density defined as 1.0e-3 gauss."@en;
        rdfs:label      "milligauss"@nl , "milligauss"@en;
        :dimension      :magnetic_flux_density-dimension;
        :prefix         :milli;
        :singular_unit  :gauss;
        :symbol         "mG" .

:gauss  rdf:type             owl:NamedIndividual , :Singular_unit;
        rdfs:comment         "The gauss is a unit of magnetic flux density defined as 1.0e-4 tesla."@en;
        rdfs:label           "gauss"@nl , "gauss"@en;
        :alternative_label   "abtesla"@nl , "abtesla"@en;
        :alternative_symbol  "Gs";
        :definition          :_1.0e-4_tesla;
        :dimension           :magnetic_flux_density-dimension;
        :symbol              "G" .

:gamma  rdf:type        owl:NamedIndividual , :Singular_unit;
        rdfs:comment    "The gamma is a unit of magnetic flux density defined as 1.0e-9 tesla."@en;
        rdfs:label      "gamma"@nl , "gamma"@en;
        :LaTeX_command  "\\gammaUnit";
        :definition     :_1.0e-9_tesla;
        :dimension      :magnetic_flux_density-dimension;
        :symbol         "γ" .

:Tesla_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :tesla;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :tesla;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:magnetic_flux_density-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "magnetic flux density dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                -1;
        :SI_length_dimension_exponent  0;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    1;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    -2 .

:Magnetic_flux_density_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Tesla_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :gamma :gauss :milligauss :stattesla :tesla :weber_per_square_metre )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Tesla_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :gamma :gauss :milligauss :stattesla :tesla :weber_per_square_metre )
                                              ]
                                            )
                             ] .

:Magnetic_flux_density
        rdf:type            owl:Class , owl:NamedIndividual;
        rdfs:label          "magnetic flux density"@en;
        rdfs:subClassOf     :Quantity;
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :magnetic_flux_density-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Magnetic_flux_density_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :magnetic_flux_density-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Magnetic_flux_density_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        :alternative_label  "magnetic field"@en , "magnetic induction"@en;
        :symbol             "B";
        :unit_of_measure    :teratesla , :picotesla , :petatesla , :nanotesla , :millitesla , :microtesla , :megatesla , :kilotesla , :hectotesla , :gigatesla , :femtotesla , :exatesla , :gamma , :gauss , :milligauss , :stattesla , :tesla , :weber_per_square_metre , :attotesla , :centitesla , :decatesla , :decitesla .

:magnetic_flux-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "magnetic flux dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                -1;
        :SI_length_dimension_exponent  2;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    1;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    -2 .

:Magnetic_flux_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Weber_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :maxwell :statweber :unit_pole :volt_second-time :weber )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Weber_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :maxwell :statweber :unit_pole :volt_second-time :weber )
                                              ]
                                            )
                             ] .

:Magnetic_flux  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:comment      "Magnetic flux through any area perpendicular to a magnetic field is the product of the area by the field strength."@en;
        rdfs:label        "magnetic flux"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :magnetic_flux-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Magnetic_flux_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :magnetic_flux-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Magnetic_flux_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "Φ";
        :unit_of_measure  :teraweber , :picoweber , :petaweber , :nanoweber , :milliweber , :microweber , :megaweber , :kiloweber , :hectoweber , :gigaweber , :maxwell , :statweber , :unit_pole , :volt_second-time , :weber , :attoweber , :centiweber , :decaweber , :deciweber , :exaweber , :femtoweber .

:oersted  rdf:type    owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The oersted is a unit of magnetic field defined as 7.957747e1 ampere per metre."@en;
        rdfs:label    "oersted"@en;
        :definition   :_7.957747e1_ampere_per_metre;
        :dimension    :magnetic_field_strength-dimension;
        :symbol       "Oe" .

:ampere_per_metre  rdf:type  owl:NamedIndividual , :Unit_division;
        rdfs:comment         "Ampere per metre is a unit of magnetic field defined as ampere divided by metre."@en;
        rdfs:label           "ampère per meter"@nl , "ampere per metre"@en;
        :alternative_symbol  "A·m-1" , "A m-1";
        :denominator         :metre;
        :dimension           :magnetic_field_strength-dimension;
        :longcomment         "Ampere per metre is a unit of magnetic field defined as ampere divided by metre. Ampere per metre is a derived unit in the International System of Units.";
        :numerator           :ampere;
        :symbol              "A/m" .

:magnetic_field_strength-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "magnetic field strength dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                1;
        :SI_length_dimension_exponent  -1;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    0 .

:Magnetic_field_strength_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :ampere_per_metre :oersted )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :ampere_per_metre :oersted )
                             ] .

:Magnetic_field_strength
        rdf:type            owl:NamedIndividual , owl:Class;
        rdfs:label          "magnetic field strength"@en;
        rdfs:subClassOf     :Quantity;
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :magnetic_field_strength-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Magnetic_field_strength_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :magnetic_field_strength-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Magnetic_field_strength_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        :alternative_label  "magnetizing field"@en , "magnetic field intensity"@en;
        :symbol             "H";
        :unit_of_measure    :oersted , :ampere_per_metre .

:Magnetic_dipole_moment
        rdf:type             owl:NamedIndividual , owl:Class;
        rdfs:comment         "Magnetic dipole moment is a measure of the strength of a system's net magnetic source."@en;
        rdfs:label           "magnetic dipole moment"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_symbol  "μ";
        :symbol              "m" .

:Magnetic_diffusivity
        rdf:type             owl:NamedIndividual , owl:Class;
        rdfs:label           "magnetic diffusivity"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_symbol  "η_m";
        :symbol              "ν_m" .

:Magnetic_Reynolds_number_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :one )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :one )
                             ] .

:Magnetic_Reynolds_number
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:label        "magnetisch getal van Reynolds"@nl , "magnetic Reynolds number"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Magnetic_Reynolds_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Magnetic_Reynolds_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "Rm";
        :unit_of_measure  :one .

:Madelung_constant  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment     "The Madelung constant expresses the energy of a single ion in a crystal."@en;
        rdfs:label       "Madelung constant"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "α" .

:Macroscopic_cross_section
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "macroscopic cross section"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "Σ" .

:Mach_number_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :one )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :one )
                             ] .

:Mach_number  rdf:type    owl:NamedIndividual , owl:Class;
        rdfs:comment      "The Mach number is the speed of an object that moves through air, or any fluid substance, divided by the speed of sound as it is in that substance."@en;
        rdfs:label        "Machgetal"@nl , "Mach number"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Mach_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Mach_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "Ma";
        :unit_of_measure  :one .

:luminous_intensity-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "luminous intensity dimension"@en , "lichtsterktedimensie"@nl;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  0;
        :SI_luminous_intensity_dimension_exponent
                1;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    0;
        :symbol                        "J" .

:Luminous_intensity_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Candela_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :candela )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Candela_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :candela )
                                              ]
                                            )
                             ] .

:Luminous_intensity  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:comment         "Luminous intensity is the wavelength-weighted power emitted by a light source in a particular direction per unit solid angle. It is a base quantity in the International System of Units. Luminous intensity is luminous flux divided by solid angle."@en;
        rdfs:label           "lichtsterkte"@nl , "luminous intensity"@en;
        rdfs:subClassOf      :Quantity;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :luminous_intensity-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Luminous_intensity_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :luminous_intensity-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Luminous_intensity_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        :alternative_symbol  "I_v";
        :symbol              "I";
        :unit_of_measure     :teracandela , :picocandela , :petacandela , :nanocandela , :millicandela , :microcandela , :megacandela , :kilocandela , :candela , :attocandela , :centicandela , :decacandela , :decicandela , :exacandela , :femtocandela , :gigacandela , :hectocandela .

:candela_steradian  rdf:type  owl:NamedIndividual , :Unit_multiplication;
        rdfs:label           "candela steradian"@en , "candela steradiaal"@nl;
        :alternative_symbol  "cd·sr";
        :dimension           :luminous_flux-dimension;
        :symbol              "cd sr";
        :term_1              :candela;
        :term_2              :steradian .

:luminous_flux-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "luminous flux dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  0;
        :SI_luminous_intensity_dimension_exponent
                1;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    0 .

:Luminous_flux_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Lumen_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :candela_steradian :lumen )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Lumen_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :candela_steradian :lumen )
                                              ]
                                            )
                             ] .

:Luminous_flux  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:comment      "Luminous flux is the total visible energy emitted by a source per unit time."@en;
        rdfs:label        "luminous flux"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :luminous_flux-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Luminous_flux_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :luminous_flux-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Luminous_flux_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "F";
        :unit_of_measure  :teralumen , :picolumen , :petalumen , :nanolumen , :millilumen , :microlumen , :megalumen , :lumen , :candela_steradian , :attolumen , :centilumen , :decalumen , :decilumen , :exalumen , :femtolumen , :gigalumen , :hectolumen , :kilolumen .

:Luminous_exitance  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label           "luminous exitance"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_symbol  "M_v";
        :symbol              "M" .

:Luminous_efficiency  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "luminous efficiency"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "V" .

:Luminous_efficacy  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "luminous efficacy"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "K" .

:Luminosity_function  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "The number of stars of absolute magnitudes between Mv and Mv+ΔMv per cubic parsec."@en;
        rdfs:label        "luminosity function"@en;
        rdfs:subClassOf   :Number_density;
        :unit_of_measure  :reciprocal_cubic_parsec .

:stilb  rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The stilb is a unit of luminance defined as 1.0e4 candela per square metre."@en;
        rdfs:label    "stilb"@nl , "stilb"@en;
        :definition   :_1.0e4_candela_per_square_metre;
        :dimension    :luminance-dimension;
        :symbol       "sb" .

:lambert  rdf:type    owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The lambert is a unit of luminance defined as 3.183099e3 candela per square metre."@en;
        rdfs:label    "lambert"@nl , "lambert"@en;
        :definition   :_3.183099e3_candela_per_square_metre;
        :dimension    :luminance-dimension .

:footlambert  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The footlambert is a unit of luminance defined as 3.426259 candela per square metre."@en;
        rdfs:label    "footlambert"@en;
        :definition   :_3.426259_candela_per_square_metre;
        :dimension    :luminance-dimension .

:candela_per_square_metre
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:comment         "Candela per square metre is a unit of luminance defined as candela divided by square metre."@en;
        rdfs:label           "candela per vierkante meter"@nl , "candela per square metre"@en;
        :alternative_symbol  "cd·m-1" , "cd m-1";
        :denominator         :square_metre;
        :dimension           :luminance-dimension;
        :longcomment         "Candela per square metre is a unit of luminance defined as candela divided by square metre. Candela per square metre is a derived unit in the Internationa; System of Units.";
        :numerator           :candela;
        :symbol              "cd/m" .

:candela_per_square_centimetre
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "candela per vierkante centimeter"@nl , "candela per square centimetre"@en;
        :alternative_symbol  "cd·cm-1" , "cd cm-1";
        :denominator         :square_centimetre;
        :dimension           :luminance-dimension;
        :numerator           :candela;
        :symbol              "cd/cm" .

:luminance-dimension  rdf:type         owl:NamedIndividual , :Dimension;
        rdfs:label                     "luminance dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  -2;
        :SI_luminous_intensity_dimension_exponent
                1;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    0 .

:Luminance_unit  rdf:type    owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :candela_per_square_centimetre :candela_per_square_metre :footlambert :lambert :stilb )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :candela_per_square_centimetre :candela_per_square_metre :footlambert :lambert :stilb )
                             ] .

:Luminance  rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:comment         "Luminous flux is the total visible energy emitted by a source per unit time."@en;
        rdfs:label           "luminance"@en;
        rdfs:subClassOf      :Quantity;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :luminance-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Luminance_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :luminance-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Luminance_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        :alternative_symbol  "L_v";
        :symbol              "L";
        :unit_of_measure     :stilb , :lambert , :footlambert , :candela_per_square_metre , :candela_per_square_centimetre .

:lumen  rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The lumen is a unit of luminous flux defined as candela times steradian = lux times square metre."@en;
        rdfs:label    "lumen"@nl , "lumen"@en;
        :definition   :candela_steradian;
        :dimension    :luminous_flux-dimension;
        :longcomment  "The lumen is a unit of luminous flux defined as candela times steradian = lux times square metre. The lumen is a derived unit in the International System of Units.";
        :symbol       "lm" .

:Lumen_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :lumen;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :lumen;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:Loudness_level  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "loudness level"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "L_N" .

