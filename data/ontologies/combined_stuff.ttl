:Molair_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :molair;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :molair;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:amount_of_substance_concentration-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "amount of substance concentration dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                1;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  -3;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    0 .

:Amount_of_substance_concentration_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Molair_multiple_or_submultiple :Mole_multiple_or_submultiple_per_litre :Mole_multiple_or_submultiple_per_litre_multiple_or_submultiple :Mole_per_litre_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :molair :mole_per_cubic_metre :mole_per_litre )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Molair_multiple_or_submultiple :Mole_multiple_or_submultiple_per_litre :Mole_multiple_or_submultiple_per_litre_multiple_or_submultiple :Mole_per_litre_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :molair :mole_per_cubic_metre :mole_per_litre )
                                              ]
                                            )
                             ] .

:Amount_of_substance_concentration
        rdf:type            owl:Class , owl:NamedIndividual;
        rdfs:label          "amount of substance concentration"@en;
        rdfs:subClassOf     :Quantity;
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :amount_of_substance_concentration-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Amount_of_substance_concentration_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :amount_of_substance_concentration-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Amount_of_substance_concentration_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        :alternative_label  "molaire concentratie"@nl , "molar concentration"@en;
        :symbol             "C";
        :unit_of_measure    :zeptomolair , :yoctomolair , :teramole_per_litre , :picomole_per_litre , :picomolair , :petamole_per_litre , :nanomole_per_litre , :nanomolair , :mole_per_teralitre , :mole_per_picolitre , :mole_per_petalitre , :mole_per_nanolitre , :mole_per_millilitre , :mole_per_microlitre , :mole_per_megalitre , :mole_per_kilolitre , :mole_per_hectolitre , :mole_per_gigalitre , :mole_per_femtolitre , :mole_per_exalitre , :mole_per_decilitre , :mole_per_decalitre , :mole_per_centilitre , :mole_per_attolitre , :millimole_per_litre , :millimolair , :micromole_per_litre , :micromolair , :megamole_per_litre , :megamolair , :kilomole_per_litre , :hectomole_per_litre , :gigamole_per_litre , :femtomole_per_litre , :molair , :mole_per_cubic_metre , :mole_per_litre , :attomolair , :attomole_per_litre , :centimole_per_litre , :decamole_per_litre , :decimole_per_litre , :examole_per_litre , :femtomolair .

:amount_of_substance-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "stofhoeveelheiddimensie"@nl , "amount of substance dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                1;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  0;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    0;
        :symbol                        "N" .

:Amount_of_substance_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Mole_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :mole )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Mole_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :mole )
                                              ]
                                            )
                             ] .

:Amount_of_substance  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:comment      "Amount of substance is the number of elementary entities such as atoms, molecules, electrons, particles, etc. present in a phenomenon. It is a base quantity in the International System of Units."@en;
        rdfs:label        "amount of substance"@en , "stofhoeveelheid"@nl;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :amount_of_substance-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Amount_of_substance_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :amount_of_substance-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Amount_of_substance_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "n";
        :unit_of_measure  :teramole , :picomole , :petamole , :nanomole , :millimole , :micromole , :megamole , :mole , :attomole , :centimole , :decamole , :decimole , :examole , :femtomole , :gigamole , :hectomole , :kilomole .

:Currency  rdf:type          owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :Australian_dollar :Brazilian_real :Canadian_dollar :Chinese_yuan :Hong_Kong_dollar :Indian_rupee :Japanese_yen :Mexican_peso :New_Zealand_dollar :Norwegian_krone :Russian_ruble :Singapore_dollar :South_African_rand :South_Korean_won :Swedish_krona :Swiss_franc :Turkish_lira :United_States_dollar :euro :megaeuro :pound_sterling )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :Australian_dollar :Brazilian_real :Canadian_dollar :Chinese_yuan :Hong_Kong_dollar :Indian_rupee :Japanese_yen :Mexican_peso :New_Zealand_dollar :Norwegian_krone :Russian_ruble :Singapore_dollar :South_African_rand :South_Korean_won :Swedish_krona :Swiss_franc :Turkish_lira :United_States_dollar :euro :megaeuro :pound_sterling )
                             ] .

:Amount_of_money  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:label        "amount of money"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Currency;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Currency;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :unit_of_measure  :pound_sterling , :megaeuro , :euro , :United_States_dollar , :Turkish_lira , :Swiss_franc , :Swedish_krona , :South_Korean_won , :Australian_dollar , :Brazilian_real , :Canadian_dollar , :Chinese_yuan , :Hong_Kong_dollar , :Indian_rupee , :Japanese_yen , :Mexican_peso , :New_Zealand_dollar , :Norwegian_krone , :Russian_ruble , :Singapore_dollar , :South_African_rand .

:Ambipolar_diffusion_coefficient
        rdf:type             owl:NamedIndividual , owl:Class;
        rdfs:label           "ambipolar diffusion coefficient"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_label   "ambipolar ion-electron diffusion coefficient"@en;
        :alternative_symbol  "D_amb";
        :symbol              "D_a" .

:Dose_equivalent  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:comment      "Dose equivalent is a measure of the radiation dose to tissue where an attempt has been made to allow for the different relative biological effects of different types of ionizing radiation."@en;
        rdfs:label        "dose equivalent"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :specific_energy_or_absorbed_dose_or_dose_equivalent-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Dose_equivalent_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :specific_energy_or_absorbed_dose_or_dose_equivalent-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Dose_equivalent_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :unit_of_measure  :terasievert , :picosievert , :petasievert , :nanosievert , :millisievert , :microsievert , :rem , :sievert , :attosievert , :centisievert , :decasievert , :decisievert , :exasievert , :femtosievert , :gigasievert , :hectosievert , :kilosievert , :megasievert .

:Ambient_dose_equivalent
        rdf:type          owl:Class , owl:NamedIndividual;
        rdfs:label        "ambient dose equivalent"@en;
        rdfs:subClassOf   :Dose_equivalent;
        :unit_of_measure  :terasievert , :picosievert , :petasievert , :nanosievert , :millisievert , :rem , :sievert , :attosievert , :centisievert , :decasievert , :decisievert , :exasievert , :femtosievert , :gigasievert , :hectosievert , :kilosievert , :megasievert , :microsievert .

:Plane_angle  rdf:type       owl:Class , owl:NamedIndividual;
        rdfs:comment         "Plane angle is the ratio between an arc and its radius."@en;
        rdfs:label           "hoek"@nl , "plane angle"@en;
        rdfs:subClassOf      :Quantity;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :dimension_one;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Plane_angle_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :dimension_one;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Plane_angle_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        :alternative_label   "angle"@en;
        :alternative_symbol  "γ" , "β" , "θ" , "φ";
        :symbol              "α";
        :unit_of_measure     :picoradian , :nanoradian , :milliradian , :microradian , :femtoradian , :deciradian , :centiradian , :attoradian , :second-plane_angle , :revolution , :radian , :minute-plane_angle , :millisecond-plane_angle , :degree , :gon , :metre_per_metre , :microsecond-plane_angle , :mil-plane_angle .

:Altitude  rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment         "The angular distance of a celestial body above or below the horizon, measured along the great circle passing through the body and the zenith."@en;
        rdfs:label           "altitude"@en;
        rdfs:subClassOf      :Plane_angle;
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/Glossary_Astronomical_Almanac>;
        :alternative_label   "elevation"@en;
        :alternative_symbol  "Alt";
        :symbol              "h";
        :unit_of_measure     :second-plane_angle , :minute-plane_angle , :degree .

:Alfven_speed  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "Alfvén speed"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "v_A" .

:one    rdf:type            owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "Unit one is a unit of dimension one."@en;
        rdfs:label          "one"@en;
        :alternative_label  "unit one"@en;
        :dimension          :dimension_one;
        :symbol             "1" .

:dimension_one  rdf:type               owl:NamedIndividual , :Dimension;
        rdfs:label                     "dimension_one"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  0;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    0;
        :symbol                        "1" .

:Alfven_number_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :one )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :one )
                             ] .

:Alfven_number  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label        "Alfvén number"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Alfven_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Alfven_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "Al";
        :unit_of_measure  :one .

:Quantity_of_dimension_one
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:label        "quantity of dimension one"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Quantity_of_dimension_one_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Quantity_of_dimension_one_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :unit_of_measure  :percent , :parts_per_million , :one .

:Albedo  rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:comment      "Ratio between radiation falling onto an object and the radiation reflected or scattered back. Or the ratio between the illumination and observed brightness."@en;
        rdfs:label        "albedo"@nl , "albedo"@en;
        rdfs:subClassOf   :Quantity_of_dimension_one;
        :symbol           "α";
        :unit_of_measure  :one .

:Affinity  rdf:type      owl:NamedIndividual , owl:Class;
        rdfs:label       "affinity"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "A" .

:Admittance  rdf:type    owl:NamedIndividual , owl:Class;
        rdfs:comment     "Admittance is a measure of how easily a circuit or device will allow a current to flow. It is electric current divided by electric potential."@en;
        rdfs:label       "admittance"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "Y" .

:reciprocal_second-time
        rdf:type    owl:NamedIndividual , :Unit_exponentiation;
        rdfs:label  "reciprocal second"@en , "omgekeerde seconde"@nl;
        :base       :second-time;
        :dimension  :frequency-dimension;
        :exponent   -1;
        :symbol     "s-1" .

:curie  rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The curie is a unit of activity defined as 3.7e10 becquerel."@en;
        rdfs:label    "curie"@nl , "curie"@en;
        :definition   :_3.7e10_becquerel;
        :dimension    :frequency-dimension;
        :symbol       "Ci" .

:becquerel  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The becquerel is a unit of activity defined as the activity of a quantity of radioactive material in which one nucleus decays per second. Algebraically it is defined as 1 divided by second."@en;
        rdfs:label    "becquerel"@nl , "becquerel"@en;
        :definition   :reciprocal_second-time;
        :dimension    :frequency-dimension;
        :longcomment  "The becquerel is a unit of activity defined as the activity of a quantity of radioactive material in which one nucleus decays per second. Algebraically it is defined as 1 divided by second. The becquerel is a derived unit in the International System of Units.";
        :symbol       "Bq" .

:Becquerel_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :becquerel;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :becquerel;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:frequency-dimension  rdf:type         owl:NamedIndividual , :Dimension;
        rdfs:label                     "frequency dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  0;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    -1 .

:Activity_unit  rdf:type     owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Becquerel_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :becquerel :curie :reciprocal_second-time )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Becquerel_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :becquerel :curie :reciprocal_second-time )
                                              ]
                                            )
                             ] .

:Activity  rdf:type         owl:Class , owl:NamedIndividual;
        rdfs:comment        "Activity is the decay rate of a radioactive substance. It is a derived quantity in the International System of Units. Activity is 1 divided by time."@en;
        rdfs:label          "activiteit"@nl , "activity"@en;
        rdfs:subClassOf     :Quantity;
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :frequency-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Activity_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :frequency-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
