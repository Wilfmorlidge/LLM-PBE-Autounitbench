        :symbol              "Wb/A" .

:stathenry  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The stathenry is a unit of inductance defined as 8.987552e11 henry."@en;
        rdfs:label    "stathenry"@nl , "stathenry"@en;
        :definition   :_8.987552e11_henry;
        :dimension    :inductance_or_permeance-electromagnetic-dimension;
        :symbol       "statH" .

:abhenry  rdf:type    owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The abhenry is a unit of inductance defined as 1.0e-9 henry."@en;
        rdfs:label    "abhenry"@nl , "abhenry"@en;
        :definition   :_1.0e-9_henry;
        :dimension    :inductance_or_permeance-electromagnetic-dimension;
