                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :British_thermal_unit-39_F :British_thermal_unit-59_F :British_thermal_unit-60_F :British_thermal_unit-International_Table :British_thermal_unit-mean :British_thermal_unit-thermochemical :calorie-15_C :calorie-20_C :calorie-International_Table :calorie-mean :calorie-thermochemical :electronvolt :erg :foot_poundal :gigaelectronvolt :joule :kiloelectronvolt :kilowatt_hour :megaelectronvolt :micronewton_metre :millinewton_metre :newton_metre :quad :terawatt_hour :therm-EC :therm-US :ton_of_TNT )
