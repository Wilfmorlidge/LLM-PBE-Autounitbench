        :dimension    :force-dimension;
        :symbol       "lbf" .

:newton  rdf:type     owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The newton is a unit of force defined as kilogram timesmetre divided by second squared."@en;
        rdfs:label    "牛顿"@zh , "newton"@nl , "newton"@en;
        :definition   :metre_kilogram_per_second-time_squared;
        :dimension    :force-dimension;
        :longcomment  "The newton is a unit of force defined as kilogram times metre divided by second squared. The newton is a derived unit in the International System of Units.";
        :symbol       "N" .

:metre_kilogram_per_second-time_squared
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "metre kilogram per second squared"@en , "meter kilogram per seconde kwadraat"@nl;
        :alternative_symbol  "m·kg·s-2" , "m·kg/s2" , "m kg s-2";
        :denominator         :second-time_squared;
        :dimension           :force-dimension;
        :numerator           :metre_kilogram;
        :symbol              "m kg/s2" .

:kip    rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The kip is a unit of force defined as 4.448222e3 newton."@en;
        rdfs:label    "kip"@nl , "kip"@en;
        :definition   :_4.448222e3_newton;
        :dimension    :force-dimension .

:dyne   rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The dyne is a unit of force defined as 1.0e-5 newton."@en;
        rdfs:label    "达因"@zh , "dyne"@nl , "dyne"@en;
        :definition   :_1.0e-5_newton;
        :dimension    :force-dimension;
        :symbol       "dyn" .

:Newton_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :newton;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :newton;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:force-dimension  rdf:type             owl:NamedIndividual , :Dimension;
        rdfs:label                     "krachtdimensie"@nl , "force dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  1;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    1;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    -2 .

:Force_unit  rdf:type        owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Newton_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :dyne :kip :metre_kilogram_per_second-time_squared :newton :pound-force :poundal :ton-force-short )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Newton_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :dyne :kip :metre_kilogram_per_second-time_squared :newton :pound-force :poundal :ton-force-short )
                                              ]
                                            )
                             ] .

:Force  rdf:type          owl:Class , owl:NamedIndividual;
        rdfs:comment      "Force is the extent to which an object with mass can be caused to accelerate. It is a derived quantity in the International System of Units. Force is mass times acceleration."@en;
        rdfs:label        "force"@en , "kracht"@nl , "力力"@zh;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :force-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Force_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :force-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Force_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "F";
        :unit_of_measure  :teranewton , :piconewton , :petanewton , :nanonewton , :millinewton , :micronewton , :meganewton , :kilonewton , :hectonewton , :giganewton , :femtonewton , :exanewton , :decinewton , :decanewton , :dyne , :kip , :metre_kilogram_per_second-time_squared , :newton , :pound-force , :poundal , :ton-force-short , :attonewton , :centinewton .

:Length_unit  rdf:type       owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Metre_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :angstrom :astronomical_unit :chain :cicero :fathom-US_survey :fermi :foot-US_survey :foot-international :furlong-international :gigaparsec :inch-international :kiloparsec :light_year :megaparsec :metre :micron :mil-length :mile-US_survey :mile-statute :nautical_mile-international :parsec :pica-ATA :pica-Postscript :pica-TeX :point-ATA :point-Didot :point-Postscript :point-TeX :rod-US :solar_radius :yard-international )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Metre_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :angstrom :astronomical_unit :chain :cicero :fathom-US_survey :fermi :foot-US_survey :foot-international :furlong-international :gigaparsec :inch-international :kiloparsec :light_year :megaparsec :metre :micron :mil-length :mile-US_survey :mile-statute :nautical_mile-international :parsec :pica-ATA :pica-Postscript :pica-TeX :point-ATA :point-Didot :point-Postscript :point-TeX :rod-US :solar_radius :yard-international )
                                              ]
                                            )
                             ] .

:point-TeX  rdf:type        owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The TeX point is a unit of length defined as 0.01383700013837000138370001383 inch."@en;
        rdfs:label          "point (TeX)"@en;
        :alternative_label  "TeX point"@en;
        :definition         :_0.013837000138370001383700013837_inch-international;
        :dimension          :length-dimension;
        :symbol             "pt" .

:point-Postscript  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The Postscript point is a unit of length defined as 0.013888888888888888888888888888889 inch."@en;
        rdfs:label          "point (Postscript)"@en;
        :alternative_label  "Postscript point"@en;
        :definition         :_0.013888888888888888888888888888889_inch-international;
        :dimension          :length-dimension;
        :symbol             "pt" .

:point-Didot  rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The Didot point is a unit of length defined as 0.3759e-3 metre."@en;
        rdfs:label          "point (Didot)"@en;
        :alternative_label  "Didot point"@en;
        :definition         :_0.3759e-3_metre;
        :dimension          :length-dimension;
        :symbol             "pt" .

:point-ATA  rdf:type        owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The ATA point is a unit of length defined as 0.3514598e-3 metre."@en;
        rdfs:label          "point (ATA)"@en;
        :alternative_label  "ATA point"@en;
        :definition         :_0.3514598e-3_metre;
        :dimension          :length-dimension;
        :symbol             "pt" .

:pica-TeX  rdf:type         owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The TeX pica is a unit of length defined as 12 point (TeX)."@en;
        rdfs:label          "pica (TeX)"@en;
        :alternative_label  "TeX pica"@en;
        :definition         :_12_point-TeX;
        :dimension          :length-dimension .

:pica-Postscript  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The Postscript pica is a unit of length defined as 12 point (Postscript)."@en;
        rdfs:label          "pica (Postscript)"@en;
        :alternative_label  "Postscript pica"@en;
        :definition         :_12_point-Postscript;
        :dimension          :length-dimension .

:pica-ATA  rdf:type         owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The ATA pica is a unit of length defined as 12 point (ATA)."@en;
        rdfs:label          "pica (ATA)"@en;
        :alternative_label  "ATA pica"@en;
        :definition         :_12_point-ATA;
        :dimension          :length-dimension .

:cicero  rdf:type     owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The cicero is a unit of length defined as 12 point (Didot)."@en;
        rdfs:label    "cicero"@nl , "cicero"@en;
        :definition   :_12_point-Didot;
        :dimension    :length-dimension .

:Font_size_unit  rdf:type    owl:Class;
        rdfs:subClassOf      :Length_unit;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :cicero :pica-ATA :pica-Postscript :pica-TeX :point-ATA :point-Didot :point-Postscript :point-TeX )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :cicero :pica-ATA :pica-Postscript :pica-TeX :point-ATA :point-Didot :point-Postscript :point-TeX )
                             ] .

:Font_size  rdf:type      owl:NamedIndividual , owl:Class;
        rdfs:label        "fontgrootte"@nl , "font size"@en;
        rdfs:subClassOf   :Length;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Font_size_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Font_size_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :unit_of_measure  :point-TeX , :point-Postscript , :point-Didot , :point-ATA , :pica-TeX , :pica-Postscript , :pica-ATA , :cicero .

:rhe    rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The rhe is a unit of fluidity defined as 10 reciprocal pascal second (time)."@en;
        rdfs:label    "rhe"@nl , "rhe"@en;
        :definition   :_1.0e1_reciprocal_pascal_second-time;
        :dimension    :fluidity-dimension .

:reciprocal_pascal_second-time
        rdf:type             owl:NamedIndividual , :Unit_exponentiation;
        rdfs:label           "reciprocal pascal second"@en , "omgekeerde pascal seconde"@nl;
        :alternative_symbol  "Pa-1·s-1" , "(Pa·s)-1" , "(Pa s)-1";
        :base                :pascal_second-time;
        :dimension           :fluidity-dimension;
        :exponent            -1;
        :symbol              "Pa-1 s-1" .

:fluidity-dimension  rdf:type          owl:NamedIndividual , :Dimension;
        rdfs:label                     "fluidity dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  1;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    -1;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    1 .

:Fluidity_unit  rdf:type     owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :reciprocal_pascal_second-time :rhe )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :reciprocal_pascal_second-time :rhe )
                             ] .

:Fluidity  rdf:type       owl:NamedIndividual , owl:Class;
        rdfs:label        "fluidity"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :fluidity-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Fluidity_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :fluidity-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Fluidity_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :unit_of_measure  :rhe , :reciprocal_pascal_second-time .

:Flowpack_mass  rdf:type   owl:NamedIndividual , owl:Class;
        rdfs:label         "flowpack mass"@en;
        rdfs:subClassOf    :Mass;
        :unit_of_measure   :kilogram , :tonne , :gram;
        :unofficial_label  "flowpack weight" .

