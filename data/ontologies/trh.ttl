KiReSOntFM:Flexion rdf:type owl:Class ;
                   rdfs:subClassOf KiReSOntFM:MovementType ;
                   rdfs:comment "Flexion movement type" ;
                   rdfs:label "Flexion"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#HorAbduction
KiReSOntFM:HorAbduction rdf:type owl:Class ;
                        rdfs:subClassOf KiReSOntFM:MovementType ;
                        rdfs:comment "Horizontal abduction movement type" ;
                        rdfs:label "HorAbduction"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#HorAdduction
KiReSOntFM:HorAdduction rdf:type owl:Class ;
                        rdfs:subClassOf KiReSOntFM:MovementType ;
                        rdfs:comment "Horizontal adduction movement type" ;
                        rdfs:label "HorAdduction"@en .


