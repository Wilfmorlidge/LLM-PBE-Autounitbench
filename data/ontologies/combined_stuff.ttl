        :dimension  :frequency-dimension;
        :exponent   -1;
        :symbol     "min-1" .

:reciprocal_hour  rdf:type  owl:NamedIndividual , :Unit_exponentiation;
        rdfs:label  "reciprocal hour"@en , "omgekeerd uur"@nl;
        :base       :hour;
        :dimension  :frequency-dimension;
        :exponent   -1;
        :symbol     "h-1" .

:reciprocal_day  rdf:type  owl:NamedIndividual , :Unit_exponentiation;
