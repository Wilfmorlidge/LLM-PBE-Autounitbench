                             ] .

:Torque  rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:comment      "Torque is the effectiveness of a force to produce rotation about an axis, measured by the product of the force and the perpendicular distance from the line of action of the force to the axis."@en;
        rdfs:label        "扭矩"@zh , "torque"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :energy-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Torque_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :energy-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Torque_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "T";
        :unit_of_measure  :newton_metre , :millinewton_metre , :micronewton_metre .

:Top_mass  rdf:type        owl:NamedIndividual , owl:Class;
        rdfs:label         "top mass"@en;
        rdfs:subClassOf    :Mass;
        :unit_of_measure   :kilogram , :tonne , :gram;
        :unofficial_label  "top weight" .

:year-tropical  rdf:type    owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The tropical year is a unit of time defined as 3.155693e7 second."@en;
        rdfs:label          "year (tropical)"@en;
        :alternative_label  "tropical year"@en;
        :definition         :_3.155693e7_second-time;
        :dimension          :time-dimension .

:year-sidereal  rdf:type    owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The sidereal year is a unit of time defined as 3.155815e7 second."@en;
        rdfs:label          "year (sidereal)"@en;
        :alternative_label  "sidereal year"@en;
        :definition         :_3.155815e7_second-time;
        :dimension          :time-dimension .

:year   rdf:type             owl:NamedIndividual , :Singular_unit;
        rdfs:comment         "The year is a unit of time defined as 3.1536e7 second."@en;
        rdfs:label           "year"@en , "jaar"@nl;
        :LaTeX_command       "\\yearUnit";
        :alternative_symbol  "yr" , "y";
        :definition          :_3.1536e7_second-time;
        :dimension           :time-dimension;
        :symbol              "a" .

:shake  rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The shake is a unit of time defined as 1.0e-8 second."@en;
        rdfs:label    "shake"@en;
        :definition   :_1.0e-8_second-time;
        :dimension    :time-dimension .

:second-sidereal  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The sidereal second is a unit of time defined as 9.972696e-1 second."@en;
        rdfs:label          "second (sidereal)"@en;
        :alternative_label  "sidereal second"@en , "second (sidereal)"@en;
        :definition         :_9.972696e-1_second-time;
        :dimension          :time-dimension .

:minute-time  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The minute (time) is a unit of time defined as 60 second."@en;
        rdfs:label    "分钟"@zh , "minuut"@nl , "minute"@en;
        :definition   :_6.0e1_second-time;
        :dimension    :time-dimension;
        :symbol       "min" .

:minute-sidereal  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The sidereal minute is a unit of time defined as 5.983617e1 second."@en;
        rdfs:label          "minute (sidereal)"@en;
        :alternative_label  "sidereal minute"@en;
        :definition         :_5.983617e1_second-time;
        :dimension          :time-dimension .

:hour-sidereal  rdf:type    owl:NamedIndividual , :Singular_unit;
        rdfs:label          "hour (sidereal)"@en;
        :alternative_label  "sidereal hour"@en;
        :definition         :_3.590170e3_second-time;
        :dimension          :time-dimension .

:hour   rdf:type             owl:NamedIndividual , :Singular_unit;
        rdfs:comment         "The hour is a unit of time defined as 3600 second."@en;
        rdfs:label           "小时"@zh , "uur"@nl , "hour"@en;
        :alternative_symbol  "u";
        :definition          :_3.6e3_second-time;
        :dimension           :time-dimension;
        :symbol              "h" .

:gigayear  rdf:type     owl:NamedIndividual , :Unit_multiple_or_submultiple;
        rdfs:label      "gigayear"@en , "gigajaar"@nl;
        :dimension      :time-dimension;
        :prefix         :giga;
        :singular_unit  :year;
        :symbol         "Gyr" .

:day-sidereal  rdf:type     owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The sidereal day is a unit of time defined as 8.616409e4 second."@en;
        rdfs:label          "day (sidereal)"@en;
        :alternative_label  "sidereal day"@en;
        :definition         :_8.616409e4_second-time;
        :dimension          :time-dimension .

:day    rdf:type        owl:NamedIndividual , :Singular_unit;
        rdfs:comment    "The day is a unit of time defined as 86400 second."@en;
        rdfs:label      "天"@zh , "day"@en , "dag"@nl;
        :LaTeX_command  "\\dayUnit";
        :definition     :_86400_second-time;
        :dimension      :time-dimension;
        :symbol         "d" .

:Time_constant  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "Time required to approach (1-1/e) of the final output value of a detector (about 63%) (Kitchin, Astrophysical Techniques, IoP, Table 1.1.2)."@en;
        rdfs:label        "time constant"@en;
        rdfs:subClassOf   :Time;
        :symbol           "τ";
        :unit_of_measure  :second-time .

:time-dimension  rdf:type              owl:NamedIndividual , :Dimension;
        rdfs:label                     "time dimension"@en , "dimensie van tijd"@nl;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  0;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    1;
        :symbol                        "T" .

:Time_unit  rdf:type         owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Second-time_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :day :day-sidereal :gigayear :hour :hour-sidereal :minute-sidereal :minute-time :second-sidereal :second-time :shake :year :year-sidereal :year-tropical )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Second-time_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :day :day-sidereal :gigayear :hour :hour-sidereal :minute-sidereal :minute-time :second-sidereal :second-time :shake :year :year-sidereal :year-tropical )
                                              ]
                                            )
                             ] .

:Thuan_and_Gunn_magnitude
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:comment     "A magnitude measured in one of Thuan and Gunn's standard passbands (using a standard filter, i.e. g)."@en;
        rdfs:label       "Thuan and Gunn magnitude"@en;
        rdfs:subClassOf  :Magnitude .

:Thrust  rdf:type         owl:Class , owl:NamedIndividual;
        rdfs:comment      "Thrust is a reaction force that is caused by an accelerated mass expelled by a system in one direction."@en;
        rdfs:label        "stuwkracht"@nl , "thrust"@en;
        rdfs:subClassOf   :Force;
        :unit_of_measure  :teranewton , :piconewton , :petanewton , :nanonewton , :millinewton , :micronewton , :meganewton , :kilonewton , :hectonewton , :giganewton , :femtonewton , :exanewton , :dyne , :kip , :metre_kilogram_per_second-time_squared , :newton , :pound-force , :poundal , :ton-force-short , :attonewton , :centinewton , :decanewton , :decinewton .

:Thomson_coefficient  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label           "Thomson coefficient"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_symbol  "τ";
        :symbol              "μ" .

:Thickness  rdf:type         owl:Class , owl:NamedIndividual;
        rdfs:label           "dikte"@nl , "thickness"@en;
        rdfs:subClassOf      :Length;
        :alternative_symbol  "δ";
        :symbol              "d";
        :unit_of_measure     :terametre , :picometre , :petametre , :nanometre , :millimetre , :micrometre , :megametre , :kilometre , :hectometre , :gigametre , :femtometre , :exametre , :decimetre , :decametre , :centimetre , :attometre , :yard-international , :solar_radius , :rod-US , :parsec , :nautical_mile-international , :mile-statute , :mile-US_survey , :mil-length , :micron , :metre , :megaparsec , :light_year , :kiloparsec , :inch-international , :gigaparsec , :furlong-international , :foot-international , :foot-US_survey , :fermi , :fathom-US_survey , :chain , :cicero , :pica-ATA , :pica-Postscript , :pica-TeX , :point-ATA , :point-Didot , :point-Postscript , :point-TeX , :angstrom , :astronomical_unit .

:Thermoelectromotive_force_between_substances_a_and_b
        rdf:type             owl:NamedIndividual , owl:Class;
        rdfs:label           "thermoelectromotive force between substances a and b"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_symbol  "Θ_ab";
        :symbol              "E_ab" .

:Thermodynamic_temperature_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Temperature_unit;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Kelvin_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :kelvin )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Kelvin_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :kelvin )
                                              ]
                                            )
                             ] .

:Thermal_resistance_unit
        rdf:type  owl:Class .

:thermal_resistance-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "thermal resistance dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  -2;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    -1;
        :SI_thermodynamic_temperature_dimension_exponent
                1;
        :SI_time_dimension_exponent    3 .

:Thermal_resistance  rdf:type  owl:Class;
        rdfs:label       "thermal resistance"@en;
        rdfs:subClassOf  :Quantity;
        rdfs:subClassOf  [ rdf:type        owl:Restriction;
                           owl:hasValue    :thermal_resistance-dimension;
                           owl:onProperty  :dimension
                         ];
        rdfs:subClassOf  [ rdf:type        owl:Restriction;
                           owl:hasValue    :thermal_resistance-dimension;
                           owl:onProperty  :dimension
                         ] .

:Thermal_diffusivity  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label           "thermische diffusiviteit"@nl , "thermal diffusivity"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_symbol  "D";
        :symbol              "a" .

:Thermal_diffusion_ratio
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "thermal diffusion ratio"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "k_T" .

:Thermal_diffusion_factor
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "thermal diffusion factor"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "α_T" .

:Thermal_diffusion_coefficient
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "thermal diffusion coefficient"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "D_td" .

:watt_per_metre_kelvin
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "watt per metre kelvin"@en , "watt per meter kelvin"@nl;
        :alternative_symbol  "W·m-1·K-1" , "W/(m·K)" , "W m-1 K-1";
        :denominator         :metre_kelvin;
        :dimension           :thermal_conductivity-dimension;
        :numerator           :watt;
        :symbol              "W/(m K)" .

:Thermal_conductivity_tensor
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "thermal conductivity tensor"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "λ_ik" .

:thermal_conductivity-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "thermal conductivity dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  1;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    1;
        :SI_thermodynamic_temperature_dimension_exponent
                -1;
        :SI_time_dimension_exponent    -3 .

:Thermal_conductivity_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :watt_per_metre_kelvin )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :watt_per_metre_kelvin )
                             ] .

:Thermal_conductivity
        rdf:type             owl:NamedIndividual , owl:Class;
        rdfs:comment         "Termal conductivity indicates the ability of a material to conduct heat."@en;
        rdfs:label           "thermische geleidbaarheid"@nl , "thermal conductivity"@en;
        rdfs:subClassOf      :Quantity;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :thermal_conductivity-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Thermal_conductivity_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :thermal_conductivity-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Thermal_conductivity_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        :alternative_symbol  "λ" , "k" , "K";
        :symbol              "κ";
        :unit_of_measure     :watt_per_metre_kelvin .

:Ternary_rate_coefficient
        rdf:type            owl:NamedIndividual , owl:Class;
        rdfs:label          "ternary rate coefficient"@en;
        rdfs:subClassOf     :Quantity;
        :alternative_label  "three-body rate coefficient"@en;
        :symbol             "k_t" .

:degree_Celsius_per_second-time
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "graad Celsius per seconde"@nl , "degree Celsius per second"@en;
        :alternative_symbol  "°C·s-1" , "°C s-1";
        :denominator         :second-time;
        :numerator           :degree_Celsius;
        :symbol              "°C/s" .

:degree_Celsius_per_minute-time
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "graad Celsius per minuut"@nl , "degree Celsius per minute"@en;
        :alternative_symbol  "°C·min-1" , "°C min-1";
        :denominator         :minute-time;
        :numerator           :degree_Celsius;
        :symbol              "°C/min" .

:degree_Celsius_per_hour
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "graad Celsius per uur"@nl , "degree Celsius per hour"@en;
        :alternative_symbol  "°C·h-1" , "°C h-1";
        :denominator         :hour;
        :numerator           :degree_Celsius;
        :symbol              "°C/h" .

:Temperature_rate_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :degree_Celsius_per_hour :degree_Celsius_per_minute-time :degree_Celsius_per_second-time )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :degree_Celsius_per_hour :degree_Celsius_per_minute-time :degree_Celsius_per_second-time )
                             ] .

:Temperature_rate  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label         "temperatuur-rate"@nl , "temperature rate"@en;
        rdfs:subClassOf    :Quantity;
        rdfs:subClassOf    [ rdf:type           owl:Restriction;
                             owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                  owl:allValuesFrom  :Temperature_rate_unit;
                                                  owl:onProperty     :unit_of_measure_or_measurement_scale
                                                ];
                             owl:onProperty     :value
                           ];
        rdfs:subClassOf    [ rdf:type           owl:Restriction;
                             owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                  owl:allValuesFrom  :Temperature_rate_unit;
                                                  owl:onProperty     :unit_of_measure_or_measurement_scale
                                                ];
                             owl:onProperty     :value
                           ];
        :unit_of_measure   :degree_Celsius_per_minute-time;
        :unofficial_label  "heating rate" .

:thermodynamic_temperature-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "thermodynamic temperature dimension"@en , "absolute-temperatuurdimensie"@nl;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  0;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                1;
        :SI_time_dimension_exponent    0;
        :symbol                        "Θ" .

:Temperature_scale  rdf:type  owl:Class;
        rdfs:subClassOf      :Measurement_scale;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :Celsius_scale :Fahrenheit_scale :Kelvin_scale :Rankine_scale :Reaumur_scale )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :Celsius_scale :Fahrenheit_scale :Kelvin_scale :Rankine_scale :Reaumur_scale )
                             ] .

:Tangential_acceleration
        rdf:type         owl:Class;
        rdfs:label       "tangential acceleration"@en;
        rdfs:subClassOf  :Quantity .

:Symmetry_number  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "symmetry number"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "s" .

:baud   rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The baud is a unit of symbol rate defined as one distinct symbol change or signalling event made to the transmission medium per second in a digitally modulated signal or a line code."@en;
        rdfs:label    "baud"@nl , "baud"@en;
        :definition   :one_distinct_symbol_change_or_signalling_event_made_to_the_transmission_medium_per_second_in_a_digitally_modulated_signal_or_a_line_code;
        :symbol       "Bd" .

:Symbol_rate_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :baud )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :baud )
                             ] .

:Symbol_rate  rdf:type      owl:NamedIndividual , owl:Class;
        rdfs:comment        "Symbol rate is the number of symbol changes (signalling events) made to the transmission medium per second using a digitally modulated signal or a line code."@en;
        rdfs:label          "symbol rate"@en;
        rdfs:subClassOf     :Quantity;
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Symbol_rate_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Symbol_rate_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        :alternative_label  "modulation rate"@en , "baud rate"@en;
        :unit_of_measure    :baud .

:Susceptance  rdf:type   owl:NamedIndividual , owl:Class;
        rdfs:label       "susceptance"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "B" .

