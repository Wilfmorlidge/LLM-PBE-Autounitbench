:Temperature_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Degree_Celsius_multiple_or_submultiple :Kelvin_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :degree_Celsius :degree_Fahrenheit :degree_Rankine :degree_Reaumur :kelvin )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Degree_Celsius_multiple_or_submultiple :Kelvin_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :degree_Celsius :degree_Fahrenheit :degree_Rankine :degree_Reaumur :kelvin )
                                              ]
                                            )
                             ] .

:degree_Celsius  rdf:type   owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The degree Celsius is a unit of temperature defined as 1 kelvin."@en;
        rdfs:label          "摄氏度"@zh , "graad Celsius"@nl , "degree Celsius"@en;
        :alternative_label  "centigrade"@en;
        :definition         :kelvin;
        :dimension          :thermodynamic_temperature-dimension;
        :longcomment        "The degree Celsius is a unit of temperature defined as 1 kelvin. The degree Celsius is a derived unit in the International System of Units.";
        :symbol             "°C" .

:Degree_Celsius_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :degree_Celsius;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :degree_Celsius;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:Celsius_temperature_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Temperature_unit;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Degree_Celsius_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :degree_Celsius )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Degree_Celsius_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :degree_Celsius )
                                              ]
                                            )
                             ] .

:Temperature  rdf:type            owl:Class , owl:NamedIndividual;
        rdfs:comment              "Temperature is the extent to which an object is hot."@en;
        rdfs:label                "temperature"@en , "temperatuur"@nl , "温度"@zh;
        rdfs:subClassOf           :Quantity;
        rdfs:subClassOf           [ rdf:type        owl:Restriction;
                                    owl:hasValue    :thermodynamic_temperature-dimension;
                                    owl:onProperty  :dimension
                                  ];
        rdfs:subClassOf           [ rdf:type           owl:Restriction;
                                    owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                         owl:allValuesFrom  [ rdf:type     owl:Class;
                                                                              owl:unionOf  ( :Temperature_scale :Temperature_unit )
                                                                            ];
                                                         owl:onProperty     :unit_of_measure_or_measurement_scale
                                                       ];
                                    owl:onProperty     :value
                                  ];
        rdfs:subClassOf           [ rdf:type           owl:Restriction;
                                    owl:allValuesFrom  [ rdf:type   owl:Class;
                                                         owl:oneOf  ( :Celsius_scale :Fahrenheit_scale :Kelvin_scale :Rankine_scale :Reaumur_scale )
                                                       ];
                                    owl:onProperty     :measurement_scale
                                  ];
        rdfs:subClassOf           [ rdf:type        owl:Restriction;
                                    owl:hasValue    :thermodynamic_temperature-dimension;
                                    owl:onProperty  :dimension
                                  ];
        rdfs:subClassOf           [ rdf:type           owl:Restriction;
                                    owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                         owl:allValuesFrom  [ rdf:type     owl:Class;
                                                                              owl:unionOf  ( :Temperature_scale :Temperature_unit )
                                                                            ];
                                                         owl:onProperty     :unit_of_measure_or_measurement_scale
                                                       ];
                                    owl:onProperty     :value
                                  ];
        rdfs:subClassOf           [ rdf:type           owl:Restriction;
                                    owl:allValuesFrom  [ rdf:type   owl:Class;
                                                         owl:oneOf  ( :Celsius_scale :Fahrenheit_scale :Kelvin_scale :Rankine_scale :Reaumur_scale )
                                                       ];
                                    owl:onProperty     :measurement_scale
                                  ];
        :alternative_symbol       "t" , "θ";
        :symbol                   "T";
        :unit_of_measure          :terakelvin , :picokelvin , :petakelvin , :nanokelvin , :millikelvin , :microkelvin , :megakelvin , :kilokelvin , :hectokelvin , :gigakelvin , :femtokelvin , :exakelvin , :decikelvin , :decakelvin , :centikelvin , :attokelvin , :picodegree_Celsius , :nanodegree_Celsius , :millidegree_Celsius , :microdegree_Celsius , :femtodegree_Celsius , :decidegree_Celsius , :centidegree_Celsius , :degree_Celsius , :degree_Fahrenheit , :kelvin , :degree_Rankine , :degree_Reaumur , :attodegree_Celsius;
        :unofficial_abbreviation  "temp" .

:Celsius_temperature  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:label           "Celsius temperature"@en , "Celsiustemperatuur"@nl;
        rdfs:subClassOf      :Temperature;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :Celsius_scale;
                               owl:onProperty  :measurement_scale
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  [ rdf:type     owl:Class;
                                                                         owl:unionOf  ( :Celsius_temperature_scale :Celsius_temperature_unit )
                                                                       ];
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :Celsius_scale;
                               owl:onProperty  :measurement_scale
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  [ rdf:type     owl:Class;
                                                                         owl:unionOf  ( :Celsius_temperature_scale :Celsius_temperature_unit )
                                                                       ];
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        :alternative_symbol  "θ";
        :symbol              "t";
        :unit_of_measure     :degree_Celsius , :attodegree_Celsius , :centidegree_Celsius , :decidegree_Celsius , :femtodegree_Celsius , :microdegree_Celsius , :millidegree_Celsius , :nanodegree_Celsius , :picodegree_Celsius .

:Celsius_temperature_scale
        rdf:type         owl:Class;
        rdfs:subClassOf  :Measurement_scale .

:Celsius_scale  rdf:type         owl:Class , :Interval_scale , owl:NamedIndividual;
        rdfs:label               "Celsius scale"@en , "Celsiusschaal"@nl , "摄氏温标"@zh;
        owl:equivalentClass      :Celsius_temperature_scale;
        :alternative_label       "International Celsius Temperature scale of 1990"@en;
        :definition_description  "t90/°C = T90/K - 273.15";
        :definition_factor       "1.0"^^xsd:float;
        :definition_off-set      "-273.15"^^xsd:float;
        :definition_relative_to  :Kelvin_scale;
        :dimension               :thermodynamic_temperature-dimension;
        :element                 :_approximately_-256_15_on_the_Celsius_scale , :_approximately_-252_85_on_the_Celsius_scale , :_961_78_on_the_Celsius_scale , :_660_323_on_the_Celsius_scale , :_419_527_on_the_Celsius_scale , :_29_7646_on_the_Celsius_scale , :_231_928_on_the_Celsius_scale , :_156_5985_on_the_Celsius_scale , :_1084_62_on_the_Celsius_scale , :_1064_18_on_the_Celsius_scale , :_0_01_on_the_Celsius_scale , :_-189_3442_on_the_Celsius_scale , :_-218_7916_on_the_Celsius_scale , :_-248_5939_on_the_Celsius_scale , :_-259_3467_on_the_Celsius_scale , :_-270_15_to_-268_15_on_the_Celsius_scale , :_-38_8344_on_the_Celsius_scale;
        :unit_of_measure         :degree_Celsius .

