KiReSOntFM:NamedExercise rdf:type owl:Class ;
                         rdfs:subClassOf KiReSOntFM:Exercise ;
                         rdfs:comment "Exercise with a proper name" ;
                         rdfs:label "NamedExercise"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#NamedMovement
KiReSOntFM:NamedMovement rdf:type owl:Class ;
                         rdfs:subClassOf KiReSOntFM:Movement ;
                         rdfs:comment "Movement with a proper name" ;
                         rdfs:label "NamedMovement"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#Phase
KiReSOntFM:Phase rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                              owl:onProperty KiReSOntFM:hasConditions ;
                                                              owl:someValuesFrom KiReSOntFM:Condition
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty KiReSOntFM:hasExercise ;
                                                              owl:someValuesFrom KiReSOntFM:Exercise
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty KiReSOntFM:hasSeries ;
                                                              owl:someValuesFrom xsd:integer
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:subClassOf KiReSOntFM:KiReSOntFMConcept ;
                 rdfs:comment "Phase of a protocol" ;
                 rdfs:label "Phase"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#Submovement
KiReSOntFM:Submovement rdf:type owl:Class ;
                       rdfs:subClassOf KiReSOntFM:KiReSOntFMConcept ,
                                       [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                owl:onProperty KiReSOntFM:hasLocation ;
                                                                owl:someValuesFrom fma:fma7490
                                                              ]
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty KiReSOntFM:hasMovementType ;
                                                                owl:someValuesFrom KiReSOntFM:MovementType
                                                              ]
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty KiReSOntFM:hasROMmax ;
                                                                owl:someValuesFrom xsd:double
                                                              ]
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty KiReSOntFM:hasROMmin ;
                                                                owl:someValuesFrom xsd:double
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                       rdfs:comment "Part of a movement" ;
                       rdfs:label "Submovement"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#TreatmentProtocol
KiReSOntFM:TreatmentProtocol rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Restriction ;
                                                   owl:onProperty KiReSOntFM:hasPhase ;
                                                   owl:someValuesFrom KiReSOntFM:Phase
                                                 ] ;
                             rdfs:subClassOf KiReSOntFM:KiReSOntFMConcept ;
                             rdfs:comment "Treatment protocol" ;
                             rdfs:label "TreatmentProtocol"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#True
KiReSOntFM:True rdf:type owl:Class ;
                rdfs:subClassOf KiReSOntFM:TrueOrFalse ;
                rdfs:comment "True value" ;
                rdfs:label "True"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#TrueOrFalse
KiReSOntFM:TrueOrFalse rdf:type owl:Class ;
                       rdfs:subClassOf KiReSOntFM:KiReSOntFMConcept ;
                       rdfs:comment "True or false" ;
                       rdfs:label "TrueOrfalse"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#Ability
TrhOnt:Ability rdf:type owl:Class ;
               rdfs:comment "Capacity of the patient to perform some activity" ;
               rdfs:label "Ability"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#AnatomicalPlane
TrhOnt:AnatomicalPlane rdf:type owl:Class ;
                       rdfs:comment "Anatomical plane (frontal, saggital, transverse)" ;
                       rdfs:label "AnatomicalPlane"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#Anomaly
TrhOnt:Anomaly rdf:type owl:Class ;
               rdfs:subClassOf [ owl:intersectionOf ( TrhOnt:PathologicalCondition
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty KiReSOntFM:hasLocation ;
                                                        owl:allValuesFrom fma:fma67165
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty TrhOnt:hasIntensity ;
                                                        owl:allValuesFrom TrhOnt:Intensity
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty TrhOnt:hasTimespan ;
                                                        owl:allValuesFrom TrhOnt:Timespan
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
               rdfs:comment "Anomaly" ;
               rdfs:label "Anomaly"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#Answer
TrhOnt:Answer rdf:type owl:Class ;
              rdfs:subClassOf owl:Thing ;
              rdfs:comment "Response to an item of the patient's physiotherapy record" ;
              rdfs:label "Answer"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#CA1.1
TrhOnt:CA1.1 rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( TrhOnt:Answer
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty TrhOnt:hasAge ;
                                                          owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                               owl:onDatatype xsd:integer ;
                                                                               owl:withRestrictions ( [ xsd:minInclusive 0
                                                                                                      ]
                                                                                                    )
                                                                             ]
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:subClassOf TrhOnt:Answer ;
             rdfs:comment "What is the patient's age?" ;
             rdfs:label "CA1.1"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#CA1.10
TrhOnt:CA1.10 rdf:type owl:Class ;
              rdfs:subClassOf [ owl:intersectionOf ( TrhOnt:Answer
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty TrhOnt:validFrom ;
                                                       owl:someValuesFrom xsd:dateTime
                                                     ]
                                                   ) ;
                                rdf:type owl:Class
                              ] ;
              rdfs:comment "When was the treatment started?" ;
              rdfs:label "CA1.10"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#CA1.11
TrhOnt:CA1.11 rdf:type owl:Class ;
              rdfs:subClassOf [ owl:intersectionOf ( TrhOnt:Answer
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty TrhOnt:hasFrequency ;
                                                       owl:someValuesFrom TrhOnt:Frequency
                                                     ]
                                                   ) ;
                                rdf:type owl:Class
                              ] ;
              rdfs:comment "What is the frequency of the treatment?" ;
              rdfs:label "CA1.11"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#CA1.12
TrhOnt:CA1.12 rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( TrhOnt:Answer
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty TrhOnt:hasExternalDiagnosis ;
                                                           owl:someValuesFrom TrhOnt:ExternalDiagnosis
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:comment "Which non-physiotherapy-related diagnoses does the patient have?" ;
              rdfs:label "CA1.12"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#CA1.13
TrhOnt:CA1.13 rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( TrhOnt:Answer
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty TrhOnt:hasDrugIntake ;
                                                           owl:someValuesFrom TrhOnt:DrugIntake
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:comment "Which drugs does the patient currently take?" ;
              rdfs:label "CA1.13"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#CA1.14
TrhOnt:CA1.14 rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( TrhOnt:Answer
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty TrhOnt:hasGender ;
                                                           owl:someValuesFrom TrhOnt:Gender
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:comment "What is the patient's gender?" ;
              rdfs:label "CA1.14"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#CA1.15
TrhOnt:CA1.15 rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( TrhOnt:Answer
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty TrhOnt:hasNumberOfSessions ;
                                                           owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                owl:onDatatype xsd:integer ;
                                                                                owl:withRestrictions ( [ xsd:minInclusive 0
                                                                                                       ]
                                                                                                     )
                                                                              ]
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:subClassOf TrhOnt:Answer ;
              rdfs:comment "How many sessions has the patient attended?" ;
              rdfs:label "CA1.15"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#CA1.16
TrhOnt:CA1.16 rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( TrhOnt:Answer
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty TrhOnt:hasDischargeDate ;
                                                           owl:someValuesFrom xsd:dateTime
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:comment "What is the patient's discharge date?" ;
              rdfs:label "CA1.16"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#CA1.17
TrhOnt:CA1.17 rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty TrhOnt:hasStaticExploration ;
                                    owl:someValuesFrom TrhOnt:StaticExploration
                                  ] ;
              rdfs:subClassOf TrhOnt:Answer ;
              rdfs:comment "What is the visual static exploration of the patient?" ;
              rdfs:label "CA1.17"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#CA1.18
TrhOnt:CA1.18 rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty TrhOnt:hasDynamicExploration ;
                                    owl:someValuesFrom TrhOnt:DynamicExploration
                                  ] ;
              rdfs:subClassOf TrhOnt:Answer ;
              rdfs:comment "What is the visual dynamic exploration of the patient?" ;
              rdfs:label "CA1.18"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#CA1.19
TrhOnt:CA1.19 rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( TrhOnt:Answer
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty TrhOnt:hasMuscleStrengthExploration ;
                                                           owl:someValuesFrom TrhOnt:MuscleStrengthExploration
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:comment "What is the strength exploration of the patient?" ;
              rdfs:label "CA1.19"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#CA1.2
TrhOnt:CA1.2 rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( TrhOnt:Answer
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty TrhOnt:hasAnomaly ;
                                                          owl:someValuesFrom TrhOnt:Anomaly
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:subClassOf TrhOnt:Answer ;
             rdfs:comment "Which health issue does the patient report?" ;
             rdfs:label "CA1.2"@en .


