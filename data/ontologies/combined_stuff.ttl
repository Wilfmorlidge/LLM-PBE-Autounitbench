                                              ]
                                            )
                             ] .

:Catalytic_activity  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:label        "catalytic activity"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
