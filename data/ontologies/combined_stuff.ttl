        rdfs:subClassOf      :Length;
        :alternative_symbol  "λ";
        :symbol              "l";
        :unit_of_measure     :terametre , :picometre , :petametre , :nanometre , :millimetre , :micrometre , :megametre , :kilometre , :hectometre , :gigametre , :femtometre , :exametre , :decimetre , :decametre , :centimetre , :attometre , :yard-international , :rod-US , :parsec , :nautical_mile-international , :mile-statute , :mile-US_survey , :mil-length , :micron , :metre , :megaparsec , :light_year , :inch-international , :furlong-international , :foot-international , :foot-US_survey , :fermi , :fathom-US_survey , :chain , :cicero , :pica-ATA , :pica-Postscript , :pica-TeX , :point-ATA , :point-Didot , :point-Postscript , :point-TeX , :angstrom , :astronomical_unit .

