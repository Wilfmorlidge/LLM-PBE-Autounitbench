        rdfs:label           "newton per metre"@en , "newton per meter"@nl;
        :alternative_symbol  "N·m-1" , "N m-1";
        :denominator         :metre;
        :dimension           :surface_tension-dimension;
        :numerator           :newton;
        :symbol              "N/m" .

:surface_tension-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "surface tension dimension"@en , "oppervlaktespanningdimensie"@nl;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  0;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    1;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
