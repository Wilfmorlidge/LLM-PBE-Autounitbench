###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#Patient
TrhOnt:Patient rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty TrhOnt:hasRecord ;
                                 owl:someValuesFrom TrhOnt:PhysiotherapyRecord
                               ] ;
               rdfs:comment "Patient" ;
               rdfs:label "Patient"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#Patient2015
TrhOnt:Patient2015 rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Class ;
                                         owl:oneOf ( TrhOnt:patient2015
                                                   )
                                       ] ;
                   rdfs:subClassOf TrhOnt:Patient ;
                   rdfs:comment "Example of a specific patient. This class should not be part of this ontology, it will be created and eliminated dinamically when working with a specific patient. We include it as an example to support inferences described in our paper." ;
                   rdfs:label "Patient2015"@en .


