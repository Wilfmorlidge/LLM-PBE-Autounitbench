@prefix : <http://bdi.si.ehu.es/bdi/ontologies/MergedTrhOnt#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix fma: <http://purl.org/sig/ont/fma/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix terms: <http://purl.org/dc/terms/> .
@prefix TrhOnt: <http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#> .
@prefix GlenOnt: <http://bdi.si.ehu.es/bdi/ontologies/GlenOnt#> .
@prefix KiReSOntFM: <http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#> .
@base <http://bdi.si.ehu.es/bdi/ontologies/MergedTrhOnt#> .

<http://bdi.si.ehu.es/bdi/ontologies/MergedTrhOnt> rdf:type owl:Ontology ;
                                                    dc:source "Source of GlenOnt: FMA ontology (http://bioportal.bioontology.org/ontologies/FMA)" ;
                                                    dc:title "Telerehabilitation Ontology (Merged version)" ;
                                                    terms:license "http://purl.org/NET/rdflicense/cc-by3.0" ;
                                                    rdfs:comment """This is a merged ontology created from the files GlenOnt, KiReSFM, KiReS and TrhOnt located in 

The GlenOnt ontology is a module from the FMA ontology (see dc:source) that comprises relevant classes for the physiotherapy treatment of issues related to the glenohumeral joint.

Attribution: FMA ontology has been developed by the Structural Informatics Group, University of Washington. The GlenOnt ontology is a module extracted from FMA by BDI Group, University of the Basque Country. Remaining modules were created by BDI Group, University of the Basque Country.

Changes made to the original FMA ontology: pruning of classes/properties that are not relevant for the glenohumeral joint. Added property UMLS_code to indicate the corresponding UMLS_code of some of the classes.""" .

#################################################################
#    Annotation properties
#################################################################

###  http://bdi.si.ehu.es/bdi/ontologies/GlenOnt#UMLS_code



###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#answerTo
TrhOnt:answerTo rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/source
dc:source rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
terms:license rdf:type owl:AnnotationProperty .


###  http://purl.org/sig/ont/fma/Date_entered_modified



###  http://purl.org/sig/ont/fma/English_equivalent
fma:English_equivalent rdf:type owl:AnnotationProperty .


###  http://purl.org/sig/ont/fma/Eponym
fma:Eponym rdf:type owl:AnnotationProperty .


###  http://purl.org/sig/ont/fma/FMAID
fma:FMAID rdf:type owl:AnnotationProperty .


###  http://purl.org/sig/ont/fma/TA_ID
fma:TA_ID rdf:type owl:AnnotationProperty .


###  http://purl.org/sig/ont/fma/author



###  http://purl.org/sig/ont/fma/authority



###  http://purl.org/sig/ont/fma/definition
fma:definition rdf:type owl:AnnotationProperty .


###  http://purl.org/sig/ont/fma/language
fma:language rdf:type owl:AnnotationProperty .


###  http://purl.org/sig/ont/fma/modification



###  http://purl.org/sig/ont/fma/modified_by



###  http://purl.org/sig/ont/fma/non-English_equivalent
fma:non-English_equivalent rdf:type owl:AnnotationProperty .


###  http://purl.org/sig/ont/fma/other_Latin_equivalents
fma:other_Latin_equivalents rdf:type owl:AnnotationProperty .


###  http://purl.org/sig/ont/fma/preferred_name
fma:preferred_name rdf:type owl:AnnotationProperty .


###  http://purl.org/sig/ont/fma/reference
fma:reference rdf:type owl:AnnotationProperty .


###  http://purl.org/sig/ont/fma/slot_synonym
fma:slot_synonym rdf:type owl:AnnotationProperty .


###  http://purl.org/sig/ont/fma/synonym
fma:synonym rdf:type owl:AnnotationProperty .


###  http://purl.org/sig/ont/fma/term_status



###  http://www.w3.org/2002/07/owl#qualifiedCardinality
owl:qualifiedCardinality rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#hasComponent
KiReSOntFM:hasComponent rdf:type owl:ObjectProperty ;
                        rdfs:domain KiReSOntFM:Movement ;
                        rdfs:range KiReSOntFM:Submovement ;
                        rdfs:comment "To specify the submovements that compose a movement" .


###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#hasConditions
KiReSOntFM:hasConditions rdf:type owl:ObjectProperty ;
                         rdfs:domain KiReSOntFM:Phase ;
                         rdfs:range KiReSOntFM:Condition ;
                         rdfs:comment "To specify the conditions of a phase" .


###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#hasExercise
KiReSOntFM:hasExercise rdf:type owl:ObjectProperty ;
                       rdfs:domain KiReSOntFM:Phase ;
                       rdfs:range KiReSOntFM:Exercise .


###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#hasInverseMovement
KiReSOntFM:hasInverseMovement rdf:type owl:ObjectProperty ;
                              rdfs:domain KiReSOntFM:Movement ;
                              rdfs:range KiReSOntFM:Movement ;
                              rdfs:comment "To specify the inverse movement of a movement" .


###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#hasLocation
KiReSOntFM:hasLocation rdf:type owl:ObjectProperty ;
                       rdfs:domain owl:Thing ;
                       rdfs:range fma:fma67165 ;
                       rdfs:comment "To specify a body location" .


###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#hasMovement
KiReSOntFM:hasMovement rdf:type owl:ObjectProperty ;
                       rdfs:domain KiReSOntFM:Exercise ;
                       rdfs:range KiReSOntFM:Movement ;
                       rdfs:comment "To specify the movements of an exercise" .


###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#hasMovementType
KiReSOntFM:hasMovementType rdf:type owl:ObjectProperty ;
                           rdfs:domain KiReSOntFM:Submovement ;
                           rdfs:range KiReSOntFM:MovementType ;
                           rdfs:comment "To specify the type of movement" .


###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#hasPain
KiReSOntFM:hasPain rdf:type owl:ObjectProperty ;
                   rdfs:domain KiReSOntFM:Condition ;
                   rdfs:range KiReSOntFM:TrueOrFalse ;
                   rdfs:comment "To specify whether the patient suffers pain or not during the performance of the exercises" .


###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#hasPhase
KiReSOntFM:hasPhase rdf:type owl:ObjectProperty ;
                    rdfs:domain KiReSOntFM:TreatmentProtocol ;
                    rdfs:range KiReSOntFM:Phase .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#OWLObjectProperty_150f4fc8_7ca7_40ff_9229_cc7626f739aa
TrhOnt:OWLObjectProperty_150f4fc8_7ca7_40ff_9229_cc7626f739aa rdf:type owl:ObjectProperty ;
                                                              owl:inverseOf TrhOnt:recommended ;
                                                              rdfs:label "recommendedFor"@es .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#OWLObjectProperty_d1cf5fdf_38ac_4a82_b3b2_a3b128379a10
TrhOnt:OWLObjectProperty_d1cf5fdf_38ac_4a82_b3b2_a3b128379a10 rdf:type owl:ObjectProperty ;
                                                              owl:inverseOf TrhOnt:contraindicated ;
                                                              rdfs:label "contraindicatedFor"@es .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#contraindicated
TrhOnt:contraindicated rdf:type owl:ObjectProperty ;
                       rdfs:domain TrhOnt:Patient ;
                       rdfs:range KiReSOntFM:Exercise ;
                       rdfs:comment "To indicate contraindicated exercises for a patient" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasAbility
TrhOnt:hasAbility rdf:type owl:ObjectProperty ;
                  rdfs:domain TrhOnt:Goal ;
                  rdfs:range TrhOnt:Ability ;
                  rdfs:comment "To indicate an ability to be reached" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasAnatomicalPlane
TrhOnt:hasAnatomicalPlane rdf:type owl:ObjectProperty ;
                          rdfs:domain [ rdf:type owl:Class ;
                                        owl:unionOf ( TrhOnt:DynamicExploration
                                                      TrhOnt:StaticExploration
                                                    )
                                      ] ;
                          rdfs:range TrhOnt:AnatomicalPlane ;
                          rdfs:comment "To indicate the anatomical plane" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasAnomaly
TrhOnt:hasAnomaly rdf:type owl:ObjectProperty ;
                  rdfs:domain TrhOnt:Answer ;
                  rdfs:range TrhOnt:Anomaly ;
                  rdfs:comment "To indicate an anomaly" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasAnswer
TrhOnt:hasAnswer rdf:type owl:ObjectProperty ;
                 rdfs:domain TrhOnt:PhysiotherapyRecord ;
                 rdfs:range TrhOnt:Answer ;
                 rdfs:comment "To indicate an answer to the questions of the physiotherapy record" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasDevice
TrhOnt:hasDevice rdf:type owl:ObjectProperty ;
                 rdfs:domain TrhOnt:MuscleStrengthExploration ;
                 rdfs:range TrhOnt:Device ;
                 rdfs:comment "To indicate the device to be used in the measurement" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasDiagnosis
TrhOnt:hasDiagnosis rdf:type owl:ObjectProperty ;
                    rdfs:domain TrhOnt:Answer ;
                    rdfs:range TrhOnt:Diagnosis ;
                    rdfs:comment "To indicate a diagnosis" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasDrugDose
TrhOnt:hasDrugDose rdf:type owl:ObjectProperty ;
                   rdfs:domain TrhOnt:DrugIntake ;
                   rdfs:range TrhOnt:DrugDose ;
                   rdfs:comment "To indicate the drug dose" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasDrugIntake
TrhOnt:hasDrugIntake rdf:type owl:ObjectProperty ;
                     rdfs:domain TrhOnt:Answer ;
                     rdfs:range TrhOnt:DrugIntake ;
                     rdfs:comment "To indicate how to take a drug" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasDynamicExploration
TrhOnt:hasDynamicExploration rdf:type owl:ObjectProperty ;
                             rdfs:domain TrhOnt:Answer ;
                             rdfs:range TrhOnt:DynamicExploration ;
                             rdfs:comment "To indicate the dynamic exploration of the patient" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasEvolutionItem
TrhOnt:hasEvolutionItem rdf:type owl:ObjectProperty ;
                        rdfs:domain TrhOnt:Answer ;
                        rdfs:range TrhOnt:EvolutionItem ;
                        rdfs:comment "To indicate the evolution items of the patient" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasExternalDiagnosis
TrhOnt:hasExternalDiagnosis rdf:type owl:ObjectProperty ;
                            rdfs:domain TrhOnt:Answer ;
                            rdfs:range TrhOnt:ExternalDiagnosis ;
                            rdfs:comment "To indicate an external (not physiotherapy) diagnosis" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasExternalTerminology
TrhOnt:hasExternalTerminology rdf:type owl:ObjectProperty ;
                              rdfs:domain [ rdf:type owl:Class ;
                                            owl:unionOf ( TrhOnt:DrugIntake
                                                          TrhOnt:ExternalDiagnosis
                                                        )
                                          ] ;
                              rdfs:range TrhOnt:ExternalTerminology ;
                              rdfs:comment "To indicate the external terminology being used" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasFrequency
TrhOnt:hasFrequency rdf:type owl:ObjectProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( TrhOnt:Answer
                                                TrhOnt:DrugIntake
                                              )
                                ] ;
                    rdfs:range TrhOnt:Frequency ;
                    rdfs:comment "To indicate a frequency" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasFunctionalExploration
TrhOnt:hasFunctionalExploration rdf:type owl:ObjectProperty ;
                                rdfs:domain TrhOnt:Answer ;
                                rdfs:range TrhOnt:FunctionalExploration ;
                                rdfs:comment "To indicate a functional exploration" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasFunctionalTest
TrhOnt:hasFunctionalTest rdf:type owl:ObjectProperty ;
                         rdfs:domain TrhOnt:FunctionalExploration ;
                         rdfs:range TrhOnt:FunctionalityTest ;
                         rdfs:comment "To indicate a test used during a functional exploration" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasGender
TrhOnt:hasGender rdf:type owl:ObjectProperty ;
                 rdfs:domain TrhOnt:Answer ;
                 rdfs:range TrhOnt:Gender ;
                 rdfs:comment "To indicate the gender of the patient" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasGoal
TrhOnt:hasGoal rdf:type owl:ObjectProperty ;
               rdfs:domain TrhOnt:Answer ;
               rdfs:range TrhOnt:Goal ;
               rdfs:comment "To indicate a goal to be reached" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasGoalLevel
TrhOnt:hasGoalLevel rdf:type owl:ObjectProperty ;
                    rdfs:domain TrhOnt:Goal ;
                    rdfs:range TrhOnt:GoalLevel ;
                    rdfs:comment "To indicate the level in which a goal wants to be reached" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasIntensity
TrhOnt:hasIntensity rdf:type owl:ObjectProperty ;
                    rdfs:domain TrhOnt:PathologicalCondition ;
                    rdfs:range TrhOnt:Intensity ;
                    rdfs:comment "To indicate an intensity (e.g. pain)" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasLongTermGoal
TrhOnt:hasLongTermGoal rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf TrhOnt:hasGoal ;
                       rdfs:domain TrhOnt:Answer ;
                       rdfs:range TrhOnt:Goal ;
                       rdfs:comment "To indicate a long term goal to be reached" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasMidTermGoal
TrhOnt:hasMidTermGoal rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf TrhOnt:hasGoal ;
                      rdfs:domain TrhOnt:Answer ;
                      rdfs:range TrhOnt:Goal ;
                      rdfs:comment "To indicate a midterm goal to be reached" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasMovementExploration
TrhOnt:hasMovementExploration rdf:type owl:ObjectProperty ;
                              rdfs:domain TrhOnt:Answer ;
                              rdfs:range TrhOnt:MovementExploration ;
                              rdfs:comment "To indicate a movement exploration" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasMuscleStrengthExploration
TrhOnt:hasMuscleStrengthExploration rdf:type owl:ObjectProperty ;
                                    rdfs:domain TrhOnt:Answer ;
                                    rdfs:range TrhOnt:MuscleStrengthExploration ;
                                    rdfs:comment "To indicate a muscle strength exploration" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasMuscleStrengthScale
TrhOnt:hasMuscleStrengthScale rdf:type owl:ObjectProperty ;
                              rdfs:domain TrhOnt:MuscleStrengthExploration ;
                              rdfs:range TrhOnt:MuscleStrengthScale ;
                              rdfs:comment "To indicate the scale used to measuer the muscle strength" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasOrthopedicExploration
TrhOnt:hasOrthopedicExploration rdf:type owl:ObjectProperty ;
                                rdfs:domain TrhOnt:Answer ;
                                rdfs:range TrhOnt:OrthopedicExploration ;
                                rdfs:comment "To indicate an orthopedic exploration" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasOrthopedicTest
TrhOnt:hasOrthopedicTest rdf:type owl:ObjectProperty ;
                         rdfs:domain TrhOnt:OrthopedicExploration ;
                         rdfs:range TrhOnt:OrthopedicTest ;
                         rdfs:comment "To indicate the test used in an orthopedic exploration" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasPastHistory
TrhOnt:hasPastHistory rdf:type owl:ObjectProperty ;
                      rdfs:domain TrhOnt:Answer ;
                      rdfs:range TrhOnt:FamilyOrPersonalPastHistoryItem ;
                      rdfs:comment "To indicate the past medical history of the patient" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasPatient
TrhOnt:hasPatient rdf:type owl:ObjectProperty ;
                  rdfs:domain TrhOnt:FamilyOrPersonalPastHistoryItem ;
                  rdfs:range [ rdf:type owl:Class ;
                               owl:unionOf ( TrhOnt:Relative
                                             <http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#Self.>
                                           )
                             ] ;
                  rdfs:comment "To indicate the patient of a past history item" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasProfession
TrhOnt:hasProfession rdf:type owl:ObjectProperty ;
                     rdfs:domain TrhOnt:Answer ;
                     rdfs:range TrhOnt:Profession ;
                     rdfs:comment "To indicate a profession" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasRecord
TrhOnt:hasRecord rdf:type owl:ObjectProperty ;
                 rdfs:domain TrhOnt:Patient ;
                 rdfs:range TrhOnt:PhysiotherapyRecord ;
                 rdfs:comment "To indicate the record of a patient" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasRisk
TrhOnt:hasRisk rdf:type owl:ObjectProperty ;
               rdfs:domain TrhOnt:Profession ;
               rdfs:range TrhOnt:Risk ;
               rdfs:comment "To indicate the risk of a profession" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasShortTermGoal
TrhOnt:hasShortTermGoal rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf TrhOnt:hasGoal ;
                        rdfs:domain TrhOnt:Answer ;
                        rdfs:range TrhOnt:Goal ;
                        rdfs:comment "To indicate a short term goal to be reached" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasStaticExploration
TrhOnt:hasStaticExploration rdf:type owl:ObjectProperty ;
                            rdfs:domain TrhOnt:Answer ;
                            rdfs:range TrhOnt:StaticExploration ;
                            rdfs:comment "To indicate a static exploration" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasTimespan
TrhOnt:hasTimespan rdf:type owl:ObjectProperty ;
                   rdfs:domain owl:Thing ;
                   rdfs:range TrhOnt:Timespan ;
                   rdfs:comment "To indicate a timespan" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasTreatmentProtocol
TrhOnt:hasTreatmentProtocol rdf:type owl:ObjectProperty ;
                            rdfs:domain TrhOnt:Answer ;
                            rdfs:range KiReSOntFM:TreatmentProtocol ;
                            rdfs:comment "To indicate a treatment protocol" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#hasUnit
TrhOnt:hasUnit rdf:type owl:ObjectProperty ;
               rdfs:domain owl:Thing ;
               rdfs:range TrhOnt:Unit ;
               rdfs:comment "To indicate a unit of measurement" .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#recommended
TrhOnt:recommended rdf:type owl:ObjectProperty ;
                   rdfs:domain TrhOnt:Patient ;
                   rdfs:range KiReSOntFM:Exercise ;
                   rdfs:comment "To indicate the recommended exercises for a patient" .


###  http://purl.org/sig/ont/fma/articulates_with
fma:articulates_with rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf fma:connected_to ;
                     rdf:type owl:SymmetricProperty ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( fma:fma5018
                                                 fma:fma55107
                                                 fma:fma85544
                                               )
                                 ] ;
                     rdfs:range [ rdf:type owl:Class ;
                                  owl:unionOf ( fma:fma5018
                                                fma:fma55107
                                                fma:fma85544
                                              )
                                ] ;
                     fma:FMAID "276393" .


###  http://purl.org/sig/ont/fma/attributed_constitutional_part
fma:attributed_constitutional_part rdf:type owl:ObjectProperty ;
                                   fma:FMAID "85937" .


###  http://purl.org/sig/ont/fma/attributed_part
fma:attributed_part rdf:type owl:ObjectProperty ;
                    fma:FMAID "85853" .


###  http://purl.org/sig/ont/fma/attributed_regional_part
fma:attributed_regional_part rdf:type owl:ObjectProperty ;
                             fma:FMAID "85936" .


###  http://purl.org/sig/ont/fma/connected_to
fma:connected_to rdf:type owl:ObjectProperty ;
                 rdfs:range fma:fma61775 ;
                 fma:FMAID "85924" .


###  http://purl.org/sig/ont/fma/constitutional_part
fma:constitutional_part rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf fma:part ;
                        owl:inverseOf fma:constitutional_part_of ;
                        rdfs:range fma:fma61775 ;
                        fma:FMAID "85925" .


###  http://purl.org/sig/ont/fma/constitutional_part_of
fma:constitutional_part_of rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf fma:part_of ;
                           fma:FMAID "85927" .


###  http://purl.org/sig/ont/fma/continuous_with
fma:continuous_with rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf fma:connected_to ;
                    rdf:type owl:SymmetricProperty ;
                    rdfs:domain fma:fma67165 ;
                    rdfs:range fma:fma67165 ;
                    fma:FMAID "85972" .


###  http://purl.org/sig/ont/fma/direct_constitutional_part
fma:direct_constitutional_part rdf:type owl:ObjectProperty ;
                               owl:propertyChainAxiom ( fma:attributed_constitutional_part
                                                        fma:related_part
                                                      ) .


###  http://purl.org/sig/ont/fma/direct_part
fma:direct_part rdf:type owl:ObjectProperty ;
                owl:propertyChainAxiom ( fma:attributed_part
                                         fma:related_part
                                       ) .


###  http://purl.org/sig/ont/fma/direct_regional_part
fma:direct_regional_part rdf:type owl:ObjectProperty ;
                         owl:propertyChainAxiom ( fma:attributed_regional_part
                                                  fma:related_part
                                                ) .


###  http://purl.org/sig/ont/fma/nerve_supply
fma:nerve_supply rdf:type owl:ObjectProperty ;
                 owl:inverseOf fma:nerve_supply_of ;
                 fma:FMAID "85999" ;
                 fma:slot_synonym "is innervated by" .


###  http://purl.org/sig/ont/fma/nerve_supply_of
fma:nerve_supply_of rdf:type owl:ObjectProperty ;
                    rdfs:range fma:fma67135 ;
                    fma:FMAID "85998" ;
                    fma:slot_synonym "innervates" .


###  http://purl.org/sig/ont/fma/part
fma:part rdf:type owl:ObjectProperty ;
         owl:inverseOf fma:part_of ;
         fma:FMAID "85995" ;
         fma:slot_synonym "unattributed part" .


###  http://purl.org/sig/ont/fma/part_of
fma:part_of rdf:type owl:ObjectProperty ;
