:milligram_per_cubic_metre
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:comment         "Milligram per cubic metre is a unit of density defined as milligram divided by cubic metre."@en;
        rdfs:label           "milligram per kubieke meter"@nl , "milligram per cubic metre"@en;
        :alternative_symbol  "mg·m-3" , "mg m-3";
        :denominator         :cubic_metre;
        :dimension           :density-dimension;
        :longcomment         "Milligram per cubic metre is a unit of density defined as milligram divided by cubic metre. Milligram per cubic metre is a derived unit in the International System of Units.";
        :numerator           :milligram;
        :symbol              "mg/m3" .

:microgram_per_cubic_centimetre
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:comment         "Microram per cubic centimetre is a unit of density defined as microgram divided by cubic centimetre."@en;
