                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Time_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :time-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Time_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "t";
        :unit_of_measure  :terasecond-time , :picosecond-time , :petasecond-time , :nanosecond-time , :millisecond-time , :microsecond-time , :megasecond-time , :kilosecond-time , :hectosecond-time , :gigasecond-time , :femtosecond-time , :exasecond-time , :decisecond-time , :decasecond-time , :centisecond-time , :attosecond-time , :year-tropical , :year-sidereal , :year , :shake , :second-time , :day , :day-sidereal , :gigayear , :hour , :hour-sidereal , :minute-sidereal , :minute-time , :second-sidereal .

:Date   rdf:type          owl:Class , owl:NamedIndividual;
        rdfs:label        "date"@en , "datum"@nl;
        rdfs:subClassOf   :Time;
        :unit_of_measure  :terasecond-time , :picosecond-time , :petasecond-time , :nanosecond-time , :millisecond-time , :microsecond-time , :megasecond-time , :kilosecond-time , :hectosecond-time , :gigasecond-time , :femtosecond-time , :exasecond-time , :decisecond-time , :decasecond-time , :centisecond-time , :attosecond-time , :year-tropical , :second-time , :day , :day-sidereal , :gigayear , :hour , :hour-sidereal , :minute-sidereal , :minute-time , :second-sidereal , :shake , :year , :year-sidereal .

