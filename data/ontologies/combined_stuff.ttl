                                              ]
                                            )
                             ] .

:Capacitance  rdf:type      owl:Class , owl:NamedIndividual;
        rdfs:comment        "Capacitance is the ability to hold electrical charge. It is a derived quantity in the International System of Units. Capacitance is electric charge divided by electric potential."@en;
        rdfs:label          "capacitance"@en , "capaciteit"@nl;
        rdfs:subClassOf     :Quantity;
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :capacitance-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Capacitance_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :capacitance-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Capacitance_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        :alternative_label  "electric capacitance"@en , "electrische capaciteit"@nl;
        :symbol             "C";
        :unit_of_measure    :terafarad , :picofarad , :petafarad , :nanofarad , :millifarad , :microfarad , :megafarad , :kilofarad , :hectofarad , :gigafarad , :femtofarad , :exafarad , :abfarad , :coulomb_per_volt , :farad , :statfarad , :attofarad , :centifarad , :decafarad , :decifarad .

