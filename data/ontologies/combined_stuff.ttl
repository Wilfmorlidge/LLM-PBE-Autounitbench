        :SI_electric_current_dimension_exponent
                2;
        :SI_length_dimension_exponent  -2;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    -1;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    3 .

:Electrical_conductance_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Siemens_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :abmho :ampere_per_volt :mho :siemens :statmho )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Siemens_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :abmho :ampere_per_volt :mho :siemens :statmho )
                                              ]
                                            )
                             ] .

:Electrical_conductance
        rdf:type            owl:Class , owl:NamedIndividual;
        rdfs:comment        "Electrical conductance is a measure of how easily electricity flows along a certain path through an electrical element."@en;
        rdfs:label          "electrical conductance"@en;
        rdfs:subClassOf     :Quantity;
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :electrical_conductance-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Electrical_conductance_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :electrical_conductance-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Electrical_conductance_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        :alternative_label  "conductance"@en , "electric conductance"@en;
        :symbol             "G";
        :unit_of_measure    :terasiemens , :picosiemens , :petasiemens , :nanosiemens , :millisiemens , :microsiemens , :megasiemens , :kilosiemens , :hectosiemens , :gigasiemens , :femtosiemens , :exasiemens , :abmho , :ampere_per_volt , :mho , :siemens , :statmho , :attosiemens , :centisiemens , :decasiemens , :decisiemens .

:Electric_susceptibility
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:comment     "The electric susceptibility of a dielectric material is a measure of how easily it polarises in response to an electric field."@en;
        rdfs:label       "electric susceptibility"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "χ_e" .

:watt_per_ampere  rdf:type   owl:NamedIndividual , :Unit_division;
        rdfs:label           "watt per ampère"@nl , "watt per ampere"@en;
        :alternative_symbol  "W·A-1" , "W A-1";
        :denominator         :ampere;
        :dimension           :electric_potential-dimension;
        :numerator           :watt;
        :symbol              "W/A" .

:volt   rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The volt is a unit of electric potential defined as watt divided by ampere = joule divided by coulomb = newton times metre divided by ampere times second = kilogram times square metre divided by ampere times second to the power 3."@en;
        rdfs:label    "volt"@nl , "volt"@en;
        :definition   :watt_per_ampere;
        :dimension    :electric_potential-dimension;
        :longcomment  "The volt is a unit of electric potential defined as watt divided by ampere = joule divided by coulomb = newton times metre divided by ampere times second = kilogram times square metre divided by ampere times second to the power 3. The volt is a derived unit in the International System of Units.";
        :symbol       "V" .

:statvolt  rdf:type   owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The statvolt is a unit of electric potential defined as 2.997925e2 volt."@en;
        rdfs:label    "statvolt"@nl , "statvolt"@en;
        :definition   :_2.997925e2_volt;
        :dimension    :electric_potential-dimension;
        :symbol       "statV" .

:abvolt  rdf:type     owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The abvolt is a unit of electric potential defined as 1.0e-8 volt."@en;
        rdfs:label    "abvolt"@nl , "abvolt"@en;
        :definition   :_1.0e-8_volt;
        :dimension    :electric_potential-dimension;
        :symbol       "abV" .

:Volt_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :volt;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :volt;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:electric_potential-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "electric potential dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                -1;
        :SI_length_dimension_exponent  2;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    1;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    -3 .

:Electric_potential_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Volt_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :abvolt :statvolt :volt :watt_per_ampere )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Volt_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :abvolt :statvolt :volt :watt_per_ampere )
                                              ]
                                            )
                             ] .

:Electric_potential  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:comment         "Electric potential is the potential energy per unit charge associated with static (time-invariant) electric field."@en;
        rdfs:label           "electric potential"@en , "electrische potentiaal"@nl;
        rdfs:subClassOf      :Quantity;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :electric_potential-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Electric_potential_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :electric_potential-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Electric_potential_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        :alternative_label   "voltage"@en , "voltage"@nl;
        :alternative_symbol  "φ";
        :symbol              "V";
        :unit_of_measure     :teravolt , :picovolt , :petavolt , :nanovolt , :millivolt , :microvolt , :megavolt , :kilovolt , :hectovolt , :gigavolt , :femtovolt , :exavolt , :decivolt , :abvolt , :statvolt , :volt , :watt_per_ampere , :attovolt , :centivolt , :decavolt .

