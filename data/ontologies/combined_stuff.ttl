        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "coulomb per kubieke meter"@nl , "coulomb per cubic metre"@en;
        :alternative_symbol  "C·m-3" , "C m-3";
        :denominator         :cubic_metre;
        :dimension           :electric_charge_density-dimension;
        :numerator           :coulomb;
        :symbol              "C/m3" .

:electric_charge_density-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "electric charge density dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                1;
        :SI_length_dimension_exponent  -3;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    1 .

:Electric_charge_density_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :coulomb_per_cubic_metre )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :coulomb_per_cubic_metre )
                             ] .

:Electric_charge_density
        rdf:type            owl:NamedIndividual , owl:Class;
        rdfs:comment        "Electric charge density is the amount of electric charge in a volume. It is a derived quantity in the International System of Units. Electric charge density is electric charge divided by volume."@en;
        rdfs:label          "electric charge density"@en;
        rdfs:subClassOf     :Quantity;
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :electric_charge_density-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Electric_charge_density_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :electric_charge_density-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Electric_charge_density_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        :alternative_label  "charge density"@en;
        :unit_of_measure    :coulomb_per_cubic_metre .

:electric_charge-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "electric charge dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                1;
        :SI_length_dimension_exponent  0;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    1 .

:Electric_charge_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Coulomb_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :abcoulomb :coulomb :faraday :franklin :second-time_ampere :statcoulomb )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Coulomb_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :abcoulomb :coulomb :faraday :franklin :second-time_ampere :statcoulomb )
                                              ]
                                            )
                             ] .

:Electric_charge  rdf:type   owl:Class , owl:NamedIndividual;
        rdfs:comment         "Electric charge is a conserved property of some subatomic particles, which determines their electromagnetic interaction. It is a derived quantity in the International System of Units. Electric charge is electric current times time."@en;
        rdfs:label           "electric charge"@en , "electrische lading"@nl;
        rdfs:subClassOf      :Quantity;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :electric_charge-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Electric_charge_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :electric_charge-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Electric_charge_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        :alternative_label   "lading"@nl , "quantity of electricity"@en;
        :alternative_symbol  "q";
        :symbol              "Q";
        :unit_of_measure     :teracoulomb , :picocoulomb , :petacoulomb , :nanocoulomb , :millicoulomb , :microcoulomb , :megacoulomb , :kilocoulomb , :hectocoulomb , :gigacoulomb , :femtocoulomb , :exacoulomb , :decicoulomb , :decacoulomb , :centicoulomb , :coulomb , :abcoulomb , :faraday , :franklin , :second-time_ampere , :statcoulomb , :attocoulomb .

:Elasticity_tensor  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:label          "elasticiteitstensor"@nl , "elasticity tensor"@en;
        rdfs:subClassOf     :Dynamic_modulus;
        :alternative_label  "stiffness tensor"@en;
        :symbol             "c_ijkl";
        :unit_of_measure    :terapascal , :picopascal , :petapascal , :nanopascal , :millipascal , :micropascal , :megapascal , :kilopascal , :hectopascal , :gigapascal , :femtopascal , :exapascal , :decipascal , :decapascal , :centipascal , :attopascal , :torr , :newton_per_square_metre , :millimetre_of_mercury , :millibar , :pascal , :atmosphere-standard , :atmosphere-technical , :bar , :barye , :centimetre_of_mercury , :decibar , :kilogram_second-time_to_the_power_-2_reciprocal_metre , :metre_of_mercury , :microbar .

:Einstein_temperature
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "Einstein temperature"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "Θ_E" .

:Egg_mass_fraction  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "The fraction of the mass of egg in a phenomenon"@en;
        rdfs:label        "egg mass fraction"@en;
        rdfs:subClassOf   :Mass_fraction;
        :unit_of_measure  :gram_per_gram , :percent , :one .

:Effective_mass  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "effective mass"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "m*" .

:Ecliptic_longitude  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "The angular distance on the celestial sphere measured clockwise from the vernal equinox along the ecliptic (the path of the Sun on the celestial sphere during one year) to the intersection with the great circle drawn from the ecliptical north pole through the object."@en;
        rdfs:label        "ecliptic longitude"@en;
        rdfs:subClassOf   :Plane_angle;
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/chapter13_Astronomical_Algorithms>;
        :symbol           "λ";
        :unit_of_measure  :second-plane_angle , :minute-plane_angle , :degree .

:Ecliptic_latitude  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "The angular distance on the celestial sphere north or south of the ecliptic (the path of the Sun on the celestial sphere during one year). It is measured along the great circle passing through the object and the ecliptic poles and perpendicular to the ecliptic."@en;
        rdfs:label        "ecliptic latitude"@en;
        rdfs:subClassOf   :Plane_angle;
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/chapter13_Astronomical_Algorithms>;
        :symbol           "β";
        :unit_of_measure  :second-plane_angle , :minute-plane_angle , :degree .

:Eccentricity  rdf:type   owl:NamedIndividual , owl:Class;
        rdfs:comment      "A measure of the deviation from a circle for an orbit."@en;
        rdfs:label        "eccentricity"@en , "eccentriciteit"@nl;
        rdfs:subClassOf   :Quantity_of_dimension_one;
        :symbol           "e";
        :unit_of_measure  :one .

:poise  rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The poise is a unit of dynamic viscosity defined as 1.0e-1 pascal second (time)."@en;
        rdfs:label    "poise"@nl , "poise"@en;
        :definition   :_1.0e-1_pascal_second-time;
        :dimension    :dynamic_viscosity-dimension;
        :symbol       "P" .

:pascal_second-time  rdf:type  owl:NamedIndividual , :Unit_multiplication;
        rdfs:label           "pascal seconde"@nl , "pascal second"@en;
        :alternative_symbol  "Pa·s";
        :dimension           :dynamic_viscosity-dimension;
        :symbol              "Pa s";
        :term_1              :pascal;
        :term_2              :second-time .

