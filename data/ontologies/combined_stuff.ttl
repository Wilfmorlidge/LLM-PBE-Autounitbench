:metre_per_second-time_squared
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:comment         "Metre per second squared is a unit of acceleration defined as metre divided by second squared."@en;
        rdfs:label           "metre per second squared"@en , "meter per seconde kwadraat"@nl;
        :alternative_symbol  "m·s-2" , "m s-2";
        :denominator         :second-time_squared;
        :dimension           :acceleration-dimension;
        :longcomment         "Metre per second squared is a unit of acceleration defined as metre divided by second squared. Metre per second squared is a derived unit in the International System of Units.";
        :numerator           :metre;
        :symbol              "m/s2" .

:gal    rdf:type            owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The gal is a unit of acceleration defined as centimetre per second (time) squared."@en;
        rdfs:label          "gal"@nl , "gal"@en;
        :alternative_label  "galileo"@nl , "galileo"@en;
        :definition         :centimetre_per_second-time_squared;
        :dimension          :acceleration-dimension;
        :symbol             "Gal" .

:Metre_per_second-time_multiple_or_submultiple_squared
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_division;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :Second-time_multiple_or_submultiple_squared;
                                                       owl:onProperty     :denominator
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :metre;
                                                       owl:onProperty  :numerator
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :denominator
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :numerator
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :Second-time_multiple_or_submultiple_squared;
                                                       owl:onProperty     :denominator
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :metre;
                                                       owl:onProperty  :numerator
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :denominator
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :numerator
                                                     ]
                                                   )
                             ] .

:Metre_multiple_or_submultiple_per_second-time_squared
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_division;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :Metre_multiple_or_submultiple;
                                                       owl:onProperty     :numerator
                                                     ]
