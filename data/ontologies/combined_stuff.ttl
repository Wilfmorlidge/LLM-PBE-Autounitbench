:Thermodynamic_temperature
        rdf:type            owl:Class , owl:NamedIndividual;
        rdfs:comment        "Thermodynamic temperature is the absolute measure of temperature. Its zero point is the temperature at which the particle constituents of matter have minimal motion and can be no colder. Thermodynamic temperature is a base quantity in the International System of Units."@en;
        rdfs:label          "absolute temperatuur"@nl , "thermodynamic temperature"@en;
        rdfs:subClassOf     :Temperature;
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :Kelvin_scale;
                              owl:onProperty  :measurement_scale
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  [ rdf:type     owl:Class;
                                                                        owl:unionOf  ( :Thermodynamic_temperature_scale :Thermodynamic_temperature_unit )
                                                                      ];
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :Kelvin_scale;
                              owl:onProperty  :measurement_scale
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  [ rdf:type     owl:Class;
                                                                        owl:unionOf  ( :Thermodynamic_temperature_scale :Thermodynamic_temperature_unit )
                                                                      ];
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        :alternative_label  "thermodynamische temperatuur"@nl;
        :symbol             "T";
        :unit_of_measure    :terakelvin , :picokelvin , :petakelvin , :nanokelvin , :millikelvin , :microkelvin , :megakelvin , :kilokelvin , :kelvin , :attokelvin , :centikelvin , :decakelvin , :decikelvin , :exakelvin , :femtokelvin , :gigakelvin , :hectokelvin .

:Brightness_temperature
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "The temperature that a blackbody would need to have in order to emit radiation of the observed intensity at a given wavelength (mostly used in radio astronomy)."@en;
        rdfs:label        "brightness temperature"@en;
        rdfs:subClassOf   :Thermodynamic_temperature;
        :unit_of_measure  :kelvin .

:Length  rdf:type            owl:Class , owl:NamedIndividual;
        rdfs:comment         "Length is the amount of space between two geographical points along a curve. It is a base quantity in the International System of Units and other systems of units. Length is speed times time. The metre, a base unit of length in the International System of Units, is defined in terms of speed of light during a certain time interval."@en;
        rdfs:label           "lengte"@nl , "length"@en , "长度"@zh;
        rdfs:subClassOf      :Quantity;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :length-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Length_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :length-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Length_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        :alternative_symbol  "L";
        :symbol              "l";
        :unit_of_measure     :terametre , :picometre , :petametre , :nanometre , :millimetre , :micrometre , :megametre , :kilometre , :hectometre , :gigametre , :femtometre , :exametre , :decimetre , :decametre , :centimetre , :attometre , :yard-international , :solar_radius , :rod-US , :parsec , :nautical_mile-international , :mile-statute , :mile-US_survey , :mil-length , :micron , :metre , :megaparsec , :light_year , :kiloparsec , :inch-international , :gigaparsec , :furlong-international , :foot-international , :foot-US_survey , :fermi , :fathom-US_survey , :chain , :astronomical_unit , :angstrom , :cicero , :pica-ATA , :pica-Postscript , :pica-TeX , :point-ATA , :point-Didot , :point-Postscript , :point-TeX;
        :vectorial_or_tensorial_character
                :scalar .

