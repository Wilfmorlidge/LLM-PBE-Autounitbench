        :symbol              "ν_coll";
        :unit_of_measure     :terahertz , :picohertz , :petahertz , :nanohertz , :millihertz , :microhertz , :megahertz , :kilohertz , :hectohertz , :gigahertz , :femtohertz , :exahertz , :reciprocal_second-time , :hertz , :reciprocal_day , :reciprocal_hour , :reciprocal_minute-time , :reciprocal_year , :attohertz , :centihertz , :decahertz , :decihertz .

