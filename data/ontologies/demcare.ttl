    owl:onProperty time:seconds ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ], [
    a owl:Restriction ;
    owl:onProperty time:weeks ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ], [
    a owl:Restriction ;
    owl:onProperty time:years ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
  ] .

time:Instant
  a owl:Class ;
  rdfs:subClassOf time:TemporalEntity ;
  owl:disjointWith time:ProperInterval .

time:Interval
  a owl:Class ;
  rdfs:subClassOf time:TemporalEntity .

time:January
  a owl:Class ;
  rdfs:subClassOf time:DateTimeDescription, [
    a owl:Restriction ;
    owl:onProperty time:unitType ;
    owl:hasValue time:unitMonth
  ], [
    a owl:Restriction ;
    owl:onProperty time:month ;
    owl:hasValue "--01"^^xsd:gMonth
  ] .

time:ProperInterval
  a owl:Class ;
  rdfs:subClassOf time:Interval .

time:TemporalEntity
  a owl:Class ;
  owl:equivalentClass [
    a owl:Class ;
    owl:unionOf (
     time:Instant
     time:Interval
   )
  ] .

time:TemporalUnit
  a owl:Class ;
  owl:equivalentClass [
    a owl:Class ;
    owl:oneOf (
     time:unitDay
     time:unitHour
     time:unitMinute
     time:unitMonth
     time:unitSecond
     time:unitWeek
     time:unitYear
   )
  ] .

time:Year
  a owl:Class ;
  rdfs:subClassOf time:DurationDescription, [
    a owl:Restriction ;
    owl:onProperty time:days ;
    owl:cardinality "0"^^xsd:nonNegativeInteger
  ], [
    a owl:Restriction ;
    owl:onProperty time:hours ;
    owl:cardinality "0"^^xsd:nonNegativeInteger
  ], [
    a owl:Restriction ;
    owl:onProperty time:minutes ;
    owl:cardinality "0"^^xsd:nonNegativeInteger
  ], [
