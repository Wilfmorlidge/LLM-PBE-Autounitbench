<http://www.demcare.eu/ontologies/combined.owl#Entity> a owl:Class .
<http://www.demcare.eu/ontologies/combined.owl#Event>
  a owl:Class ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#duration> ;
    owl:allValuesFrom time:DurationDescription
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#startTime> ;
    owl:allValuesFrom time:Instant
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#duration> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass time:DurationDescription
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#startTime> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass time:Instant
  ] .

