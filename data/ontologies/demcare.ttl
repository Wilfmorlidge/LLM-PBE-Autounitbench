<http://www.demcare.eu/ontologies/combined.owl#Nocturia>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#InterruptedSleepProblem> ;
  rdfs:comment "If the individual visits the bathroom more than twice during the night" .

<http://www.demcare.eu/ontologies/combined.owl#PeriodicLimbMovement>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#SleepProblem> .

<http://www.demcare.eu/ontologies/combined.owl#Problem>
  a owl:Class ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#possibleContributingFactor> ;
    owl:someValuesFrom <http://www.demcare.eu/ontologies/combined.owl#Event>
  ] .

<http://www.demcare.eu/ontologies/combined.owl#Questionnaire> a owl:Class .
<http://www.demcare.eu/ontologies/combined.owl#SelfReportedLowMood>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#MoodProblem> .

<http://www.demcare.eu/ontologies/combined.owl#ShortStrideLength>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#ExerciseProblem> .

<http://www.demcare.eu/ontologies/combined.owl#SleepDurationProblem>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#SleepProblem> ;
  rdfs:comment "Sleep duration is less than 7 hours. " .

<http://www.demcare.eu/ontologies/combined.owl#SleepEfficiencyProblem>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#SleepProblem> ;
  rdfs:comment "Sleep efficiency is less than 85%." .

<http://www.demcare.eu/ontologies/combined.owl#SleepLatencyProblem>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#SleepProblem> ;
  rdfs:comment "Sleep latency over 30 minutes." .

<http://www.demcare.eu/ontologies/combined.owl#SleepProblem>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#Problem> .

<http://www.demcare.eu/ontologies/combined.owl#SleepQuestionnaire>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#Questionnaire> .

<http://www.demcare.eu/ontologies/combined.owl#SleepSummary>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#DaySummary>, [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#duration> ;
    owl:allValuesFrom xsd:int
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#lightLevel> ;
    owl:allValuesFrom xsd:string
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#numberOfArousals> ;
    owl:allValuesFrom xsd:int
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#numberOfAwakenings> ;
    owl:allValuesFrom xsd:int
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#numberOfBedExits> ;
    owl:allValuesFrom xsd:int
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#numberOfNaps> ;
    owl:allValuesFrom xsd:int
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#sleepBedTime> ;
    owl:allValuesFrom xsd:dateTime
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#sleepEfficiency> ;
    owl:allValuesFrom xsd:double
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#sleepLatency> ;
    owl:allValuesFrom xsd:int
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#sleepMovementIndex> ;
    owl:allValuesFrom xsd:double
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#sleepTime> ;
    owl:allValuesFrom xsd:dateTime
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#totalDurationOfNaps> ;
    owl:allValuesFrom xsd:int
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#wakeUpTime> ;
    owl:allValuesFrom xsd:dateTime
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#duration> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:int
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#lightLevel> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:string
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#numberOfArousals> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:int
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#numberOfAwakenings> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:int
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#numberOfBedExits> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:int
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#numberOfNaps> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:int
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#sleepBedTime> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:dateTime
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#sleepEfficiency> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:double
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#sleepLatency> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:int
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#sleepMovementIndex> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:double
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#sleepTime> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:dateTime
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#totalDurationOfNaps> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:int
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#wakeUpTime> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:dateTime
  ] .

<http://www.demcare.eu/ontologies/combined.owl#SlowWalkSpeed>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#ExerciseProblem> .

<http://www.demcare.eu/ontologies/combined.owl#SocialProblem>
