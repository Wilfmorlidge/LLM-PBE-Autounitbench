:Linear_expansion_coefficient
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "linear expansion coefficient"@en , "lineaire uitzettingscoëfficiënt"@nl;
        rdfs:subClassOf  :Quantity;
        :symbol          "α_l" .

:Linear_charge_density
        rdf:type         owl:Class;
        rdfs:label       "linear charge density"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "ρ" .

:Linear_attenuation_coefficient
        rdf:type             owl:NamedIndividual , owl:Class;
        rdfs:label           "linear attenuation coefficient"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_symbol  "μ_l";
        :symbol              "μ" .

:Linear_absorption_coefficient
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "linear absorption coefficient"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "a" .

:Limiting_magnitude  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "The magnitude of the faintest object (star) that can be detected by a telescope or other instrument. Depends not only on the telescope but also on the detector and on the observing method."@en;
        rdfs:label        "limiting magnitude"@en;
        rdfs:subClassOf   :Magnitude;
        :unit_of_measure  :magnitude .

:Light_time  rdf:type     owl:NamedIndividual , owl:Class;
        rdfs:comment      "The time electromagnetic radiation takes to reach Earth from a distant source. Often the correction in light time is needed to accurately calculate the apparent position of solar system objects or to calculate the period of variable stars (different times are observed when the Earth is at a different position in its orbit)."@en;
        rdfs:label        "light time"@en;
        rdfs:subClassOf   :Time;
        :symbol           "τ";
        :unit_of_measure  :second-time .

:Lewis_number_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :one )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :one )
                             ] .

:Lewis_number  rdf:type   owl:NamedIndividual , owl:Class;
        rdfs:comment      "The Lewis number is a dimensionless number defined as the ratio of thermal diffusivity to mass diffusivity."@en;
        rdfs:label        "getal van Lewis"@nl , "Lewis number"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Lewis_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Lewis_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "Le";
        :unit_of_measure  :one .

:Level_width  rdf:type   owl:NamedIndividual , owl:Class;
        rdfs:label       "level width"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "Γ" .

:yard-international  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The international yard is a unit of length defined as 9.144e-1 metre."@en;
        rdfs:label          "码（国际）"@zh , "yard (internationa)"@en;
        :alternative_label  "international yard"@en;
        :definition         :_9.144e-1_metre;
        :dimension          :length-dimension;
        :symbol             "yd" .

:solar_radius  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment   "Solar radius is a unit used in astronomy to denote stellar or stellar system radii ("@en;
        rdfs:label     "solar radius"@en;
        :LaTeX_symbol  "R_{\\astrosun}";
        :definition    :_6.955e8_metre;
        :dimension     :length-dimension;
        :symbol        "R_☉" .

:rod-US  rdf:type           owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The US rod is a unit of length defined as 5.029210 metre."@en;
        rdfs:label          "rod (US)"@en;
        :alternative_label  "pole"@en , "perch"@en , "US rod"@en;
        :definition         :_5.029210_metre;
        :dimension          :length-dimension;
        :symbol             "rd" .

:parsec  rdf:type     owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The parsec is a unit of length defined as 3.08567758149137e16 metre."@en;
        rdfs:label    "parsec"@en;
        :definition   :_3.08567758149137e16_metre;
        :dimension    :length-dimension;
        :symbol       "pc" .

:nautical_mile-international
        rdf:type             owl:NamedIndividual , :Singular_unit;
        rdfs:comment         "The international nautical mile is a unit of length defined as 1852 metre."@en;
        rdfs:label           "海里（国际）"@zh , "zeemijl (internationaal)"@nl , "nautical mile (international)"@en;
        :alternative_label   "international nautical mile"@en;
        :alternative_symbol  "NM" , "nm" , "M";
        :definition          :_1852_metre;
        :dimension           :length-dimension;
        :symbol              "nmi" .

:mile-statute  rdf:type     owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The statute mile is a unit of length defined as 1.609344e3 metre."@en;
        rdfs:label          "mile (statute)"@en;
        :alternative_label  "statute mile"@en;
        :definition         :_1.609344e3_metre;
        :dimension          :length-dimension;
        :symbol             "mi" .

:mile-US_survey  rdf:type   owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The US survey mile is a unit of length defined as 1.609347e3 metre."@en;
        rdfs:label          "mile (US survey)"@en;
        :alternative_label  "US survey mile"@en;
        :definition         :_1.609347e3_metre;
        :dimension          :length-dimension .

:mil-length  rdf:type       owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The mil (length) is a unit of length defined as 2.54e-5 metre."@en;
        rdfs:label          "mil (length)"@en;
        :alternative_label  "thou"@en;
        :definition         :_2.54e-5_metre;
        :dimension          :length-dimension .

:micron  rdf:type     owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The micron is a unit of length defined as 1.0e-6 metre."@en;
        rdfs:label    "micron"@nl , "micron"@en;
        :definition   :_1.0e-6_metre;
        :dimension    :length-dimension;
        :symbol       "μ" .

:metre  rdf:type            owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The metre is a unit of length defined as the length of the path travelled by light in vacuum during a time interval of 1/299 792 458 of a second."@en;
        rdfs:label          "米"@zh , "metre"@en , "meter"@nl;
        :alternative_label  "meter"@en;
        :definition         :length_of_the_path_travelled_by_light_in_vacuum_during_a_time_interval_of_1_299_792_458_of_a_second;
        :dimension          :length-dimension;
        :longcomment        "The metre is a unit of length defined as the length of the path travelled by light in vacuum during a time interval of 1/299 792 458 of a second. The metre is a base unit in the International System of Units.";
        :symbol             "m" .

:megaparsec  rdf:type   owl:NamedIndividual , :Unit_multiple_or_submultiple;
        rdfs:comment    "The megaparsec is a unit of length defined as 1.0e6 parsec. Gebruikt voor afstanden op de schaal van clusters."@en;
        rdfs:label      "megaparsec"@nl , "megaparsec"@en;
        :dimension      :length-dimension;
        :prefix         :mega;
        :singular_unit  :parsec;
        :symbol         "Mpc" .

:light_year  rdf:type       owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The light year is a unit of length defined as 9.46073e15 metre."@en;
        rdfs:label          "light year"@en , "lichtjaar"@nl;
        :alternative_label  "lightyear"@en;
        :definition         :_9.46073e15_metre;
        :dimension          :length-dimension;
        :symbol             "ly" .

:kiloparsec  rdf:type   owl:NamedIndividual , :Unit_multiple_or_submultiple;
        rdfs:comment    "The kiloparsec is a unit of length defined as 1.0e3 parsec. Gebruikt voor afstanden op de schaal van het melkwegstelsel."@en;
        rdfs:label      "kiloparsec"@nl , "kiloparsec"@en;
        :dimension      :length-dimension;
        :prefix         :kilo;
        :singular_unit  :parsec;
        :symbol         "kpc" .

:inch-international  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The international inch is a unit of length defined as 2.54e-2 metre."@en;
        rdfs:label          "英寸（国际）"@zh , "inch (international)"@en;
        :alternative_label  "international inch"@en;
        :definition         :_2.54e-2_metre;
        :dimension          :length-dimension;
        :symbol             "in" .

:gigaparsec  rdf:type   owl:NamedIndividual , :Unit_multiple_or_submultiple;
        rdfs:comment    "The gigaparsec is a unit of length defined as 1.0e9 parsec. Gebruikt voor de afstand op de schaal van het heelal."@en;
        rdfs:label      "gigaparsec"@nl , "gigaparsec"@en;
        :dimension      :length-dimension;
        :prefix         :giga;
        :singular_unit  :parsec;
        :symbol         "Gpc" .

:furlong-international
        rdf:type            owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The international furlong is a unit of length defined as 201.168 metre."@en;
        rdfs:label          "furlong (international)"@en;
        :alternative_label  "international furlong"@en;
        :definition         :_201.168_metre;
        :dimension          :length-dimension .

:foot-international  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment       "The international foot is a unit of length defined as 3.048e-1 metre."@en;
        rdfs:label         "英尺（国际）"@zh , "foot (international)"@en;
        :alternativeLabel  "international foot"@en;
        :definition        :_3.048e-1_metre;
        :dimension         :length-dimension;
        :symbol            "ft" .

:foot-US_survey  rdf:type   owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The US survey foot is a unit of length defined as 3.048006e-1 metre."@en;
        rdfs:label          "foot (US survey)"@en;
        :alternative_label  "US survey foot"@en;
        :definition         :_3.048006e-1_metre;
        :dimension          :length-dimension;
        :symbol             "ft" .

:fermi  rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The fermi is a unit of length defined as 1.0e-15 metre."@en;
        rdfs:label    "fermi"@nl , "fermi"@en;
        :definition   :_1.0e-15_metre;
        :dimension    :length-dimension .

:fathom-US_survey  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The US survey fathom is a unit of length defined as 1.828804 metre."@en;
        rdfs:label          "fathom (US survey)"@en;
        :alternative_label  "US survey fathom"@en;
        :definition         :_1.828804_metre;
        :dimension          :length-dimension .

:chain  rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The chain is a unit of length defined as 2.011684e1 metre."@en;
        rdfs:label    "chain"@en;
        :definition   :_2.011684e1_metre;
        :dimension    :length-dimension;
        :symbol       "ch" .

:astronomical_unit  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The atronomical unit is a unit of length defined as 149 597 870 700 metre (IAU 2012 Resolution)."@en;
        rdfs:label    "astronomical unit"@en;
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/IAU_2012_Resolution_B2>;
        :definition   :_1.495978707e11_metre;
        :dimension    :length-dimension;
        :symbol       "AU" .

:angstrom  rdf:type         owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The ångström is a unit of length defined as 1.0e-10 metre. The unit is often used for wavelengths of electromagnetic radiation or to express the sizes of atoms and molecules."@en;
        rdfs:label          "ångström"@nl , "ångström"@en;
        :alternative_label  "angstrom"@nl , "angstrom"@en;
        :definition         :_1.0e-10_metre;
        :dimension          :length-dimension;
        :symbol             "Å" .

:length-dimension  rdf:type            owl:NamedIndividual , :Dimension;
        rdfs:label                     "length dimension"@en , "lengtedimensie"@nl;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  1;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    0;
        :symbol                        "L" .

:Lattice_vector  rdf:type    owl:NamedIndividual , owl:Class;
        rdfs:label           "lattice vector"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_label   "lattice vector: a translation vector which maps the crystal lattice onto itself"@en;
        :alternative_symbol  "R_0";
        :symbol              "R" .

:Lattice_plane_spacing
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "lattice plane spacing"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "d" .

:Larmor_circular_frequency
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "Larmor circular frequency"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "ω_L" .

:Landau-Ginzburg_parameter
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "Landau-Ginzburg parameter"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "κ" .

:Lame_coefficients_for_an_isotropic_medium
        rdf:type             owl:NamedIndividual , owl:Class;
        rdfs:label           "Lamé-coëfficienten voor een isotropisch medium"@nl , "Lamé coefficients for an isotropic medium"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_symbol  "μ";
        :symbol              "λ" .

:Lagrangian_function  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label          "Lagrangian function"@en , "Lagrangiaan"@nl;
        rdfs:subClassOf     :Quantity;
        :alternative_label  "Lagrangian"@en;
        :symbol             "L" .

:Lactose_mass_fraction
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "The fraction of the mass of lactose in a phenomenon"@en;
        rdfs:label        "lactose mass fraction"@en;
        rdfs:subClassOf   :Mass_fraction;
        :unit_of_measure  :gram_per_gram , :percent , :one .

:Knudsen_number_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :one )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :one )
                             ] .

:Knudsen_number  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "The Knudsen number is a dimensionless number defined as the ratio of the molecular mean free path length to a representative physical length scale."@en;
        rdfs:label        "getal van Knudsen"@nl , "Knudsen number"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Knudsen_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Knudsen_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "Kn";
        :unit_of_measure  :one .

:Kinetic_energy  rdf:type    owl:Class , owl:NamedIndividual;
        rdfs:comment         "Kinetic energy is energy due to motion."@en;
        rdfs:label           "kinetic energy"@en , "kinetische energie"@nl , "动能"@zh;
        rdfs:subClassOf      :Energy;
        :alternative_label   "bewegingsenergie"@nl;
        :alternative_symbol  "K" , "T";
        :symbol              "E_k";
        :unit_of_measure     :terajoule , :picojoule , :petajoule , :nanojoule , :millijoule , :microjoule , :megajoule , :megaerg , :kilojoule , :kilocalorie-mean , :hectojoule , :gigajoule , :femtojoule , :exajoule , :decijoule , :decajoule , :centijoule , :attojoule , :ton_of_TNT , :therm-US , :therm-EC , :terawatt_hour , :quad , :newton_metre , :millinewton_metre , :micronewton_metre , :megaelectronvolt , :kilowatt_hour , :kiloelectronvolt , :joule , :gigaelectronvolt , :foot_poundal , :erg , :calorie-thermochemical , :calorie-International_Table , :calorie-20_C , :calorie-15_C , :British_thermal_unit-thermochemical , :British_thermal_unit-mean , :calorie-mean , :electronvolt , :British_thermal_unit-39_F , :British_thermal_unit-59_F , :British_thermal_unit-60_F , :British_thermal_unit-International_Table .

:stokes  rdf:type     owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The stokes is a unit of kinematic viscosity defined as 1.0e-4 square metre per second (time)."@en;
        rdfs:label    "stokes"@nl , "stokes"@en;
        :definition   :_1.0e-4_square_metre_per_second-time;
        :dimension    :kinematic_viscosity-dimension;
        :symbol       "St" .

:square_metre_per_second-time
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "vierkante meter per seconde"@nl , "square metre per second"@en;
        :alternative_symbol  "m2·s-1" , "m2 s-1";
        :denominator         :second-time;
        :dimension           :kinematic_viscosity-dimension;
        :numerator           :square_metre;
        :symbol              "m2/s" .

:Stokes_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :stokes;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :stokes;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:kinematic_viscosity-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "kinematic viscosity dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  2;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    -1 .

:Kinematic_viscosity_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Stokes_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :square_metre_per_second-time :stokes )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Stokes_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :square_metre_per_second-time :stokes )
                                              ]
                                            )
                             ] .

:Kinematic_viscosity  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment       "Kinematic viscosity is the ratio of viscosity to density."@en;
        rdfs:label         "kinematische viscositeit"@nl , "kinematic viscosity"@en;
        rdfs:subClassOf    :Quantity;
        rdfs:subClassOf    [ rdf:type        owl:Restriction;
                             owl:hasValue    :kinematic_viscosity-dimension;
                             owl:onProperty  :dimension
                           ];
        rdfs:subClassOf    [ rdf:type           owl:Restriction;
                             owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                  owl:allValuesFrom  :Kinematic_viscosity_unit;
                                                  owl:onProperty     :unit_of_measure_or_measurement_scale
                                                ];
                             owl:onProperty     :value
                           ];
        rdfs:subClassOf    [ rdf:type        owl:Restriction;
                             owl:hasValue    :kinematic_viscosity-dimension;
                             owl:onProperty  :dimension
                           ];
        rdfs:subClassOf    [ rdf:type           owl:Restriction;
                             owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                  owl:allValuesFrom  :Kinematic_viscosity_unit;
                                                  owl:onProperty     :unit_of_measure_or_measurement_scale
                                                ];
                             owl:onProperty     :value
                           ];
        :symbol            "ν";
        :unit_of_measure   :centistokes , :stokes , :square_metre_per_second-time;
        :unofficial_label  "viscosity" .

:Kerma  rdf:type          owl:Class , owl:NamedIndividual;
        rdfs:label        "kerma"@en;
        rdfs:subClassOf   :Absorbed_dose;
        :unit_of_measure  :teragray , :picogray , :petagray , :nanogray , :milligray , :microgray , :gray , :joule_per_kilogram , :rad , :attogray , :centigray , :decagray , :decigray , :exagray , :femtogray , :gigagray , :hectogray , :kilogray , :megagray .

:Thermodynamic_temperature_scale
        rdf:type         owl:Class;
        rdfs:subClassOf  :Measurement_scale .

:Kelvin_scale  rdf:type      owl:Class , :Ratio_scale , owl:NamedIndividual;
        rdfs:label           "Kelvin scale"@en , "Kelvinschaal"@nl , "开氏温标"@zh;
        owl:equivalentClass  :Thermodynamic_temperature_scale;
        :alternative_label   "International Kelvin Temperature scale of 1990"@en;
        :dimension           :thermodynamic_temperature-dimension;
        :element             :_approximately_20_3_on_the_Kelvin_scale , :_approximately_17_on_the_Kelvin_scale , :_933_473_on_the_Kelvin_scale , :_83_8058_on_the_Kelvin_scale , :_692_677_on_the_Kelvin_scale , :_54_3584_on_the_Kelvin_scale , :_505_078_on_the_Kelvin_scale , :_429_7485_on_the_Kelvin_scale , :_3_to_5_on_the_Kelvin_scale , :_1234_93_on_the_Kelvin_scale , :_1337_33_on_the_Kelvin_scale , :_1357_77_on_the_Kelvin_scale , :_13_8033_on_the_Kelvin_scale , :_234_3156_on_the_Kelvin_scale , :_24_5561_on_the_Kelvin_scale , :_273_16_on_the_Kelvin_scale , :_302_9146_on_the_Kelvin_scale;
        :unit_of_measure     :kelvin .

:kelvin  rdf:type     owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The kelvin is a unit of temperature defined as 1/273.16 of the thermodynamic temperature of the triple point of water."@en;
        rdfs:label    "开"@zh , "kelvin"@nl , "kelvin"@en;
        :definition   :_1_273_16_of_the_thermodynamic_temperature_of_the_triple_point_of_water;
        :dimension    :thermodynamic_temperature-dimension;
        :longcomment  "The kelvin is a unit of temperature defined as 1/273.16 of the thermodynamic temperature of the triple point of water. The kelvin is a base unit in the International System of Units.";
        :symbol       "K" .

:Kelvin_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :kelvin;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :kelvin;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:Joule-Thomson_coefficient
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "Joule-Thomson-coëfficiënt"@nl , "Joule-Thomson coefficient"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "μ" .

:Jeans_mass  rdf:type     owl:NamedIndividual , owl:Class;
        rdfs:comment      "The critical mass of a molecular cloud, above which it will be unstable to collapse."@en;
        rdfs:label        "Jeans mass"@en;
        rdfs:subClassOf   :Mass;
        :symbol           "M_J";
        :unit_of_measure  :kilogram , :solar_mass .

:Isentropic_exponent  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "isentropische exponent"@nl , "isentropic exponent"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "κ" .

:Irradiance  rdf:type        owl:NamedIndividual , owl:Class;
        rdfs:comment         "Irradiance is the power of electromagnetic radiation at a surface per unit area."@en;
        rdfs:label           "irradiance"@en;
        rdfs:subClassOf      :Power_density;
        :alternative_symbol  "E_e";
        :symbol              "E";
        :unit_of_measure     :watt_per_square_metre .

:Ionization_frequency
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "ionization frequency"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "ν_i" .

:Ionization_energy  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:label          "ionizatie-energie"@nl , "ionization energy"@en;
        rdfs:subClassOf     :Energy;
        :alternative_label  "electron ionization energy"@en;
        :symbol             "E_i";
        :unit_of_measure    :terajoule , :picojoule , :petajoule , :nanojoule , :millijoule , :microjoule , :megajoule , :megaerg , :kilojoule , :kilocalorie-mean , :hectojoule , :gigajoule , :femtojoule , :exajoule , :decijoule , :decajoule , :centijoule , :attojoule , :ton_of_TNT , :therm-US , :therm-EC , :terawatt_hour , :quad , :millinewton_metre , :micronewton_metre , :megaelectronvolt , :kilowatt_hour , :kiloelectronvolt , :joule , :gigaelectronvolt , :foot_poundal , :erg , :calorie-thermochemical , :calorie-International_Table , :calorie-mean , :electronvolt , :British_thermal_unit-39_F , :British_thermal_unit-59_F , :British_thermal_unit-60_F , :British_thermal_unit-International_Table , :British_thermal_unit-mean , :British_thermal_unit-thermochemical , :calorie-15_C , :calorie-20_C .

