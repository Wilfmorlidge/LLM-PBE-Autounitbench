                                                 owl:allValuesFrom  :Detectivity_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/Astrophysical_Techniques_chapter1>;
        :symbol           "D";
        :unit_of_measure  :reciprocal_watt .

:Quantum_efficiency  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "Ratio (of a detector such as a CCD) of actual number of detected photons and the number of incident photons."@en;
        rdfs:label        "quantum efficiency"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Quantum_efficiency_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Quantum_efficiency_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/Astrophysical_Techniques_chapter1>;
        :symbol           "QE";
        :unit_of_measure  :one .

:Detective_quantum_efficiency
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "Square of ratio between the output signal noise ratio and the input signal noise ratio."@en;
