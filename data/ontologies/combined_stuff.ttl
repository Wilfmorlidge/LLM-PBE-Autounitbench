                           owl:onProperty     :element
                         ];
        rdfs:subClassOf  [ rdf:type           owl:Restriction;
                           owl:allValuesFrom  :Ordered_measurement_scale_category;
                           owl:onProperty     :element
                         ] .

:Nominal_scale  rdf:type  owl:Class;
        rdfs:label       "nominal scale"@en;
        rdfs:subClassOf  :Measurement_scale;
        rdfs:subClassOf  [ rdf:type           owl:Restriction;
                           owl:allValuesFrom  :Measurement_scale_category;
                           owl:onProperty     :element
                         ];
        rdfs:subClassOf  [ rdf:type           owl:Restriction;
                           owl:allValuesFrom  :Measurement_scale_category;
                           owl:onProperty     :element
                         ] .

