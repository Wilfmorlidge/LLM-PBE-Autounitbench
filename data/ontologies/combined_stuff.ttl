:Volume  rdf:type            owl:Class , owl:NamedIndividual;
        rdfs:comment         "Volume is a measure of how much three-dimensional space any phenomenon occupies. It is a derived quantity in the International System of Units. Volume is length to the power 3."@en;
        rdfs:label           "volume"@en , "volume"@nl , "体积"@zh;
        rdfs:subClassOf      :Quantity;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :volume-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Volume_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :volume-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Volume_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        :alternative_label   "inhoud"@nl;
        :alternative_symbol  "v";
        :symbol              "V";
        :unit_of_measure     :teralitre , :picolitre , :petalitre , :nanolitre , :millilitre , :microlitre , :megalitre , :kilolitre , :hectolitre , :gigalitre , :femtolitre , :exalitre , :decilitre , :decalitre , :centilitre , :attolitre , :cubic_terametre , :cubic_picometre , :cubic_petametre , :cubic_nanometre , :cubic_millimetre , :cubic_micrometre , :cubic_megametre , :cubic_kilometre , :cubic_hectometre , :cubic_gigametre , :cubic_femtometre , :cubic_exametre , :cubic_decimetre , :cubic_decametre , :cubic_centimetre , :cubic_attometre , :ton-register , :teaspoon-US , :tablespoon-US , :stere , :quart-Imperial , :pint-Imperial , :peck-US , :liquid_quart-US , :liquid_pint-US , :gill-US , :gill-Imperial , :gallon-US , :gallon-Imperial , :fluid_ounce-US , :fluid_ounce-Imperial , :dry_quart-US , :dry_pint-US , :dry_gallon-US , :cup-US_customary , :cubic_parsec , :litre , :acre_foot , :barrel-US , :bushel-US , :cord , :cubic_kiloparsec , :cubic_metre .

