  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#numberOfFaceToFaceConversations> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
