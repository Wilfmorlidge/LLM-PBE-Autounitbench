:Permeance  rdf:type      owl:NamedIndividual , owl:Class;
        rdfs:comment      "Permeance, in general, is the degree to which a material admits a flow of matter or energy."@en;
        rdfs:label        "permeance"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
