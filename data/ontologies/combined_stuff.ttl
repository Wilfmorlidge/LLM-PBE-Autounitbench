                                              ]
                                            )
                             ] .

:Dynamic_viscosity  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment         "Viscosity is the definite resistance to change of form of many materials."@en;
        rdfs:label           "dynamische viscositeit"@nl , "dynamic viscosity"@en;
        rdfs:subClassOf      :Quantity;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :dynamic_viscosity-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Dynamic_viscosity_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :dynamic_viscosity-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Dynamic_viscosity_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        :alternative_symbol  "η";
        :symbol              "μ";
        :unit_of_measure     :centipoise , :poise , :pascal_second-time;
        :unofficial_label    "viscosity" .

:Dynamic_range_unit  rdf:type  owl:Class;
