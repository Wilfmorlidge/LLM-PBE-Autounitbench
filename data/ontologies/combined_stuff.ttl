:joule_per_kelvin_kilogram
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "joule per kelvin kilogram"@nl , "joule per kelvin kilogram"@en;
        :alternative_symbol  "J·K-1·kg-1" , "J/(K·kg)" , "J K-1 kg-1";
        :denominator         :kelvin_kilogram;
        :dimension           :specific_entropy_or_specific_heat_capacity-dimension;
        :numerator           :joule;
        :symbol              "J/(K kg)" .

:specific_entropy_or_specific_heat_capacity-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "specific entropy or specific heat capacity dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  2;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                -1;
        :SI_time_dimension_exponent    -2 .

:Specific_entropy_unit
        rdf:type             owl:Class;
