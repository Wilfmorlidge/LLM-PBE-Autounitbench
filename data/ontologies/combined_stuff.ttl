        :alternative_symbol  "mg·kg-1" , "mg kg-1";
        :denominator         :kilogram;
        :dimension           :dimension_one;
        :numerator           :milligram;
        :symbol              "mg/kg" .

:milligram_per_hectogram
        rdf:type             owl:NamedIndividual , :Unit_division;
