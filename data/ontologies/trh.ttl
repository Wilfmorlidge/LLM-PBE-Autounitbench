###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#MovAbduLeftGJGreaterThan80
TrhOnt:MovAbduLeftGJGreaterThan80 rdf:type owl:Class ;
                                  owl:equivalentClass [ owl:intersectionOf ( KiReSOntFM:Movement
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty KiReSOntFM:hasComponent ;
                                                                               owl:someValuesFrom [ owl:intersectionOf ( KiReSOntFM:Submovement
                                                                                                                         [ rdf:type owl:Restriction ;
                                                                                                                           owl:onProperty KiReSOntFM:hasLocation ;
                                                                                                                           owl:someValuesFrom fma:fma25929
                                                                                                                         ]
                                                                                                                         [ rdf:type owl:Restriction ;
                                                                                                                           owl:onProperty KiReSOntFM:hasMovementType ;
                                                                                                                           owl:someValuesFrom KiReSOntFM:Abduction
                                                                                                                         ]
                                                                                                                         [ rdf:type owl:Restriction ;
                                                                                                                           owl:onProperty KiReSOntFM:hasROMmax ;
                                                                                                                           owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                                                owl:onDatatype xsd:double ;
                                                                                                                                                owl:withRestrictions ( [ xsd:minExclusive "80.0"^^xsd:double
                                                                                                                                                                       ]
                                                                                                                                                                     )
                                                                                                                                              ]
                                                                                                                         ]
                                                                                                                       ) ;
                                                                                                    rdf:type owl:Class
                                                                                                  ]
                                                                             ]
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ] ;
                                  rdfs:subClassOf KiReSOntFM:AuxiliaryMovement .


###  http://bdi.si.ehu.es/bdi/ontologies/TrhOnt#MovAbduRightGJGreaterThan80
