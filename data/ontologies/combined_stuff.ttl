        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Metre_multiple_or_submultiple_per_second-time_multiple_or_submultiple_squared :Metre_multiple_or_submultiple_per_second-time_squared :Metre_per_second-time_multiple_or_submultiple_squared
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :gal :metre_per_second-time_squared )
                                              ]
                                            )
                             ] .

