:Bulk_modulus  rdf:type      owl:Class , owl:NamedIndividual;
        rdfs:comment         "Bulk modulus is a substance's resistance to uniform compression."@en;
        rdfs:label           "bulk modulus"@en , "compressiemodulus"@nl;
        rdfs:subClassOf      :Dynamic_modulus;
