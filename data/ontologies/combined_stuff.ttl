:zettamole_per_metre  rdf:type  owl:NamedIndividual , :Mole_multiple_or_submultiple_per_metre;
        rdfs:label           "zettamole per metre"@en , "zettamole per meter"@nl;
        :alternative_symbol  "Zmol·m-1" , "Zmol m-1";
        :denominator         :metre;
        :numerator           :zettamole;
        :symbol              "Zmol/m" .

:zettamole_per_litre  rdf:type  owl:NamedIndividual , :Mole_multiple_or_submultiple_per_litre;
        rdfs:comment         "Zettamole per litre is a unit of amount of substance concentration defined as zettamole divided by litre."@en;
        rdfs:label           "zettamole per litre"@en , "zettamole per liter"@nl;
        :alternative_symbol  "Zmol·l-1" , "Zmol l-1";
        :denominator         :litre;
        :dimension           :amount_of_substance_concentration-dimension;
        :numerator           :zettamole;
        :symbol              "Zmol/l" .

:zettamolair  rdf:type  owl:NamedIndividual , :Unit_multiple_or_submultiple;
        rdfs:comment    "The zettamolair is a unit of amount of substance concentration defined as 1.0e21 molair."@en;
        rdfs:label      "zettamolair"@nl , "zettamolair"@en;
        :dimension      :amount_of_substance_concentration-dimension;
        :prefix         :zetta;
        :singular_unit  :molair;
        :symbol         "ZM" .

:zettagram_per_litre  rdf:type  owl:NamedIndividual , :Gram_multiple_or_submultiple_per_litre;
