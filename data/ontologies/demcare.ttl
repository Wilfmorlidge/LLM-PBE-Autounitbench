<http://www.demcare.eu/ontologies/combined.owl#Active>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#State> .

<http://www.demcare.eu/ontologies/combined.owl#Activity>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#Event>, [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#hasAgent> ;
    owl:someValuesFrom <http://www.demcare.eu/ontologies/combined.owl#Person>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#hasAgent> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass <http://www.demcare.eu/ontologies/combined.owl#Person>
  ] .

<http://www.demcare.eu/ontologies/combined.owl#AlarmClock>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#Object> .

<http://www.demcare.eu/ontologies/combined.owl#AlarmClockRinging>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#Ringing>, [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#hasAgent> ;
    owl:someValuesFrom <http://www.demcare.eu/ontologies/combined.owl#AlarmClock>
  ] .

<http://www.demcare.eu/ontologies/combined.owl#AmbientMeasurement>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#Measurement>, [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#refersTo> ;
    owl:allValuesFrom <http://www.demcare.eu/ontologies/combined.owl#Room>
  ] .

<http://www.demcare.eu/ontologies/combined.owl#AnswerPhoneCall>
  a owl:Class ;
