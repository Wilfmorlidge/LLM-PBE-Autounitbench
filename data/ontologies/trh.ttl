###  http://purl.org/sig/ont/fma/fma67504
fma:fma67504 rdf:type owl:Class ;
             rdfs:subClassOf fma:fma67135 ;
             fma:FMAID "67504" ;
             fma:definition "Anatomical structure, which is a subdivision of a cardinal body part; it may exclude bones; is demarcated from other subdivisions of the same cardinal body part by anatomical surfaces or lines or topographical references; together with other contiguous subdivisions of the same cardinal body part, it constitutes a cardinal body part. Examples: thorax, perineum, back of neck, forearm, hand, phalanx, nose, auricle of ear, scrotum." ;
             fma:non-English_equivalent "Subdivisión de la pieza de cuerpo principal" ,
                                        "Suddivisione della parte di corpo principale" ,
                                        "Unterteilung des Hauptkörperteils" ;
             fma:preferred_name "Subdivision of cardinal body part" ;
