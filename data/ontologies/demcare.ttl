<http://www.demcare.eu/ontologies/combined.owl#DiagnosisType>
  a owl:Class ;
  owl:equivalentClass [
    a owl:Class ;
    owl:oneOf (
     <http://www.demcare.eu/ontologies/combined.owl#dementia>
     <http://www.demcare.eu/ontologies/combined.owl#healthy>
     <http://www.demcare.eu/ontologies/combined.owl#predementia>
   )
  ] ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#Type> .

<http://www.demcare.eu/ontologies/combined.owl#DirectedDiscussionTask>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#DiscussionTask> .

<http://www.demcare.eu/ontologies/combined.owl#DirectedTask>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#Task> .

<http://www.demcare.eu/ontologies/combined.owl#DiscussionInvolvementData>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#MeasuredData>, [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#verbalReactionSpontaneity> ;
    owl:allValuesFrom rdfs:Literal
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#verbalReactionSpontaneity> ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
  ] .

<http://www.demcare.eu/ontologies/combined.owl#DiscussionTask>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#Task>, [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#measuredData> ;
    owl:someValuesFrom <http://www.demcare.eu/ontologies/combined.owl#MoodVoiceData>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#measuredData> ;
    owl:someValuesFrom <http://www.demcare.eu/ontologies/combined.owl#StressData>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#measuredData> ;
    owl:allValuesFrom [
