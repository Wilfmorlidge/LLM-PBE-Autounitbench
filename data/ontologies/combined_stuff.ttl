                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        :alternative_label  "activity (of a radionuclide)"@en , "activity of a radionuclide"@en;
        :symbol             "A";
        :unit_of_measure    :terabecquerel , :picobecquerel , :petabecquerel , :nanobecquerel , :millibecquerel , :microbecquerel , :megabecquerel , :kilobecquerel , :hectobecquerel , :gigabecquerel , :femtobecquerel , :becquerel , :curie , :reciprocal_second-time , :attobecquerel , :centibecquerel , :decabecquerel , :decibecquerel , :exabecquerel .

:joule_second-time  rdf:type  owl:NamedIndividual , :Unit_multiplication;
        rdfs:label           "joule seconde"@nl , "joule second"@en;
        :alternative_symbol  "J·s";
        :dimension           :action_or_angular_momentum-dimension;
        :symbol              "J s";
        :term_1              :joule;
        :term_2              :second-time .

:erg_second-time  rdf:type   owl:NamedIndividual , :Unit_multiplication;
