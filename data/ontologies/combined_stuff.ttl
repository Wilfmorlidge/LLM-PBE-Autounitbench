:Watt_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :watt;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :watt;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:watt_per_square_metre
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "watt per vierkante meter"@nl , "watt per square metre"@en;
        :alternative_symbol  "W·m-2" , "W m-2";
        :denominator         :square_metre;
        :dimension           :power_density-dimension;
        :numerator           :watt;
        :symbol              "W/m2" .

:power_density-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "power density dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  0;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    1;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    -3 .

:Power_density_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :watt_per_square_metre )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :watt_per_square_metre )
                             ] .

:power-dimension  rdf:type             owl:NamedIndividual , :Dimension;
        rdfs:label                     "power dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  2;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    1;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    -3 .

:Power_unit  rdf:type        owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Watt_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :horsepower-British :horsepower-boiler :horsepower-electric :horsepower-metric :horsepower-water :joule_per_second-time :solar_luminosity :ton_of_refrigeration :watt )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Watt_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :horsepower-British :horsepower-boiler :horsepower-electric :horsepower-metric :horsepower-water :joule_per_second-time :solar_luminosity :ton_of_refrigeration :watt )
                                              ]
                                            )
                             ] .

:Potential_energy  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:comment         "Potential energy is energy due to position of one body with respect to another or to the relative parts of the same body."@en;
        rdfs:label           "potential energy"@en , "potentiële energie"@nl , "势能"@zh;
        rdfs:subClassOf      :Energy;
        :alternative_symbol  "U" , "V" , "Φ";
        :symbol              "E_p";
        :unit_of_measure     :terajoule , :picojoule , :petajoule , :nanojoule , :millijoule , :microjoule , :megajoule , :megaerg , :kilojoule , :kilocalorie-mean , :hectojoule , :gigajoule , :femtojoule , :exajoule , :decijoule , :decajoule , :centijoule , :attojoule , :ton_of_TNT , :therm-US , :therm-EC , :terawatt_hour , :quad , :newton_metre , :millinewton_metre , :micronewton_metre , :megaelectronvolt , :kilowatt_hour , :kiloelectronvolt , :joule , :gigaelectronvolt , :foot_poundal , :erg , :calorie-thermochemical , :calorie-International_Table , :calorie-20_C , :calorie-15_C , :British_thermal_unit-thermochemical , :British_thermal_unit-mean , :calorie-mean , :electronvolt , :British_thermal_unit-39_F , :British_thermal_unit-59_F , :British_thermal_unit-60_F , :British_thermal_unit-International_Table .

:Potential_difference
        rdf:type             owl:Class , owl:NamedIndividual;
        rdfs:label           "potentiaalverschil"@nl , "potential difference"@en;
        rdfs:subClassOf      :Electric_potential;
        :alternative_symbol  "V";
        :symbol              "U";
        :unit_of_measure     :teravolt , :picovolt , :petavolt , :nanovolt , :millivolt , :microvolt , :megavolt , :kilovolt , :hectovolt , :gigavolt , :abvolt , :statvolt , :volt , :watt_per_ampere , :attovolt , :centivolt , :decavolt , :decivolt , :exavolt , :femtovolt .

:Potassium_sorbate_mass_fraction
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "The fraction of the mass of potassium sorbate in a phenomenon"@en;
        rdfs:label        "potassium sorbate mass fraction"@en;
        rdfs:subClassOf   :Mass_fraction;
        :unit_of_measure  :gram_per_gram , :percent , :one .

