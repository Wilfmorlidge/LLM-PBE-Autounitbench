                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Henry_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :abhenry :henry :stathenry :weber_per_ampere )
                                              ]
                                            )
                             ] .

:Inductance  rdf:type     owl:Class , owl:NamedIndividual;
        rdfs:comment      "Inductance is that property in an electrical circuit where a change in the current flowing through that circuit induces an electromotive force that opposes the change in current."@en;
        rdfs:label        "inductance"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :inductance_or_permeance-electromagnetic-dimension;
