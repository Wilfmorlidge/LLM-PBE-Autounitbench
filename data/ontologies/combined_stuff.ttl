:Pressure  rdf:type          owl:Class , owl:NamedIndividual;
        rdfs:comment         "Pressure is the force applied to or distributed over a surface. It is a derived quantity in the International System of Units. Pressure is force divided by area."@en;
        rdfs:label           "druk"@nl , "pressure"@en , "压力"@zh;
        rdfs:subClassOf      :Quantity;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :pressure-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Pressure_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :pressure-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Pressure_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        :alternative_symbol  "P";
        :symbol              "p";
        :unit_of_measure     :terapascal , :picopascal , :petapascal , :nanopascal , :millipascal , :micropascal , :megapascal , :kilopascal , :hectopascal , :gigapascal , :femtopascal , :exapascal , :decipascal , :decapascal , :centipascal , :attopascal , :torr , :newton_per_square_metre , :millimetre_of_mercury , :millibar , :microbar , :metre_of_mercury , :pascal , :atmosphere-standard , :atmosphere-technical , :bar , :barye , :centimetre_of_mercury , :decibar , :kilogram_second-time_to_the_power_-2_reciprocal_metre .

