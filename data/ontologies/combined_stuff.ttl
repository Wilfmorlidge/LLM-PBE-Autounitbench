:metre_per_second-time_per_metre
        rdf:type      owl:NamedIndividual , :Unit_division;
        rdfs:label    "metre per second per metre"@en , "meter per seconde per metre"@nl;
        :denominator  :metre;
        :numerator    :metre_per_second-time;
        :symbol       "m/s/m" .

:kilometre_per_second-time_per_megaparsec
        rdf:type      owl:NamedIndividual , :Unit_division;
        rdfs:comment  "De eenheid van de Hubble constante (die niet constant is!) ("@en;
        rdfs:label    "kilometre per second per megaparsec"@en , "kilometer per seconde per megaparsec"@nl;
        :denominator  :megaparsec;
