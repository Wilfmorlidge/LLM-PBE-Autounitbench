        rdfs:label  "日元"@zh , "Japanese yen"@en .

:Indian_rupee  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:label  "印度卢比"@zh , "Indian rupee"@en .

:Hong_Kong_dollar  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:label  "港元"@zh , "Hong Kong dollar"@en .

:Chinese_yuan  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:label  "中国元"@zh , "Chinese yuan"@en .

:Canadian_dollar  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:label  "加元"@zh , "Canadian dollar"@en .

:Brazilian_real  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:label  "巴西里拉"@zh , "Brazilian real"@en .

:Australian_dollar  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:label  "澳元"@zh , "Australian dollar"@en .

:Curie_temperature  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "Curie temperature"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "T_C" .

:Metre_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :metre;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :metre;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:Cubic_metre_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_exponentiation;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :Metre_multiple_or_submultiple;
                                                       owl:onProperty     :base
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :base
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    "3"^^xsd:nonNegativeInteger;
                                                       owl:onProperty  :exponent
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :exponent
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :Metre_multiple_or_submultiple;
                                                       owl:onProperty     :base
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :base
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    "3"^^xsd:nonNegativeInteger;
                                                       owl:onProperty  :exponent
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :exponent
                                                     ]
                                                   )
                             ] .

:Cubic_expansion_coefficient
        rdf:type             owl:NamedIndividual , owl:Class;
        rdfs:label           "kubieke uitzettingscoëfficiënt"@nl , "cubic expansion coefficient"@en;
        rdfs:subClassOf      :Quantity;
        :LaTeX_symbol        "\\alpha_{V}";
        :alternative_symbol  "γ";
        :symbol              "α_V" .

:Cross_section  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "cross section"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "σ" .

:Density  rdf:type          owl:Class , owl:NamedIndividual;
        rdfs:comment        "Density is the concentration of matter. It is a derived quantity in the International System of Units. Density is mass divided by volume."@en;
        rdfs:label          "density"@en , "dichtheid"@nl , "密度"@zh;
        rdfs:subClassOf     :Quantity;
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :density-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Density_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :density-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Density_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        :alternative_label  "concentration (w/v)"@en , "mass density"@en , "soortelijke massa"@nl;
        :symbol             "ρ";
        :unit_of_measure    :teragram_per_litre , :picogram_per_litre , :petagram_per_litre , :nanogram_per_litre , :milligram_per_litre , :microgram_per_litre , :megagram_per_litre , :kilogram_per_litre , :hectogram_per_litre , :gram_per_teralitre , :gram_per_picolitre , :gram_per_petalitre , :gram_per_nanolitre , :gram_per_millilitre , :gram_per_microlitre , :gram_per_megalitre , :gram_per_kilolitre , :gram_per_hectolitre , :gram_per_gigalitre , :gram_per_femtolitre , :gram_per_exalitre , :gram_per_decilitre , :gram_per_decalitre , :gram_per_centilitre , :gram_per_attolitre , :gigagram_per_litre , :femtogram_per_litre , :exagram_per_litre , :decigram_per_litre , :decagram_per_litre , :centigram_per_litre , :attogram_per_litre , :milligram_per_cubic_metre , :gram_per_cubic_centimetre , :gram_per_cubic_metre , :gram_per_litre , :kilogram_per_cubic_decimetre , :kilogram_per_cubic_metre , :microgram_per_cubic_centimetre .

:Critical_density  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "The density needed for a closed universe."@en;
        rdfs:label        "kritieke dichtheid"@nl , "critical density"@en;
        rdfs:subClassOf   :Density;
        :symbol           "ρ_c";
        :unit_of_measure  :milligram_per_cubic_metre , :microgram_per_cubic_centimetre , :kilogram_per_cubic_metre , :kilogram_per_cubic_decimetre , :gram_per_cubic_metre , :gram_per_cubic_centimetre .

:Creation_operators  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label           "creation operators"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_symbol  "β^†" , "α^†" , "b^†";
        :symbol              "a^†" .

:Cowling_number_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :one )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :one )
                             ] .

:Cowling_number  rdf:type    owl:NamedIndividual , owl:Class;
        rdfs:label           "Cowling number"@en;
        rdfs:subClassOf      :Quantity;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :dimension_one;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Cowling_number_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :dimension_one;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Cowling_number_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        :alternative_label   "second Cowling number"@en;
        :alternative_symbol  "Co2";
        :symbol              "Co";
        :unit_of_measure     :one .

:Coverage  rdf:type       owl:NamedIndividual , owl:Class;
        rdfs:label        "coverage"@en;
        rdfs:subClassOf   :Area_fraction;
        :unit_of_measure  :square_metre_per_square_metre , :percent , :parts_per_million , :one .

:Cousins_magnitude  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment     "A magnitude measured in one of Cousins standard passbands (using a standard filter, i.e. I or R)."@en;
        rdfs:label       "Cousins magnitude"@en;
        rdfs:subClassOf  :Magnitude .

:Coupling_coefficient
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "coupling coefficient"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "k" .

:coulomb  rdf:type    owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The coulomb is a unit of electric charge defined as ampere times second = farad times volt."@en;
        rdfs:label    "coulomb"@nl , "coulomb"@en;
        :definition   :second-time_ampere;
        :dimension    :electric_charge-dimension;
        :longcomment  "The coulomb is a unit of electric charge defined as ampere times second = farad times volt. The coulomb is a derived unit in the International System of Units.";
        :symbol       "C" .

:Coulomb_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :coulomb;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :coulomb;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:Cost   rdf:type          owl:Class , owl:NamedIndividual;
        rdfs:label        "cost"@en;
        rdfs:subClassOf   :Amount_of_money;
        :unit_of_measure  :pound_sterling , :megaeuro , :euro , :United_States_dollar , :Turkish_lira , :Swiss_franc , :Swedish_krona , :South_Korean_won , :Australian_dollar , :Brazilian_real , :Canadian_dollar , :Chinese_yuan , :Hong_Kong_dollar , :Indian_rupee , :Japanese_yen , :Mexican_peso , :New_Zealand_dollar , :Norwegian_krone , :Russian_ruble , :Singapore_dollar , :South_African_rand .

:Cosmological_constant
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:comment     "The cosmological constant."@en;
        rdfs:label       "kosmologische constante"@nl , "cosmological constant"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "Λ" .

:Contact_angle  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:label        "contact angle"@en;
        rdfs:subClassOf   :Plane_angle;
        :unit_of_measure  :picoradian , :nanoradian , :milliradian , :microradian , :femtoradian , :degree , :gon , :metre_per_metre , :microsecond-plane_angle , :mil-plane_angle , :millisecond-plane_angle , :minute-plane_angle , :radian , :revolution , :second-plane_angle , :attoradian , :centiradian , :deciradian .

:Compton_wavelength  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "Compton wavelength"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "λ_C" .

:Stress  rdf:type         owl:Class , owl:NamedIndividual;
        rdfs:comment      "Stress is a force that produces or tends to produce deformation in a body measured by the force applied per unit area."@en;
        rdfs:label        "mechanische spanning"@nl , "stress"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :pressure-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Stress_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :pressure-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Stress_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "σ";
        :unit_of_measure  :terapascal , :picopascal , :petapascal , :nanopascal , :millipascal , :micropascal , :megapascal , :kilopascal , :hectopascal , :gigapascal , :femtopascal , :exapascal , :decipascal , :decapascal , :centipascal , :attopascal , :torr , :newton_per_square_metre , :millimetre_of_mercury , :millibar , :pascal , :atmosphere-standard , :atmosphere-technical , :bar , :barye , :centimetre_of_mercury , :decibar , :kilogram_second-time_to_the_power_-2_reciprocal_metre , :metre_of_mercury , :microbar .

:Compressive_stress  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:comment      "Compressive stress is a stress that, when applied, acts towards the center of a material."@en;
        rdfs:label        "compressive stress"@en;
        rdfs:subClassOf   :Stress;
        :unit_of_measure  :terapascal , :picopascal , :petapascal , :nanopascal , :millipascal , :micropascal , :megapascal , :kilopascal , :hectopascal , :gigapascal , :femtopascal , :exapascal , :decipascal , :decapascal , :centipascal , :attopascal , :torr , :newton_per_square_metre , :pascal , :atmosphere-standard , :atmosphere-technical , :bar , :barye , :centimetre_of_mercury , :decibar , :kilogram_second-time_to_the_power_-2_reciprocal_metre , :metre_of_mercury , :microbar , :millibar , :millimetre_of_mercury .

:Compressibility  rdf:type   owl:NamedIndividual , owl:Class;
        rdfs:comment         "Compressibility is the relative volume change of a fluid or solid as a response to a pressure or stress change."@en;
        rdfs:label           "compressibility"@en , "compressibiliteit"@nl;
        rdfs:subClassOf      :Quantity;
        :alternative_symbol  "κ";
        :symbol              "κ_T" .

:Compound_unit  rdf:type  owl:Class;
        rdfs:label       "compound unit"@en;
        rdfs:subClassOf  :Unit_of_measure .

:Compliance_tensor  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "compliance tensor"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "s_klji" .

:Complex_conjugate_of_psi
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "complex conjugate of Ψ"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "Ψ*" .

:Commutator_of_A_and_B
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "commutator of A and B"@en;
        rdfs:subClassOf  :Quantity .

:reciprocal_square_metre
        rdf:type    owl:NamedIndividual , :Unit_exponentiation;
        rdfs:label  "reciprocal square metre"@en , "omgekeerde vierkante meter"@nl;
        :base       :metre;
        :dimension  :column_number_density-dimension;
        :exponent   -2;
        :symbol     "m-2" .

:reciprocal_square_centimetre
        rdf:type    owl:NamedIndividual , :Unit_exponentiation;
        rdfs:label  "reciprocal square centimetre"@en , "omgekeerde vierkante centimeter"@nl;
        :base       :centimetre;
        :dimension  :column_number_density-dimension;
        :exponent   -2;
        :symbol     "cm-2" .

:column_number_density-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "column number density dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  -2;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    0 .

:Column_number_density_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :reciprocal_square_centimetre :reciprocal_square_metre )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :reciprocal_square_centimetre :reciprocal_square_metre )
                             ] .

:Column_number_density
        rdf:type           owl:NamedIndividual , owl:Class;
        rdfs:label         "column number density"@en;
        rdfs:subClassOf    :Quantity;
        rdfs:subClassOf    [ rdf:type        owl:Restriction;
                             owl:hasValue    :column_number_density-dimension;
                             owl:onProperty  :dimension
                           ];
        rdfs:subClassOf    [ rdf:type           owl:Restriction;
                             owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                  owl:allValuesFrom  :Column_number_density_unit;
                                                  owl:onProperty     :unit_of_measure_or_measurement_scale
                                                ];
                             owl:onProperty     :value
                           ];
        rdfs:subClassOf    [ rdf:type        owl:Restriction;
                             owl:hasValue    :column_number_density-dimension;
                             owl:onProperty  :dimension
                           ];
        rdfs:subClassOf    [ rdf:type           owl:Restriction;
                             owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                  owl:allValuesFrom  :Column_number_density_unit;
                                                  owl:onProperty     :unit_of_measure_or_measurement_scale
                                                ];
                             owl:onProperty     :value
                           ];
        :unit_of_measure   :reciprocal_square_metre , :reciprocal_square_centimetre;
        :unofficial_label  "number density" , "density" .

:Colour_temperature  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "The temperature of a blackbody that has the same colour index as a given star."@en;
        rdfs:label        "colour temperature"@en;
        rdfs:subClassOf   :Thermodynamic_temperature;
        :unit_of_measure  :kelvin .

:Colour_index  rdf:type   owl:NamedIndividual , owl:Class;
        rdfs:comment      "The difference between the apparent magnitude of a star at two different wavelengths (always the shorter-wavelength magnitude minus the longer-wavelength magnitude) to give a quantification of the star's colour. The magnitude of an object at different wavelengths are measured by using different filters before the detector. Often the Johnson system with UBV passbands are used. Other passbands may also be used (for instance g-r)."@en;
        rdfs:label        "kleurindex"@nl , "colour index"@en;
        rdfs:subClassOf   :Quantity;
        :unit_of_measure  :magnitude .

:Color_area_fraction  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment        "Voorbeeld Avocado Hass: percentage oppervlak donker."@nl;
        rdfs:label          "kleuroppervlaktefractie"@nl , "color area fraction"@en;
        rdfs:subClassOf     :Area_fraction;
        :alternative_label  "color%"@en;
        :unit_of_measure    :percent .

:Frequency  rdf:type              owl:Class , owl:NamedIndividual;
        rdfs:comment              "Frequency is a measure of the number of occurrences of a repeating event per unit time."@en;
        rdfs:label                "frequency"@en , "frequentie"@nl , "频率"@zh;
        rdfs:subClassOf           :Quantity;
        rdfs:subClassOf           [ rdf:type        owl:Restriction;
                                    owl:hasValue    :frequency-dimension;
                                    owl:onProperty  :dimension
                                  ];
        rdfs:subClassOf           [ rdf:type           owl:Restriction;
                                    owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                         owl:allValuesFrom  :Frequency_unit;
                                                         owl:onProperty     :unit_of_measure_or_measurement_scale
                                                       ];
                                    owl:onProperty     :value
                                  ];
        rdfs:subClassOf           [ rdf:type        owl:Restriction;
                                    owl:hasValue    :frequency-dimension;
                                    owl:onProperty  :dimension
                                  ];
        rdfs:subClassOf           [ rdf:type           owl:Restriction;
                                    owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                         owl:allValuesFrom  :Frequency_unit;
                                                         owl:onProperty     :unit_of_measure_or_measurement_scale
                                                       ];
                                    owl:onProperty     :value
                                  ];
        :alternative_symbol       "ν";
        :symbol                   "f";
        :unit_of_measure          :terahertz , :picohertz , :petahertz , :nanohertz , :millihertz , :microhertz , :megahertz , :kilohertz , :hectohertz , :gigahertz , :femtohertz , :exahertz , :decihertz , :decahertz , :centihertz , :reciprocal_second-time , :hertz , :reciprocal_day , :reciprocal_hour , :reciprocal_minute-time , :reciprocal_year , :attohertz;
        :unofficial_abbreviation  "freq" .

:Collision_frequency  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:comment         "Collision frequency is the average number of collisions between reacting molecules per unit time."@en;
        rdfs:label           "collision frequency"@en;
