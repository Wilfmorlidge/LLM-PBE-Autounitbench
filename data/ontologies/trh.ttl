###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#KiReSOntFMConcept
KiReSOntFM:KiReSOntFMConcept rdf:type owl:Class ;
                             rdfs:comment "Concept belonging to the foundational model of KiReSOnt" ;
                             rdfs:label "KiReSOntFMConcept"@en .


###  http://bdi.si.ehu.es/bdi/ontologies/KiReSOntFM#Movement
KiReSOntFM:Movement rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty KiReSOntFM:hasComponent ;
                                          owl:someValuesFrom KiReSOntFM:Submovement
                                        ] ;
                    rdfs:subClassOf KiReSOntFM:KiReSOntFMConcept ;
                    rdfs:comment "Physiotherapy movement" ;
                    rdfs:label "Movement"@en .


