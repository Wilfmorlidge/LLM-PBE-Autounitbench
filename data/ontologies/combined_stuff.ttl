        :alternative_symbol  "V_ij";
        :symbol              "φ_ij";
        :unit_of_measure     :terajoule , :picojoule , :petajoule , :nanojoule , :millijoule , :microjoule , :megajoule , :megaerg , :kilojoule , :kilocalorie-mean , :hectojoule , :gigajoule , :femtojoule , :exajoule , :decijoule , :decajoule , :centijoule , :attojoule , :ton_of_TNT , :therm-US , :therm-EC , :terawatt_hour , :quad , :newton_metre , :millinewton_metre , :micronewton_metre , :megaelectronvolt , :kilowatt_hour , :kiloelectronvolt , :joule , :gigaelectronvolt , :foot_poundal , :erg , :calorie-thermochemical , :calorie-mean , :electronvolt , :British_thermal_unit-39_F , :British_thermal_unit-59_F , :British_thermal_unit-60_F , :British_thermal_unit-International_Table , :British_thermal_unit-mean , :British_thermal_unit-thermochemical , :calorie-15_C , :calorie-20_C , :calorie-International_Table .

:Integrated_magnitude
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "The apparent magnitude that an extended object, such as a nebula or galaxy, would have if all its light were concentrated at a starlike point."@en;
        rdfs:label        "integrated magnitude"@en;
        rdfs:subClassOf   :Magnitude;
        :unit_of_measure  :magnitude .

:Initial_mass_function
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "The number of stars in mass fraction dM around mass M. Used in Salpeter's Initial Mass Function (IMF)."@en;
        rdfs:label        "initial mass function"@en;
        rdfs:subClassOf   :Number_density;
        :symbol           "IMF";
        :unit_of_measure  :reciprocal_cubic_parsec .

:shannon  rdf:type    owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The shannon is a unit of information capacity defined as 1 bit."@en;
        rdfs:label    "shannon"@nl , "shannon"@en;
        :definition   :bit;
        :symbol       "Sh" .

:hartley  rdf:type    owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The hartley is a unit of information capacity defined as 3.321928095 bit."@en;
        rdfs:label    "hartley"@nl , "hartley"@en;
        :definition   :_3.321928095_bit;
        :symbol       "Hart" .

:Information_capacity_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Bit_multiple_or_submultiple :Byte_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :bit :byte :hartley :shannon )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Bit_multiple_or_submultiple :Byte_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :bit :byte :hartley :shannon )
                                              ]
                                            )
                             ] .

:Information_capacity
        rdf:type          owl:Class , owl:NamedIndividual;
        rdfs:label        "informatiecapaciteit"@nl , "information capacity"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Information_capacity_unit;
