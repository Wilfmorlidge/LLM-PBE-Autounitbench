:Emissivity  rdf:type    owl:NamedIndividual , owl:Class;
        rdfs:comment     "The emissivity of a material is the ratio of energy radiated by a particular material to energy radiated by a black body at the same temperature."@en;
        rdfs:label       "emissivity"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "ε" .

:Ellipticity  rdf:type      owl:NamedIndividual , owl:Class;
        rdfs:comment        "A measure of the amount by which an object, such as a planet or a galaxy, deviates from a perfect sphere."@en;
        rdfs:label          "ellipticity"@en;
        rdfs:subClassOf     :Quantity_of_dimension_one;
        :alternative_label  "oblateness"@en , "flattening"@en;
        :symbol             "f";
        :unit_of_measure    :one .

