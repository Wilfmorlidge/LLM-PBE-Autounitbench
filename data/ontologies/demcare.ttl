  ] .

<http://www.demcare.eu/ontologies/combined.owl#AbilityToOrganiseAssessment>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#ExperimentalAssessment> .

<http://www.demcare.eu/ontologies/combined.owl#ActivityStatusType>
  a owl:Class ;
  owl:equivalentClass [
    a owl:Class ;
    owl:oneOf (
     <http://www.demcare.eu/ontologies/combined.owl#completed>
     <http://www.demcare.eu/ontologies/combined.owl#incomplete>
     <http://www.demcare.eu/ontologies/combined.owl#omitted>
   )
  ] ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#Type> .

<http://www.demcare.eu/ontologies/combined.owl#AnswerPhoneTask>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#SemiDirectedTask> .

<http://www.demcare.eu/ontologies/combined.owl#ApathyAssessment>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#ExperimentalAssessment> .

<http://www.demcare.eu/ontologies/combined.owl#AutonomyAssessment>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#ClinicalAssessment>, [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#iadl_e> ;
    owl:allValuesFrom xsd:int
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#iadl_e> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:int
  ] .

<http://www.demcare.eu/ontologies/combined.owl#CallPsychologistTask>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#SemiDirectedTask> .

<http://www.demcare.eu/ontologies/combined.owl#ClinicalAssessment> a owl:Class .
<http://www.demcare.eu/ontologies/combined.owl#ClinicalRecord>
  a owl:Class ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#containsAssessment> ;
    owl:allValuesFrom [
      a owl:Class ;
      owl:unionOf (
       <http://www.demcare.eu/ontologies/combined.owl#AutonomyAssessment>
       <http://www.demcare.eu/ontologies/combined.owl#CognitiveAbilitiesAssessment>
       <http://www.demcare.eu/ontologies/combined.owl#DiagnosisAssessment>
       <http://www.demcare.eu/ontologies/combined.owl#MotricityAbilitiesAssessment>
       <http://www.demcare.eu/ontologies/combined.owl#NeuropsychiatricAndMoodAssessment>
     )
    ]
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#containsAssessment> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass <http://www.demcare.eu/ontologies/combined.owl#AutonomyAssessment>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#containsAssessment> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass <http://www.demcare.eu/ontologies/combined.owl#CognitiveAbilitiesAssessment>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#containsAssessment> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass <http://www.demcare.eu/ontologies/combined.owl#DiagnosisAssessment>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#containsAssessment> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass <http://www.demcare.eu/ontologies/combined.owl#MotricityAbilitiesAssessment>
  ] .

<http://www.demcare.eu/ontologies/combined.owl#CognitiveAbilitiesAssessment>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#ClinicalAssessment>, [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#fabScore> ;
    owl:allValuesFrom xsd:int
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#freeAndCuedRemindingAssessment> ;
    owl:allValuesFrom xsd:string
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#hasMMSEScore> ;
    owl:allValuesFrom xsd:int
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#shortCognitiveBatteryAssessment> ;
    owl:allValuesFrom xsd:string
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#trailMakingTest> ;
    owl:allValuesFrom xsd:string
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#fabScore> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:int
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#freeAndCuedRemindingAssessment> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:string
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#hasMMSEScore> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:int
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#shortCognitiveBatteryAssessment> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:string
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#trailMakingTest> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:string
  ] .

<http://www.demcare.eu/ontologies/combined.owl#CognitiveAbilitiesData>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#MeasuredData>, [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#status> ;
    owl:allValuesFrom <http://www.demcare.eu/ontologies/combined.owl#ActivityStatusType>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#taskDuration> ;
    owl:allValuesFrom time:DurationDescription
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#status> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass <http://www.demcare.eu/ontologies/combined.owl#ActivityStatusType>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#taskDuration> ;
