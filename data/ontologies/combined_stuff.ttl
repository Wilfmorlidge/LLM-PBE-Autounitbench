:joule_per_cubic_metre
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "joule per kubieke meter"@nl , "joule per cubic metre"@en;
        :alternative_symbol  "J·m-3" , "J m-3";
        :denominator         :cubic_metre;
        :dimension           :energy_density-dimension;
        :numerator           :joule;
        :symbol              "J/m3" .

:energy_density-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "energy density dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  -1;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    1;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    -2 .

:Energy_density_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :joule_per_cubic_metre )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :joule_per_cubic_metre )
                             ] .

:Energy_density  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "Energy density is the amount of energy stored in a given system or region of space per unit volume."@en;
        rdfs:label        "energy density"@en , "energiedichtheid"@nl;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :energy_density-dimension;
