:litre_per_mole  rdf:type    owl:NamedIndividual , :Unit_division;
        rdfs:label           "litre per mole"@en , "liter per mol"@nl;
        :alternative_symbol  "l·mol-1" , "l mol-1";
        :denominator         :mole;
        :numerator           :litre;
        :symbol              "l/mol" .

:cubic_metre_per_mole
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "kubieke meter per mol"@nl , "cubic metre per mole"@en;
        :alternative_symbol  "m3·mol-1" , "m3 mol-1";
        :denominator         :mole;
        :numerator           :cubic_metre;
        :symbol              "m3/mol" .

