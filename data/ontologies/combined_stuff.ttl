        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :newton_per_metre )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :newton_per_metre )
                             ] .

:Surface_tension  rdf:type   owl:NamedIndividual , owl:Class;
        rdfs:comment         "Surface tension is an attractive property of the surface of a liquid."@en;
        rdfs:label           "surface tension"@en , "oppervlaktespanning"@nl;
        rdfs:subClassOf      :Quantity;
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :surface_tension-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Surface_tension_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        rdfs:subClassOf      [ rdf:type        owl:Restriction;
                               owl:hasValue    :surface_tension-dimension;
                               owl:onProperty  :dimension
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Surface_tension_unit;
