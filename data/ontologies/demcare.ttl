    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#refersTo> ;
    owl:allValuesFrom <http://www.demcare.eu/ontologies/combined.owl#Entity>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#hasQuality> ;
