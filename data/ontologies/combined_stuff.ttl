                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Weber_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Weber_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "We";
        :unit_of_measure  :one .

:reciprocal_metre  rdf:type  owl:NamedIndividual , :Unit_exponentiation;
        rdfs:comment  "Reciprocal metre is a unit of wavenumber defined as 1 divided by metre."@en;
        rdfs:label    "reciprocal metre"@en , "omgekeerder meter"@nl;
        :base         :metre;
        :dimension    :wavenumber-dimension;
        :exponent     -1;
        :longcomment  "Reciprocal metre is a unit of wavenumber defined as 1 divided by metre. Reciprocal metre is a derived unit in the International System of Units.";
        :symbol       "m-1" .

:kayser  rdf:type           owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The kayser is a unit of wavenumber defined as 100 reciprocal metre."@en;
        rdfs:label          "kayser"@nl , "kayser"@en;
        :alternative_label  "rydberg"@nl , "rydberg"@en;
        :definition         :_1.0e2_reciprocal_metre;
        :dimension          :wavenumber-dimension .

:wavenumber-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "wavenumber dimension"@en , "golfgetaldimensie"@nl;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  -1;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    0 .

:Wavenumber_unit  rdf:type   owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :kayser :reciprocal_metre )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :kayser :reciprocal_metre )
                             ] .

:Wavenumber  rdf:type     owl:NamedIndividual , owl:Class;
        rdfs:comment      "Wavenumber is the number of repeating units of a propagating wave (the number of times a wave has the same phase) per unit of space."@en;
        rdfs:label        "wavenumber"@en , "golfgetal"@nl;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :wavenumber-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Wavenumber_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :wavenumber-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Wavenumber_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "σ";
        :unit_of_measure  :reciprocal_metre , :kayser .

:Wave_vector  rdf:type   owl:NamedIndividual , owl:Class;
        rdfs:label       "wave vector"@en , "golfvector"@nl;
        rdfs:subClassOf  :Quantity;
        :symbol          "σ" .

:Wave_function  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "wave function"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "Ψ" .

:Water_mass_fraction  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "The fraction of the mass of water in a phenomenon"@en;
        rdfs:label        "water mass fraction"@en;
        rdfs:subClassOf   :Mass_fraction;
        :unit_of_measure  :gram_per_gram , :percent , :one .

:Water_activity  rdf:type  owl:Class;
        rdfs:comment     "Water activity is the relative availability of water in a substance."@en;
        rdfs:label       "water activity"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "a_w" .

:Volumetric_yeast_and_fungi_count
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:label        "yeast and fungi count (volumetric)"@en;
        rdfs:subClassOf   :Volumetric_viable_count;
        :unit_of_measure  :kilocolony_forming_unit_per_millilitre , :colony_forming_unit_per_millilitre , :colony_forming_unit_per_25_millilitre .

:kilocolony_forming_unit_per_millilitre
        rdf:type                  owl:NamedIndividual , :Unit_division;
        rdfs:label                "kilocolony forming unit per millilitre"@en;
        :alternative_label        "1000 colony forming unit per millilitre"@en;
        :denominator              :millilitre;
        :numerator                :kilocolony_forming_unit;
        :symbol                   "kCFU/ml";
        :unofficial_abbreviation  "1000 CFU/ml" .

:colony_forming_unit_per_millilitre
        rdf:type      owl:NamedIndividual , :Unit_division;
        rdfs:label    "colony forming unit per millilitre"@en;
        :denominator  :millilitre;
        :numerator    :colony_forming_unit;
        :symbol       "CFU/ml" .

:colony_forming_unit_per_25_millilitre
        rdf:type      owl:NamedIndividual , :Unit_division;
        rdfs:label    "colony forming unit per 25 millilitre"@en;
        :denominator  :_25_millilitre;
        :numerator    :colony_forming_unit;
        :symbol       "CFU/ml" .

:Volumetric_viable_count_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :colony_forming_unit_per_25_millilitre :colony_forming_unit_per_millilitre :kilocolony_forming_unit_per_millilitre )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :colony_forming_unit_per_25_millilitre :colony_forming_unit_per_millilitre :kilocolony_forming_unit_per_millilitre )
                             ] .

:litre_per_hour  rdf:type    owl:NamedIndividual , :Unit_division;
        rdfs:label           "litre per hour"@en , "liter per uur"@nl;
        :alternative_symbol  "l·h-1" , "l h-1";
        :denominator         :hour;
        :numerator           :litre;
        :symbol              "l/h" .

:cubic_metre_per_year
        rdf:type      owl:NamedIndividual , :Unit_division;
        rdfs:label    "kubieke meter per jaar"@nl , "cubic metre per year"@en;
        :denominator  :year;
        :dimension    :volumetric_flow_rate-dimension;
        :numerator    :cubic_metre .

:cubic_metre_per_second-time
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "kubieke meter per seconde"@nl , "cubic metre per second"@en;
        :alternative_symbol  "m3·s-1" , "m3 s-1";
        :denominator         :second-time;
        :dimension           :volumetric_flow_rate-dimension;
        :numerator           :cubic_metre;
        :symbol              "m3/s" .

:volumetric_flow_rate-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "volumetric flow rate dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  3;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    -1 .

:Volumetric_flow_rate_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :cubic_metre_per_second-time :cubic_metre_per_year :litre_per_hour )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :cubic_metre_per_second-time :cubic_metre_per_year :litre_per_hour )
                             ] .

:Volumetric_flow_rate
        rdf:type            owl:NamedIndividual , owl:Class;
        rdfs:label          "volumetric flow rate"@en;
        rdfs:subClassOf     :Quantity;
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :volumetric_flow_rate-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Volumetric_flow_rate_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :volumetric_flow_rate-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Volumetric_flow_rate_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        :alternative_label  "volume flow rate"@en , "volume flow"@en , "flow rate"@en;
        :unit_of_measure    :litre_per_hour , :cubic_metre_per_year , :cubic_metre_per_second-time .

