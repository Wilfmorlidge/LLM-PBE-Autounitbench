                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :acre_foot :barrel-US :bushel-US :cord :cubic_kiloparsec :cubic_metre :cubic_parsec :cup-US_customary :dry_gallon-US :dry_pint-US :dry_quart-US :fluid_ounce-Imperial :fluid_ounce-US :gallon-Imperial :gallon-US :gill-Imperial :gill-US :liquid_pint-US :liquid_quart-US :litre :peck-US :pint-Imperial :quart-Imperial :stere :tablespoon-US :teaspoon-US :ton-register )
