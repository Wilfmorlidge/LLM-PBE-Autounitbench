                                                                                                                                                            ) ;
                                                                                                                                         rdf:type owl:Class
                                                                                                                                       ]
                                                                                                                  ]
                                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                                    owl:onProperty KiReSOntFM:hasPhase ;
                                                                                                                    owl:someValuesFrom [ owl:intersectionOf ( <http://bdi.si.ehu.es/bdi/ontologies/KiReSOnt#Phase2FlexGlenoJ>
                                                                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                                                                owl:onProperty KiReSOntFM:hasPhaseNum ;
                                                                                                                                                                owl:hasValue "2"^^xsd:int
                                                                                                                                                              ]
                                                                                                                                                            ) ;
                                                                                                                                         rdf:type owl:Class
                                                                                                                                       ]
                                                                                                                  ]
                                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                                    owl:onProperty KiReSOntFM:hasPhase ;
                                                                                                                    owl:someValuesFrom [ owl:intersectionOf ( <http://bdi.si.ehu.es/bdi/ontologies/KiReSOnt#Phase3FlexGlenoJ>
                                                                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                                                                owl:onProperty KiReSOntFM:hasPhaseNum ;
                                                                                                                                                                owl:hasValue "3"^^xsd:int
                                                                                                                                                              ]
                                                                                                                                                            ) ;
                                                                                                                                         rdf:type owl:Class
                                                                                                                                       ]
                                                                                                                  ]
                                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                                    owl:onProperty KiReSOntFM:hasPhase ;
                                                                                                                    owl:someValuesFrom [ owl:intersectionOf ( <http://bdi.si.ehu.es/bdi/ontologies/KiReSOnt#Phase4FlexGlenoJ>
                                                                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                                                                owl:onProperty KiReSOntFM:hasPhaseNum ;
                                                                                                                                                                owl:hasValue "4"^^xsd:int
                                                                                                                                                              ]
                                                                                                                                                            ) ;
                                                                                                                                         rdf:type owl:Class
                                                                                                                                       ]
                                                                                                                  ]
                                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                                    owl:onProperty KiReSOntFM:hasPhase ;
                                                                                                                    owl:someValuesFrom [ owl:intersectionOf ( <http://bdi.si.ehu.es/bdi/ontologies/KiReSOnt#Phase5FlexGlenoJ>
                                                                                                                                                              [ rdf:type owl:Restriction ;
                                                                                                                                                                owl:onProperty KiReSOntFM:hasPhaseNum ;
                                                                                                                                                                owl:hasValue "5"^^xsd:int
                                                                                                                                                              ]
                                                                                                                                                            ) ;
                                                                                                                                         rdf:type owl:Class
                                                                                                                                       ]
                                                                                                                  ]
                                                                                                                ) ;
                                                                                             rdf:type owl:Class
                                                                                           ] ;
                                                                       rdfs:subClassOf KiReSOntFM:TreatmentProtocol ;
                                                                       rdfs:comment "Treatment protocol for the limited flexion of the glenohumeral joint" ;
                                                                       rdfs:label "TreatmentProtFlexGlenoJ"@en .


