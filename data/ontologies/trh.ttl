###  http://purl.org/sig/ont/fma/fma24874
fma:fma24874 rdf:type owl:Class ;
             rdfs:subClassOf fma:fma9661 ;
             fma:FMAID "24874" ;
             fma:definition "Limb segment which connects the free limb to the trunk; it is demarcated by the plane of the surfaces of the glenoid and acetabular fossae from the free limb; together with the free limb, it constitutes the limb. Examples: There are only four instances, right and left pectoral girdles and right and left pelvic girdles." ;
             fma:preferred_name "Limb girdle" ;
             rdfs:label "Limb girdle"@en .

