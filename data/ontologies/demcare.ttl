<http://www.demcare.eu/ontologies/combined.owl> a owl:Ontology .
<http://www.demcare.eu/ontologies/combined.owl#highlight>
  a owl:AnnotationProperty, owl:DatatypeProperty ;
  rdfs:range xsd:boolean ;
