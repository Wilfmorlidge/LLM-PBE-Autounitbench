        :symbol       "Gy" .

:Gray_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :gray;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :gray;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:gray_per_second-time
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "gray per seconde"@nl , "gray per second"@en;
        :alternative_symbol  "Gy·s-1" , "Gy s-1";
        :denominator         :second-time;
        :dimension           :absorbed_dose_rate-dimension;
        :numerator           :gray;
        :symbol              "Gy/s" .

:absorbed_dose_rate-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "absorbed dose rate dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  2;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    -3 .

:Absorbed_dose_rate_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :gray_per_second-time )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :gray_per_second-time )
                             ] .

:Absorbed_dose_rate  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label        "absorbed dose rate"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :absorbed_dose_rate-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Absorbed_dose_rate_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :absorbed_dose_rate-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Absorbed_dose_rate_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :unit_of_measure  :gray_per_second-time .

:specific_energy_or_absorbed_dose_or_dose_equivalent-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "specific energy, absorbed dose, or dose equivalent dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  2;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    0;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    -2 .

:Absorbed_dose_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Gray_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :gray :joule_per_kilogram :kilojoule_per_hectogram :rad )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Gray_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :gray :joule_per_kilogram :kilojoule_per_hectogram :rad )
                                              ]
                                            )
                             ] .

:Absorbed_dose  rdf:type    owl:Class , owl:NamedIndividual;
        rdfs:comment        "Absorbed dose is the energy deposited in a medium by ionizing radiation. It is a derived quantity in the International System of Units. Absorbed dose is energy divided by mass."@en;
        rdfs:label          "absorbed dose"@en;
        rdfs:subClassOf     :Quantity;
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :specific_energy_or_absorbed_dose_or_dose_equivalent-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Absorbed_dose_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :specific_energy_or_absorbed_dose_or_dose_equivalent-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Absorbed_dose_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        :alternative_label  "total ionizing dose"@en;
        :unit_of_measure    :teragray , :picogray , :petagray , :nanogray , :milligray , :microgray , :megagray , :kilogray , :gray , :joule_per_kilogram , :rad , :attogray , :centigray , :decagray , :decigray , :exagray , :femtogray , :gigagray , :hectogray .

:Magnitude  rdf:type      owl:Class , owl:NamedIndividual;
        rdfs:comment      "Reverse logarithmic measure of the brightness of an object."@en;
        rdfs:label        "magnitude"@en , "magnitude"@nl;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Magnitude_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Magnitude_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/Astrophysical_Techniques_chapter3> , <http://www.wurvoc.org/bibliography/om-1.8/IntroAstronomicalPhotometry_chapter_2>;
        :longcomment      "The magnitude scale was originally created by Hipparchos of Nicea (160-127 BCE) and was measured by comparing the brightness between stars. Initially this was done inaccurately by eye but is currently done by using photoelectric photometers or even more recently by CCDs. Hipparchos divided the stars into six magnitude (brightness classes), the brightest stars being assigned to the first class and the faintest to the sixth class. By about the middle 1800s it became apparent that the traditional magnitude scale is close to a logarithmic scale with base 2.5. This is due to the fact that the response of the eye is nearly logarithmic. N.R. Pogson formalised the magnitude scale to closely match the traditional (visual) scale. It is now defined as:  \n    <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\">\n   \t\t<msub xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi xmlns=\"http://www.w3.org/1998/Math/MathML\">m</mi><mn xmlns=\"http://www.w3.org/1998/Math/MathML\">1</mn></msub> <mo xmlns=\"http://www.w3.org/1998/Math/MathML\">-</mo> <msub xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi xmlns=\"http://www.w3.org/1998/Math/MathML\">m</mi><mn xmlns=\"http://www.w3.org/1998/Math/MathML\">2</mn>  </msub><mo xmlns=\"http://www.w3.org/1998/Math/MathML\">=</mo> \n   \t\t<mn xmlns=\"http://www.w3.org/1998/Math/MathML\">-2.5</mn><mi xmlns=\"http://www.w3.org/1998/Math/MathML\">log</mi>\n    \t<mfrac xmlns=\"http://www.w3.org/1998/Math/MathML\" linethickness=\"1\">\n    \t\t<mrow xmlns=\"http://www.w3.org/1998/Math/MathML\">\n    \t\t\t<msub xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi xmlns=\"http://www.w3.org/1998/Math/MathML\">f</mi><mn xmlns=\"http://www.w3.org/1998/Math/MathML\">1</mn></msub>\n    \t\t</mrow>\n    \t\t<mrow xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi xmlns=\"http://www.w3.org/1998/Math/MathML\">f</mi><mn xmlns=\"http://www.w3.org/1998/Math/MathML\">2</mn></msub>\n    \t\t</mrow>\n    \t</mfrac>\n    </math>\n    where <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><msub xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi xmlns=\"http://www.w3.org/1998/Math/MathML\">m</mi><mn xmlns=\"http://www.w3.org/1998/Math/MathML\">1</mn></msub> <mo xmlns=\"http://www.w3.org/1998/Math/MathML\">-</mo> <msub xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi xmlns=\"http://www.w3.org/1998/Math/MathML\">m</mi><mn xmlns=\"http://www.w3.org/1998/Math/MathML\">2</mn>  </msub></math> is the magnitude difference between two objects, and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><msub xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi xmlns=\"http://www.w3.org/1998/Math/MathML\">f</mi><mn xmlns=\"http://www.w3.org/1998/Math/MathML\">1</mn></msub></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><msub xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi xmlns=\"http://www.w3.org/1998/Math/MathML\">f</mi><mn xmlns=\"http://www.w3.org/1998/Math/MathML\">2</mn></msub></math> are the luminous fluxes of the two objects. The magnitude of Vega (α Lyrae, HD 172167) is defined to be 0 in all wavelengths and passbands, although in practice this can only be an approximation. The zero point is now defined using multiple standard stars from the north polar sequence (non-variable stars within 2 degrees of the north celestial pole) or secondary standard stars from other parts of the sky. Please note that the scale is inverted, objects of magnitude 1 have a higher luminous flux than objects of magnitude 5. Stars of magnitude 6 are just visible to the naked eye under good observing conditions.\n    The units of magnitude, also called magnitude, are usually not indicated except when indicating small magnitude differences when milli- or micromagnitudes are used.";
        :symbol           "m";
        :unit_of_measure  :one , :magnitude , :micromagnitude , :millimagnitude .

:Absolute_magnitude  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "Logarithmic measure of the brightness of an object as seen from a standard distance of 10 pc. Units usually not indicated ("@en;
        rdfs:label        "absolute magnitude"@nl , "absolute magnitude"@en;
        rdfs:subClassOf   :Magnitude;
        :symbol           "M";
        :unit_of_measure  :millimagnitude , :micromagnitude , :magnitude , :one .

:Bolometric_magnitude
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "The magnitude of a star measured across all wavelengths, so that it takes into account the total amount of energy radiated. If a star is a strong infrared or ultraviolet emitter, its bolometric magnitude  will differ greatly from its visual magnitude."@en;
        rdfs:label        "bolometric magnitude"@en;
        rdfs:subClassOf   :Magnitude;
        :symbol           "m_bol";
        :unit_of_measure  :magnitude .

:Absolute_bolometric_magnitude
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "The absolute magnitude (see absolute magnitude) of a star is a measure of its total energy emission per second, or luminosity, i.e., the bolometric magnitude from a standard distance (10 pc)."@en;
        rdfs:label        "absolute bolometric magnitude"@en;
        rdfs:subClassOf   :Bolometric_magnitude;
        :symbol           "M_bol";
        :unit_of_measure  :magnitude .

:Absolute_activity  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "absolute activity"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "λ" .

:Aberration_in_longitude
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "The apparent angular displacement in ecliptical longitude of the observed position of a celestial object from its geometric position, caused by the finite velocity of light in combination with the motions of the observer and of the observed object."@en;
        rdfs:label        "aberration in longitude"@en;
        rdfs:subClassOf   :Angular_displacement;
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/chapter23_Astronomical_Algorithms>;
        :symbol           "Δλ";
        :unit_of_measure  :second-plane_angle , :millisecond-plane_angle , :microsecond-plane_angle , :degree .

:Aberration_in_latitude
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "The apparent angular displacement in ecliptical latitude of the observed position of a celestial object from its geometric position, caused by the finite velocity of light in combination with the motions of the observer and of the observed object."@en;
        rdfs:label        "aberration in latitude"@en;
        rdfs:subClassOf   :Angular_displacement;
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/chapter23_Astronomical_Algorithms>;
        :symbol           "Δβ";
        :unit_of_measure  :second-plane_angle , :millisecond-plane_angle , :microsecond-plane_angle , :degree .

:Angular_displacement
        rdf:type          owl:Class , owl:NamedIndividual;
        rdfs:label        "angular displacement"@en;
        rdfs:subClassOf   :Plane_angle;
        :unit_of_measure  :picoradian , :nanoradian , :milliradian , :microradian , :femtoradian , :degree , :gon , :metre_per_metre , :microsecond-plane_angle , :mil-plane_angle , :millisecond-plane_angle , :minute-plane_angle , :radian , :revolution , :second-plane_angle , :attoradian , :centiradian , :deciradian .

:Aberration  rdf:type     owl:NamedIndividual , owl:Class;
        rdfs:comment      "The apparent angular displacement of the observed position of a celestial object from its geometric position, caused by the finite velocity of light in combination with the motions of the observer and of the observed object."@en;
        rdfs:label        "aberration"@en;
        rdfs:subClassOf   :Angular_displacement;
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/Glossary_Astronomical_Almanac>;
        :unit_of_measure  :second-plane_angle , :millisecond-plane_angle , :microsecond-plane_angle , :degree .

rdf:Seq  rdf:type  owl:Class .

<http://purl.org/ontology/bibo/Thesis>
        rdf:type  owl:Class .

<http://purl.org/ontology/bibo/Standard>
        rdf:type  owl:Class .

<http://purl.org/ontology/bibo/Journal>
        rdf:type  owl:Class .

<http://purl.org/ontology/bibo/Chapter>
        rdf:type  owl:Class .

<http://purl.org/ontology/bibo/BookSection>
        rdf:type  owl:Class .

<http://purl.org/ontology/bibo/Book>
        rdf:type  owl:Class .

<http://purl.org/ontology/bibo/Article>
        rdf:type  owl:Class .

:Ordered_measurement_scale_category
        rdf:type         owl:Class;
        rdfs:label       "ordered measurement scale category"@en;
        rdfs:subClassOf  :Measurement_scale_category .

:rank   rdf:type            owl:DatatypeProperty , owl:FunctionalProperty;
        rdfs:domain         :Ordered_measurement_scale_category;
        rdfs:label          "rank"@en;
        rdfs:range          xsd:integer;
        :alternative_label  "has rank"@en .

:numerical_value  rdf:type  owl:DatatypeProperty;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( :Measure :Point )
                            ];
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( :Measure :Point )
                            ];
        rdfs:label          "numerical value"@en;
        :alternative_label  "has numerical value"@en .

:factor  rdf:type           owl:DatatypeProperty , owl:FunctionalProperty;
        rdfs:domain         :Prefix;
        rdfs:label          "factor"@en;
        rdfs:range          xsd:float;
        :alternative_label  "has factor"@en .

:exponent  rdf:type         owl:DatatypeProperty , owl:FunctionalProperty;
        rdfs:domain         :Unit_exponentiation;
        rdfs:label          "exponent"@en;
        rdfs:range          xsd:integer;
        :alternative_label  "has exponent"@en .

:definition_off-set  rdf:type  owl:DatatypeProperty;
        rdfs:domain         :Measurement_scale;
        rdfs:label          "definition off-set"@en;
        rdfs:range          xsd:float;
        :alternative_label  "has definition off-set"@en .

:definition_factor  rdf:type  owl:DatatypeProperty;
        rdfs:domain         :Measurement_scale;
        rdfs:label          "definition factor"@en;
        rdfs:range          xsd:float;
        :alternative_label  "has definition factor"@en .

:SI_time_dimension_exponent
        rdf:type            owl:DatatypeProperty;
        rdfs:domain         :Dimension;
        rdfs:label          "SI time dimension exponent"@en;
        rdfs:range          xsd:integer;
        :alternative_label  "has SI time dimension exponent"@en .

:SI_thermodynamic_temperature_dimension_exponent
        rdf:type            owl:DatatypeProperty;
        rdfs:domain         :Dimension;
        rdfs:label          "SI thermodynamic temperature dimension exponent"@en;
        rdfs:range          xsd:integer;
        :alternative_label  "has SI thermodynamic temperature dimension exponent"@en .

:SI_mass_dimension_exponent
        rdf:type            owl:DatatypeProperty;
        rdfs:domain         :Dimension;
        rdfs:label          "SI mass dimension exponent"@en;
        rdfs:range          xsd:integer;
        :alternative_label  "has SI mass dimension exponent"@en .

:SI_luminous_intensity_dimension_exponent
        rdf:type            owl:DatatypeProperty;
        rdfs:domain         :Dimension;
        rdfs:label          "SI luminous intensity dimension exponent"@en;
        rdfs:range          xsd:integer;
        :alternative_label  "has SI luminous intensity dimension exponent"@en .

:SI_length_dimension_exponent
        rdf:type            owl:DatatypeProperty;
        rdfs:domain         :Dimension;
        rdfs:label          "SI length dimension exponent"@en;
        rdfs:range          xsd:integer;
        :alternative_label  "has SI length dimension exponent"@en .

:SI_electric_current_dimension_exponent
        rdf:type            owl:DatatypeProperty;
        rdfs:domain         :Dimension;
        rdfs:label          "SI electric current dimension exponent"@en;
        rdfs:range          xsd:integer;
        :alternative_label  "has SI electric current dimension exponent"@en .

:SI_amount_of_substance_dimension_exponent
        rdf:type            owl:DatatypeProperty;
        rdfs:domain         :Dimension;
        rdfs:label          "SI amount of substance dimension exponent"@en;
        rdfs:range          xsd:integer;
        :alternative_label  "has SI amount of substance dimension exponent"@en .

:Fixed_zero_point  rdf:type  owl:Class;
        rdfs:label       "fixed zero point"@en;
        rdfs:subClassOf  :Fixed_point;
        rdfs:subClassOf  [ rdf:type        owl:Restriction;
                           owl:hasValue    "0";
                           owl:onProperty  :numerical_value
                         ];
        rdfs:subClassOf  [ rdf:type        owl:Restriction;
                           owl:hasValue    "0";
                           owl:onProperty  :numerical_value
                         ] .

:Ratio_scale  rdf:type   owl:Class;
        rdfs:label       "ratio scale"@en;
        rdfs:subClassOf  :Cardinal_scale .

:zero_element  rdf:type     owl:ObjectProperty;
        rdfs:domain         :Ratio_scale;
        rdfs:label          "zero element"@en;
        rdfs:range          :Fixed_zero_point;
        :alternative_label  "has zero element"@en .

:Vectorial_or_tensorial_character
        rdf:type      owl:Class;
        rdfs:comment  "A quantity has vectorial or tensorial character: scalar, vector, matrix or tensor."@en;
        rdfs:label    "vectorial or tensorial character"@en .

:vectorial_or_tensorial_character
        rdf:type            owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:domain         :Quantity;
        rdfs:label          "vectorial or tensorial character"@en;
        rdfs:range          :Vectorial_or_tensorial_character;
        :alternative_label  "has vectorial or tensorial character"@en .

:value  rdf:type     owl:ObjectProperty;
        rdfs:domain  :Quantity;
        rdfs:label   "value"@en;
        rdfs:range   :Measure .

:uses_application_area
        rdf:type     owl:ObjectProperty;
        rdfs:domain  :Application_area;
        rdfs:label   "uses application area"@en;
        rdfs:range   :Application_area .

:Measure  rdf:type    owl:Class;
        rdfs:comment  "A measure combines a number to a unit of measure or an interval or ratio scale. For example, \"3 m\" is a measure."@en;
        rdfs:label    "measure"@en .

:unit_of_measure_or_measurement_scale
        rdf:type            owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:domain         :Measure;
        rdfs:label          "unit of measure or measurement scale"@en;
        rdfs:range          [ rdf:type     owl:Class;
                              owl:unionOf  ( :Measurement_scale :Unit_of_measure )
                            ];
        rdfs:range          [ rdf:type     owl:Class;
                              owl:unionOf  ( :Measurement_scale :Unit_of_measure )
                            ];
        :alternative_label  "has unit of measure or measurement scale"@en .

:Cardinal_scale  rdf:type  owl:Class;
        rdfs:label       "cardinal scale"@en;
        rdfs:subClassOf  :Measurement_scale;
        rdfs:subClassOf  [ rdf:type           owl:Restriction;
                           owl:allValuesFrom  :Fixed_point;
                           owl:onProperty     :element
                         ];
        rdfs:subClassOf  [ rdf:type           owl:Restriction;
                           owl:allValuesFrom  :Fixed_point;
                           owl:onProperty     :element
                         ] .

:unit_of_measure  rdf:type  owl:ObjectProperty;
        rdfs:comment        "For quantity classes this property indicates a commonly-used unit.";
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( :Application_area :Cardinal_scale :Quantity )
                            ];
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( :Application_area :Cardinal_scale :Quantity )
                            ];
        rdfs:label          "unit of measure"@en;
        rdfs:range          :Unit_of_measure;
        :alternative_label  "has unit of measure"@en .

:term_2  rdf:type           owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:domain         :Unit_multiplication;
        rdfs:label          "term 2"@en;
        rdfs:range          :Unit_of_measure;
        :alternative_label  "has term 2"@en .

:Unit_multiplication  rdf:type  owl:Class;
        rdfs:label           "unit multiplication"@en;
        rdfs:subClassOf      :Compound_unit;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :term_1
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :term_2
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :term_1
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :term_2
                                                     ]
                                                   )
                             ] .

:term_1  rdf:type           owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:domain         :Unit_multiplication;
        rdfs:label          "term 1"@en;
        rdfs:range          :Unit_of_measure;
        :alternative_label  "has term 1"@en .

:Singular_unit  rdf:type  owl:Class;
        rdfs:label       "singular unit"@en;
        rdfs:subClassOf  :Unit_of_measure;
        rdfs:subClassOf  [ rdf:type           owl:Restriction;
                           owl:allValuesFrom  [ rdf:type     owl:Class;
                                                owl:unionOf  ( :Measure :Quantity :Unit_of_measure )
                                              ];
                           owl:onProperty     :definition
                         ];
        rdfs:subClassOf  [ rdf:type           owl:Restriction;
                           owl:allValuesFrom  [ rdf:type     owl:Class;
                                                owl:unionOf  ( :Measure :Quantity :Unit_of_measure )
                                              ];
                           owl:onProperty     :definition
                         ] .

:singular_unit  rdf:type    owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:domain         :Unit_multiple_or_submultiple;
        rdfs:label          "singular unit"@en;
        rdfs:range          :Singular_unit;
        :alternative_label  "has singular unit"@en .

:Phenomenon  rdf:type  owl:Class;
        rdfs:comment  "A phenomenon is the qualitative object (e.g., food, star, molecule) that has quantifiable (standardised) aspects (e.g, length, mass, time)."@en;
        rdfs:label    "phenomenon"@en .

:quantity  rdf:type         owl:ObjectProperty;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( :Application_area :Phenomenon )
                            ];
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( :Application_area :Phenomenon )
                            ];
        rdfs:label          "quantity"@en;
        rdfs:range          :Quantity;
        :alternative_label  "has quantity"@en .

:Prefix  rdf:type            owl:Class;
        rdfs:comment         "A prefix is a name that precedes a basic unit of measure to indicate a decimal multiple or fraction of the unit. Each prefix has a unique symbol that is prepended to the unit symbol. For example, an electric current of 0.000 000 001 ampere is written by using the SI-prefix nano as 1 nanoampere or 1 nA."@en;
        rdfs:label           "prefix"@en;
        owl:disjointUnionOf  ( :Binary_prefix :SI_prefix );
        owl:disjointUnionOf  ( :Binary_prefix :SI_prefix ) .

:Unit_multiple_or_submultiple
        rdf:type         owl:Class;
        rdfs:label       "unit multiple or submultiple"@en;
        rdfs:subClassOf  :Unit_of_measure;
        rdfs:subClassOf  [ rdf:type           owl:Restriction;
                           owl:allValuesFrom  [ rdf:type     owl:Class;
                                                owl:unionOf  ( :Measure :Quantity :Unit_of_measure )
                                              ];
                           owl:onProperty     :definition
                         ];
        rdfs:subClassOf  [ rdf:type           owl:Restriction;
                           owl:allValuesFrom  [ rdf:type     owl:Class;
                                                owl:unionOf  ( :Measure :Quantity :Unit_of_measure )
                                              ];
                           owl:onProperty     :definition
                         ] .

:prefix  rdf:type           owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:domain         :Unit_multiple_or_submultiple;
        rdfs:label          "prefix"@en;
        rdfs:range          :Prefix;
        :alternative_label  "has prefix"@en .

:phenomenon  rdf:type       owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:domain         :Quantity;
        rdfs:label          "phenomenon"@en;
        :alternative_label  "has phenomenon"@en .

:numerator  rdf:type        owl:ObjectProperty;
        rdfs:domain         :Unit_division;
        rdfs:label          "numerator"@en;
        rdfs:range          :Unit_of_measure;
        :alternative_label  "has numerator"@en .

:Point  rdf:type      owl:Class;
        rdfs:comment  "A point is an element of an interval scale or a ratio scale, for example, 273.16 on the Kelvin scale indicates the triple point of water thermodynamic temperature."@en;
        rdfs:label    "point"@en .

:Application_area  rdf:type  owl:Class;
        rdfs:comment  "An application area groups quantities and units of measure for application areas such as scientific disciplines (e.g., thermodynamics, mechanics)."@en;
        rdfs:label    "application area"@en .

:measurement_scale  rdf:type  owl:ObjectProperty;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( :Application_area :Point :Quantity )
                            ];
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( :Application_area :Point :Quantity )
                            ];
        rdfs:label          "measurement scale"@en;
        rdfs:range          :Measurement_scale;
        :alternative_label  "has measurement scale"@en .

:element  rdf:type          owl:ObjectProperty;
        rdfs:domain         :Measurement_scale;
        rdfs:label          "element"@en;
        rdfs:range          owl:Thing;
        :alternative_label  "has element"@en .

:Dimension  rdf:type  owl:Class;
        rdfs:comment  "Dimensions are abstract properties of units and quantities neglecting their vectorial or tensorial character and all numerical factors including their sign."@en;
        rdfs:label    "dimension"@en .

:dimension  rdf:type        owl:ObjectProperty;
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( :Measurement_scale :Quantity :Unit_of_measure )
                            ];
        rdfs:domain         [ rdf:type     owl:Class;
                              owl:unionOf  ( :Measurement_scale :Quantity :Unit_of_measure )
                            ];
        rdfs:label          "dimension"@en;
        rdfs:range          :Dimension;
        :alternative_label  "has dimension"@en .

:derived_unit  rdf:type     owl:ObjectProperty;
        rdfs:domain         :System_of_units;
        rdfs:label          "derived unit"@en;
        rdfs:range          :Unit_of_measure;
        :alternative_label  "has derived unit"@en .

:derived_quantity  rdf:type  owl:ObjectProperty;
        rdfs:domain         :System_of_units;
        rdfs:label          "derived quantity"@en;
        rdfs:range          :Quantity;
        :alternative_label  "has derived quantity"@en .

:Unit_division  rdf:type     owl:Class;
        rdfs:label           "unit division"@en;
        rdfs:subClassOf      :Compound_unit;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :denominator
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :numerator
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :denominator
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :numerator
                                                     ]
                                                   )
                             ] .

:denominator  rdf:type      owl:ObjectProperty;
        rdfs:domain         :Unit_division;
        rdfs:label          "denominator"@en;
        rdfs:range          :Unit_of_measure;
        :alternative_label  "has denominator"@en .

:definition_relative_to
        rdf:type            owl:ObjectProperty;
        rdfs:domain         :Measurement_scale;
        rdfs:label          "definition relative to"@en;
        rdfs:range          :Measurement_scale;
        :alternative_label  "has definition relative to"@en .

:definition  rdf:type       owl:ObjectProperty;
        rdfs:label          "definition"@en;
        :alternative_label  "has definition"@en .

:base_unit  rdf:type        owl:ObjectProperty;
        rdfs:domain         :System_of_units;
        rdfs:label          "base unit"@en;
        rdfs:range          :Unit_of_measure;
        :alternative_label  "has base unit"@en .

:Quantity  rdf:type   owl:Class;
        rdfs:comment  "A quantity is a representation of a quantifiable (standardised) aspect (such as length, mass, and time) of a phenomenon (e.g., a star, food, or a molecule). Quantities are classified according to similarity in (implicit) metrological aspect, e.g. the length of my speedboat and the length of my racing car are classified as length."@en;
        rdfs:label    "quantity"@en .

:System_of_units  rdf:type  owl:Class;
        rdfs:comment  "In order to achieve a coherent, interdependent set of units of measure in the wide variety of units that exist, units are organised in systems of units. A system of units is based on a set of units chosen by convention to be the system’s base units, units that are considered to be mutually independent (i.e., can’t be expressed in terms of each other)."@en;
        rdfs:label    "system of units"@en .

:base_quantity  rdf:type    owl:ObjectProperty;
        rdfs:domain         :System_of_units;
        rdfs:label          "base quantity"@en;
        rdfs:range          :Quantity;
        :alternative_label  "has base quantity"@en .

:Unit_of_measure  rdf:type   owl:Class;
        rdfs:comment         "A unit of measure is a definite magnitude of a quantity, defined and adopted by convention and/or by law. It is used as a standard for measurement of the same quantity, where any other value of the quantity can be expressed as a simple multiple of the unit of measure. For example, length is a quantity; the metre is a unit of length that represents a definite predetermined length. When we say 10 metre (or 10 m), we actually mean 10 times the definite predetermined length called \"metre\"."@en;
        rdfs:label           "unit of measure"@en;
        owl:disjointUnionOf  ( :Singular_unit :Unit_division :Unit_exponentiation :Unit_multiple_or_submultiple :Unit_multiplication );
        owl:disjointUnionOf  ( :Singular_unit :Unit_division :Unit_exponentiation :Unit_multiple_or_submultiple :Unit_multiplication );
        :alternative_label   "unit of measurement"@en , "unit"@en .

:Unit_exponentiation  rdf:type  owl:Class;
        rdfs:label           "unit exponentiation"@en;
        rdfs:subClassOf      :Compound_unit;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :base
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :exponent
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :base
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :exponent
                                                     ]
                                                   )
                             ] .

:base   rdf:type            owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:domain         :Unit_exponentiation;
        rdfs:label          "base"@en;
        rdfs:range          :Unit_of_measure;
        :alternative_label  "has base"@en .

<http://purl.org/ontology/bibo/Document>
        rdf:type  owl:Class .

<http://www.wurvoc.org/bibliography/om-1.8/reference>
        rdf:type     owl:FunctionalProperty , owl:ObjectProperty;
        rdfs:domain  <http://purl.org/ontology/bibo/Document>;
        rdfs:label   "reference"@en .

<http://xmlns.com/foaf/0.1/name>
        rdf:type  owl:AnnotationProperty .

<http://xmlns.com/foaf/0.1/based_near>
        rdf:type  owl:AnnotationProperty .

:unofficial_label  rdf:type  owl:AnnotationProperty;
        rdfs:comment        "Used to specify labels that are used in e.g. every day speech but are not defined in any standard. ";
        rdfs:label          "unofficial label"@en;
        rdfs:subPropertyOf  <http://www.w3.org/2004/02/skos/core#hiddenLabel>;
        :alternative_label  "has unofficial label"@en .

:unofficial_abbreviation
        rdf:type            owl:AnnotationProperty;
        rdfs:comment        "Used to specify abbreviations that are used in e.g. every day speech but are not defined in any standard. ";
        rdfs:label          "unofficial abbreviation"@en;
        rdfs:subPropertyOf  <http://www.w3.org/2004/02/skos/core#hiddenLabel>;
        :alternative_label  "has unofficial abbreviation"@en .

:symbol  rdf:type           owl:AnnotationProperty;
        rdfs:label          "symbol"@en;
        :alternative_label  "has symbol"@en .

:longcomment  rdf:type      owl:AnnotationProperty;
        rdfs:label          "longcomment"@en;
        :alternative_label  "long comment"@en , "has longcomment"@en .

:external_link  rdf:type    owl:AnnotationProperty;
        rdfs:label          "external link"@en;
        :alternative_label  "has external link"@en .

:Measurement_scale  rdf:type  owl:Class;
        rdfs:comment         "Measurement scales are concepts used for the expression of quantities. Four types of measurement scales are: nominal scales, ordinal scales, interval scales and ratio scales. The latter two scales are also called cardinal scales. An example of a scale is the Celsius scale, a temperature scale."@en;
        rdfs:label           "measurement scale"@en;
        owl:disjointUnionOf  ( :Interval_scale :Nominal_scale :Ordinal_scale :Ratio_scale );
        owl:disjointUnionOf  ( :Interval_scale :Nominal_scale :Ordinal_scale :Ratio_scale );
        :alternative_label   "scale"@en .

:definition_description
        rdf:type            owl:AnnotationProperty;
        rdfs:domain         :Measurement_scale;
        rdfs:label          "definition description"@en;
        rdfs:range          xsd:string;
        :alternative_label  "has definition description"@en .

:alternative_symbol  rdf:type  owl:AnnotationProperty;
        rdfs:label          "alternative symbol"@en;
        :alternative_label  "has alternative symbol"@en .

:alternative_LaTeX_symbol
        rdf:type            owl:AnnotationProperty;
        rdfs:comment        "An alternative OMLaTeX formatted symbol, which may include commands such as \\unit and \\E as defined in OMLaTeX."@en;
        rdfs:label          "alternative LaTeX symbol"@en;
        :alternative_label  "has alternative LaTeX symbol"@en , "alternative LaTeX formatted symbol"@en .

:alternativeLabel  rdf:type  owl:AnnotationProperty .

:abbreviation  rdf:type     owl:AnnotationProperty;
        rdfs:label          "abbreviation"@en;
        :alternative_label  "has abbreviation"@en .

:LaTeX_symbol  rdf:type     owl:AnnotationProperty;
        rdfs:comment        "OMLaTeX formatted symbol may include commands such as \\unit and \\E as defined in OMLaTeX."@en;
        rdfs:label          "LaTeX symbol"@en;
        :alternative_label  "has LaTeX symbol"@en , "LaTeX formatted symbol"@en .

:alternative_label  rdf:type  owl:AnnotationProperty;
        rdfs:label  "alternative label"@en .

:LaTeX_command  rdf:type    owl:AnnotationProperty;
        rdfs:comment        "OMLaTeX command that can be used to render this quantity or unit."@en;
        rdfs:label          "LaTeX command"@en;
        :alternative_label  "typeset by LaTeX command"@en .

