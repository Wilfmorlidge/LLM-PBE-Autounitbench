        :dimension           :electrical_resistance-dimension;
        :numerator           :volt;
        :symbol              "V/A" .

:statohm  rdf:type    owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The statohm is a unit of electrical resistance defined as 8.987552e11 ohm."@en;
        rdfs:label    "statohm"@nl , "statohm"@en;
        :definition   :_8.987552e11_ohm;
        :dimension    :electrical_resistance-dimension;
        :symbol       "statΩ" .

:ohm    rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The ohm is a unit of electrical resistance defined as volt divided by ampere = square metre times kilogram divided by second to the power 3 times ampere squared."@en;
        rdfs:label    "ohm"@nl , "ohm"@en;
        :definition   :volt_per_ampere;
        :dimension    :electrical_resistance-dimension;
        :longcomment  "The ohm is a unit of electrical resistance defined as volt divided by ampere = square metre times kilogram divided by second to the power 3 times ampere squared. The ohm is a derived unit in the International System of Units.";
        :symbol       "Ω" .

:abohm  rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The abohm is a unit of electrical resistance defined as 1.0e-9 ohm."@en;
        rdfs:label    "abohm"@nl , "abohm"@en;
        :definition   :_1.0e-9_ohm;
        :dimension    :electrical_resistance-dimension;
        :symbol       "abΩ" .

:Ohm_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
