:LyricsWriting rdf:type owl:NamedIndividual ,
                        :CreativeTask ;
               rdfs:label "Lyrics writing"@en .


###  https://w3id.org/polifonia/ontology/music-meta/MusicWriting
:MusicWriting rdf:type owl:NamedIndividual ,
                       :CreativeTask ;
              rdfs:label "Music Writing"@en .


###  https://w3id.org/polifonia/ontology/music-meta/Orchestration
:Orchestration rdf:type owl:NamedIndividual ,
                        :CreativeTask ;
               rdfs:label "Orchestration"@en .


#################################################################
#    Annotations
#################################################################

:Instrumentation rdfs:comment "The arrangement or combination of musical instruments used in a composition, performance, or recording. It describes the specific instruments, their roles, and how they interact to create the overall sound and texture of the music. It can include properties such as instruments used, roles, and techniques."@en ;
                 rdfs:label "Instrumentation"@en .


