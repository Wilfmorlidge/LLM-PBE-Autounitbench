  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#compliantInstructionsOrder> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:boolean
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#repetitions> ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
  ] .

<http://www.demcare.eu/ontologies/combined.owl#CognitiveLoadAssessment>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#ExperimentalAssessment>, [
    a owl:Restriction ;
