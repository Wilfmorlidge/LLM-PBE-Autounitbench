        rdfs:label           "fundamental translation vectors for the crystal lattice"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_symbol  "a_3" , "a_2" , "c" , "b" , "a";
        :symbol              "a_1" .

:Full_set_of_planes_in_a_lattice_equivalent_by_symmetry
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "full set of planes in a lattice equivalent by symmetry"@en;
        rdfs:subClassOf  :Quantity .

:Full_set_of_directions_in_a_lattice_equivalent_by_symmetry
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "full set of directions in a lattice equivalent by symmetry"@en;
        rdfs:subClassOf  :Quantity .

:Froude_number_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :one )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :one )
                             ] .

:Froude_number  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "The Froude number is a dimensionless number that compares inertial and gravitational forces. It may be used to quantify the resistance of an object moving through water, and compare objects of different sizes."@en;
        rdfs:label        "getal van Froude"@nl , "Froude number"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Froude_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Froude_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "Fr";
        :unit_of_measure  :one .

:Friction_coefficient
        rdf:type             owl:NamedIndividual , owl:Class;
        rdfs:label           "wrijvingscoëfficiënt"@nl , "friction coefficient"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_symbol  "f";
        :symbol              "μ" .

:Friction  rdf:type       owl:Class , owl:NamedIndividual;
        rdfs:comment      "Friction is a force that resists the relative motion of solid surfaces, fluid layers, or material elements sliding against each other."@en;
        rdfs:label        "friction"@en , "wrijving"@nl;
        rdfs:subClassOf   :Force;
        :unit_of_measure  :teranewton , :piconewton , :petanewton , :nanonewton , :millinewton , :micronewton , :meganewton , :kilonewton , :hectonewton , :giganewton , :femtonewton , :exanewton , :dyne , :kip , :metre_kilogram_per_second-time_squared , :newton , :pound-force , :poundal , :ton-force-short , :attonewton , :centinewton , :decanewton , :decinewton .

:reciprocal_year  rdf:type  owl:NamedIndividual , :Unit_exponentiation;
        rdfs:label  "reciprocal year"@en , "omgekeerd jaar"@nl;
        :base       :year;
        :dimension  :frequency-dimension;
        :exponent   -1;
        :symbol     "a-1" .

:reciprocal_minute-time
        rdf:type    owl:NamedIndividual , :Unit_exponentiation;
        rdfs:label  "reciprocal minute"@en , "omgekeerde minuut"@nl;
