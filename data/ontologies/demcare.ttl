  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#gender> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onClass <http://www.demcare.eu/ontologies/combined.owl#GenderType>
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#dateOfBirth> ;
    owl:allValuesFrom xsd:dateTime
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#educationLevel> ;
    owl:allValuesFrom rdfs:Literal
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#size> ;
    owl:allValuesFrom rdfs:Literal
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#dateOfBirth> ;
    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:dateTime
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#educationLevel> ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
  ], [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#size> ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
  ] .

<http://www.demcare.eu/ontologies/combined.owl#DiagnosisAssessment>
  a owl:Class ;
  rdfs:subClassOf <http://www.demcare.eu/ontologies/combined.owl#ClinicalAssessment>, [
    a owl:Restriction ;
    owl:onProperty <http://www.demcare.eu/ontologies/combined.owl#hasClinicalDiagnosis> ;
    owl:allValuesFrom <http://www.demcare.eu/ontologies/combined.owl#DiagnosisType>
