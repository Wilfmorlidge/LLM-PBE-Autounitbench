        :unit_of_measure  :magnitude .

:Extinction  rdf:type     owl:NamedIndividual , owl:Class;
        rdfs:comment      "Total extinction at a specific wavelength. The extinction is caused by dust and gas between a star and the observer. It is the difference between the observed magnitude and the magnitude the source would have had if no extinction had taken place."@en;
        rdfs:label        "extinction"@en , "extinctie"@nl;
        rdfs:subClassOf   :Quantity;
        :symbol           "A";
        :unit_of_measure  :magnitude .

:External_browning  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment        "Voorbeeld avocado Hass: poster (code)."@nl;
        rdfs:label          "external browning"@en;
        rdfs:subClassOf     :Quantity;
        :alternative_label  "ext_brown"@en;
        :unit_of_measure    :_1-5 .

:Extent_of_reaction  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "extent of reaction"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "ξ" .

:röntgen  rdf:type    owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The röntgen is a unit of exposure to x and γ rays defined as 2.58e-4 coulomb per kilogram."@en;
        rdfs:label    "röntgen"@nl , "röntgen"@en;
        :definition   :_2.58e-4_coulomb_per_kilogram;
        :dimension    :exposure_to_x_and_gamma_rays-dimension;
        :symbol       "R" .

:coulomb_per_kilogram
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "coulomb per kilogram"@nl , "coulomb per kilogram"@en;
        :alternative_symbol  "C·kg-1" , "C kg-1";
        :denominator         :kilogram;
        :dimension           :exposure_to_x_and_gamma_rays-dimension;
        :numerator           :coulomb;
        :symbol              "C/kg" .

:exposure_to_x_and_gamma_rays-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "exposure to x and γ rays dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                1;
        :SI_length_dimension_exponent  0;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    -1;
        :SI_thermodynamic_temperature_dimension_exponent
                0;
        :SI_time_dimension_exponent    1 .

:Exposure_to_x_and_gamma_rays_unit
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :coulomb_per_kilogram :röntgen )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :coulomb_per_kilogram :röntgen )
                             ] .

:Exposure_to_x_and_gamma_rays
        rdf:type            owl:NamedIndividual , owl:Class;
        rdfs:label          "exposure to x and γ rays"@en;
        rdfs:subClassOf     :Quantity;
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :exposure_to_x_and_gamma_rays-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Exposure_to_x_and_gamma_rays_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :exposure_to_x_and_gamma_rays-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Exposure_to_x_and_gamma_rays_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        :alternative_label  "exposure to x and gamma rays"@en , "exposure (to x and γ rays)"@en , "exposure (to x and gamma rays)"@en , "exposure"@en;
        :unit_of_measure    :röntgen , :coulomb_per_kilogram .

:Expectation_value_of_A
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "expectation value of A"@en;
        rdfs:subClassOf  :Quantity .

:Exchange_integral  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "exchange integral"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "J" .

:Euler_number_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :one )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :one )
                             ] .

:Euler_number  rdf:type   owl:NamedIndividual , owl:Class;
        rdfs:comment      "The Euler number is a dimensionless number that expresses the relationship between a local pressure drop e.g. over a restriction and the kinetic energy per unit volume."@en;
        rdfs:label        "getal van Euler"@nl , "Euler number"@en;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Euler_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :dimension_one;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Euler_number_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "Eu";
        :unit_of_measure  :one .

:Ettinghausen_coefficient
        rdf:type             owl:NamedIndividual , owl:Class;
        rdfs:label           "Ettinghausen coefficient"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_symbol  "P_E";
        :symbol              "A_E" .

:Equilibrium_position_vector_of_an_ion
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "equilibrium position vector of an ion"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "R_0" .

:Equilibrium_constant
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "equilibrium_constant"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "K" .

:Epoch_at_maximum_brightness
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "A moment when the object (i.e. a variable star) was at maximum brightness."@en;
        rdfs:label        "epoch at maximum brightness"@en;
        rdfs:subClassOf   :Epoch;
        :unit_of_measure  :year , :second-time .

:Epoch  rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:label        "epoch"@en;
        rdfs:subClassOf   :Date;
        :unit_of_measure  :year , :second-time .

:joule_per_kelvin  rdf:type  owl:NamedIndividual , :Unit_division;
        rdfs:label           "joule per kelvin"@nl , "joule per kelvin"@en;
        :alternative_symbol  "J·K-1" , "J K-1";
        :denominator         :kelvin;
        :dimension           :entropy_or_heat_capacity-dimension;
        :numerator           :joule;
        :symbol              "J/K" .

:Entropy_flow  rdf:type  owl:Class;
        rdfs:label       "entropy flow"@en;
        rdfs:subClassOf  :Quantity .

:entropy_or_heat_capacity-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "entropy or heat capacity dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                0;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  2;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    1;
        :SI_thermodynamic_temperature_dimension_exponent
                -1;
        :SI_time_dimension_exponent    -2 .

:Entropy_unit  rdf:type      owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :joule_per_kelvin )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :joule_per_kelvin )
                             ] .

:Entropy  rdf:type        owl:NamedIndividual , owl:Class;
        rdfs:comment      "Entropy is a measure of the unavailability of a system’s energy to do work."@en;
        rdfs:label        "熵单位"@zh , "entropy"@en , "entropie"@nl;
        rdfs:subClassOf   :Quantity;
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :entropy_or_heat_capacity-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Entropy_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        rdfs:subClassOf   [ rdf:type        owl:Restriction;
                            owl:hasValue    :entropy_or_heat_capacity-dimension;
                            owl:onProperty  :dimension
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                 owl:allValuesFrom  :Entropy_unit;
                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :symbol           "S";
        :unit_of_measure  :joule_per_kelvin .

:Enthalpy  rdf:type       owl:Class , owl:NamedIndividual;
        rdfs:comment      "Enthalpy is the sum of the internal energy of a system plus the product of the pressure-volume work done on the system."@en;
        rdfs:label        "enthalpie"@nl , "enthalpy"@en , "焓"@zh;
        rdfs:subClassOf   :Energy;
        :symbol           "H";
        :unit_of_measure  :terajoule , :picojoule , :petajoule , :nanojoule , :millijoule , :microjoule , :megajoule , :megaerg , :kilojoule , :kilocalorie-mean , :hectojoule , :gigajoule , :femtojoule , :exajoule , :decijoule , :decajoule , :centijoule , :attojoule , :ton_of_TNT , :therm-US , :therm-EC , :terawatt_hour , :quad , :newton_metre , :millinewton_metre , :micronewton_metre , :megaelectronvolt , :kilowatt_hour , :kiloelectronvolt , :joule , :gigaelectronvolt , :foot_poundal , :erg , :calorie-thermochemical , :calorie-International_Table , :calorie-20_C , :calorie-mean , :electronvolt , :British_thermal_unit-39_F , :British_thermal_unit-59_F , :British_thermal_unit-60_F , :British_thermal_unit-International_Table , :British_thermal_unit-mean , :British_thermal_unit-thermochemical , :calorie-15_C .

:ton_of_TNT  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The ton of TNT is a unit of energy defined as 4.184e9 joule."@en;
        rdfs:label    "ton of TNT"@en;
        :definition   :_4.184e9_joule;
        :dimension    :energy-dimension .

:therm-US  rdf:type         owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The US therm is a unit of energy defined as 1.054804e8 joule."@en;
        rdfs:label          "therm (US)"@en;
        :alternative_label  "US therm"@en;
        :definition         :_1.054804e8_joule;
        :dimension          :energy-dimension .

:therm-EC  rdf:type         owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The EC therm is a unit of energy defined as 1.05506e8 joule."@en;
        rdfs:label          "therm (EC)"@en;
        :alternative_label  "EC therm"@en;
        :definition         :_1.05506e8_joule;
        :dimension          :energy-dimension .

:terawatt_hour  rdf:type     owl:NamedIndividual , :Unit_multiplication;
        rdfs:label           "terawatt hour"@en;
        :alternative_label   "terawatthour"@en , "terawatt-hour"@en;
        :alternative_symbol  "TW·h" , "TWh";
        :dimension           :energy-dimension;
        :symbol              "TW h";
        :term_1              :terawatt;
        :term_2              :hour .

:quad   rdf:type        owl:NamedIndividual , :Singular_unit;
        rdfs:comment    "The quad is a unit of energy defined as 1.0e15 British thermal unit (International Table)."@en;
        rdfs:label      "quad"@en;
        :LaTeX_command  "\\quadUnit";
        :definition     :_1.0e15_British_thermal_unit-International_Table;
        :dimension      :energy-dimension .

:newton_metre  rdf:type      owl:NamedIndividual , :Unit_multiplication;
        rdfs:label           "newton metre"@en , "newton meter"@nl;
        :alternative_symbol  "N·m";
        :dimension           :energy-dimension;
        :symbol              "N m";
        :term_1              :newton;
        :term_2              :metre .

:millinewton_metre  rdf:type  owl:NamedIndividual , :Unit_multiplication;
        rdfs:label           "millinewton metre"@en , "millinewton meter"@nl;
        :alternative_symbol  "mN·m";
        :dimension           :energy-dimension;
        :symbol              "mN m";
        :term_1              :millinewton;
        :term_2              :metre .

:micronewton_metre  rdf:type  owl:NamedIndividual , :Unit_multiplication;
        rdfs:label           "micronewton metre"@en , "micronewton meter"@nl;
        :alternative_symbol  "μN·m";
        :dimension           :energy-dimension;
        :symbol              "μN m";
        :term_1              :micronewton;
        :term_2              :metre .

:megaelectronvolt  rdf:type  owl:NamedIndividual , :Unit_multiple_or_submultiple;
        rdfs:comment    "The megaelectronvolt is a unit of energy defined as 1.0e6 electronvolt."@en;
        rdfs:label      "megaelectronvolt"@nl , "megaelectronvolt"@en;
        :dimension      :energy-dimension;
        :prefix         :mega;
        :singular_unit  :electronvolt;
        :symbol         "MeV" .

:kilowatt_hour  rdf:type     owl:NamedIndividual , :Unit_multiplication;
        rdfs:label           "kilowatt hour"@en;
        :alternative_label   "kilowatthour"@en , "kilowatt-hour"@en;
        :alternative_symbol  "kW·h" , "kWh";
        :dimension           :energy-dimension;
        :symbol              "kW h";
        :term_1              :kilowatt;
        :term_2              :hour .

:kiloelectronvolt  rdf:type  owl:NamedIndividual , :Unit_multiple_or_submultiple;
        rdfs:comment    "The kiloelectronvolt is a unit of energy defined as 1.0e3 electronvolt."@en;
        rdfs:label      "kiloelectronvolt"@nl , "kiloelectronvolt"@en;
        :dimension      :energy-dimension;
        :prefix         :kilo;
        :singular_unit  :electronvolt;
        :symbol         "keV" .

:joule  rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The joule is a unit of energy defined as kilogram times square metre divided by second squared."@en;
        rdfs:label    "焦耳"@zh , "joule"@nl , "joule"@en;
        :definition   :newton_metre;
        :dimension    :energy-dimension;
        :longcomment  "The joule is a unit of energy defined as kilogram times square metre divided by second squared. The joule is a derived unit in the International System of Units.";
        :symbol       "J" .

:gigaelectronvolt  rdf:type  owl:NamedIndividual , :Unit_multiple_or_submultiple;
        rdfs:comment    "The gigaelectronvolt is a unit of energy defined as 1.0e9 electronvolt."@en;
        rdfs:label      "gigaelectronvolt"@nl , "gigaelectronvolt"@en;
        :dimension      :energy-dimension;
        :prefix         :giga;
        :singular_unit  :electronvolt;
        :symbol         "GeV" .

:foot_poundal  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The foot poundal is a unit of energy defined as 4.214011e-2 joule."@en;
        rdfs:label    "foot poundal"@en;
        :definition   :_4.214011e-2_joule;
        :dimension    :energy-dimension .

:erg    rdf:type      owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The erg is a unit of energy defined as 1.0e-7 joule."@en;
        rdfs:label    "尔格"@zh , "erg"@nl , "erg"@en;
        :definition   :_1.0e-7_joule;
        :dimension    :energy-dimension;
        :symbol       "erg" .

:calorie-thermochemical
        rdf:type            owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The thermochemical calorie is a unit of energy defined as 4.184 joule."@en;
        rdfs:label          "calorie (thermochemical)"@en;
        :LaTeX_symbol       "cal_{th}";
        :alternative_label  "thermochemical calorie"@en;
        :definition         :_4.184_joule;
        :dimension          :energy-dimension;
        :symbol             "cal_th" .

:calorie-International_Table
        rdf:type            owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The International Table calorie is a unit of energy defined as 4.1868 joule."@en;
        rdfs:label          "calorie (International Table)"@en;
        :LaTeX_symbol       "cal_{IT}";
        :alternative_label  "calorie (International Steam Table)"@en , "International Table calorie"@en , "International Steam Table calorie"@en;
        :definition         :_4.1868_joule;
        :dimension          :energy-dimension;
        :symbol             "cal_IT" .

:calorie-20_C  rdf:type     owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The 20 °C calorie is a unit of energy defined as 4.18190 joule."@en;
        rdfs:label          "calorie (20 °C)"@nl , "calorie (20 °C)"@en;
        :LaTeX_command      "\\calorieTwentyC";
        :LaTeX_symbol       "cal_{20}";
        :alternative_label  "20 °C calorie"@nl , "20 °C calorie"@en;
        :definition         :_4.18190_joule;
        :dimension          :energy-dimension;
        :symbol             "cal_20" .

:calorie-15_C  rdf:type     owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The 15 °C calorie is a unit of energy defined as 4.18580 joule."@en;
        rdfs:label          "calorie (15 °C)"@nl , "calorie (15 °C)"@en;
        :LaTeX_symbol       "cal_{15}";
        :alternative_label  "15 °C calorie"@nl , "15 °C calorie"@en;
        :definition         :_4.18580_joule;
        :dimension          :energy-dimension;
        :symbol             "cal_15" .

:British_thermal_unit-thermochemical
        rdf:type            owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The thermochemical British thermal unit is a unit of energy defined as 1.054350e3 joule."@en;
        rdfs:label          "英国热力单位（热力化学）"@zh , "British thermal unit (thermochemical)"@en;
        :LaTeX_symbol       "BTU_{th}";
        :alternative_label  "thermochemical British thermal unit"@en;
        :definition         :_1.054350e3_joule;
        :dimension          :energy-dimension;
        :symbol             "Btu_th" .

:British_thermal_unit-mean
        rdf:type            owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The mean British thermal unit is a unit of energy defined as 1.05587e3 joule."@en;
        rdfs:label          "英国热力单位（平均）"@zh , "British thermal unit (mean)"@en;
        :alternative_label  "mean British thermal unit"@en;
        :definition         :_1.05587e3_joule;
        :dimension          :energy-dimension;
        :symbol             "Btu" .

:British_thermal_unit-International_Table
        rdf:type            owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The International Table British thermal unit is a unit of energy defined as 1.055056e3 joule."@en;
        rdfs:label          "英国热力单位（国际表）"@zh , "British thermal unit (International Table)"@en;
