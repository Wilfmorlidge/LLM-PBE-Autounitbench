        :LaTeX_symbol    "L_{p}";
        :symbol          "L_p" .

:Sound_pressure_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :newton_per_square_metre )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :newton_per_square_metre )
                             ] .

