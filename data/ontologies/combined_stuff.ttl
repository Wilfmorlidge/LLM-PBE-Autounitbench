        rdf:type             owl:NamedIndividual , owl:Class;
        rdfs:label           "positive or negative ion diffusion coefficient"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_symbol  "D_-";
        :symbol              "D_+" .

:Position_vector  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:label        "positievector"@nl , "position vector"@en;
        rdfs:subClassOf   :Length;
        :symbol           "r";
        :unit_of_measure  :terametre , :picometre , :petametre , :nanometre , :millimetre , :micrometre , :megametre , :kilometre , :hectometre , :gigametre , :femtometre , :exametre , :decimetre , :decametre , :centimetre , :attometre , :yard-international , :rod-US , :parsec , :nautical_mile-international , :mile-statute , :mile-US_survey , :mil-length , :micron , :metre , :megaparsec , :light_year , :inch-international , :furlong-international , :foot-international , :foot-US_survey , :fermi , :fathom-US_survey , :cicero , :pica-ATA , :pica-Postscript , :pica-TeX , :point-ATA , :point-Didot , :point-Postscript , :point-TeX , :angstrom , :astronomical_unit , :chain .

:Polarization_vector  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "polarization vector"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "e" .

:Polarizability  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "polarizability"@en;
        rdfs:subClassOf  :Quantity .

:Poisson_ratio  rdf:type    owl:NamedIndividual , owl:Class;
        rdfs:label          "Poisson-factor"@nl , "Poisson ratio"@en;
        rdfs:subClassOf     :Quantity;
        :alternative_label  "factor van Poisson"@nl , "dwarscontractiecoëfficiënt"@nl , "Poisson ratio"@nl;
        :symbol             "r" .

:Plasma_pressure  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "plasma pressure"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "p" .

:Planetary_aberration
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "The apparent angular displacement of the observed position of a celestial object produced by the motion of the observer and the actual motion of the observed object."@en;
        rdfs:label        "planetary aberration"@en;
        rdfs:subClassOf   :Aberration;
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/Glossary_Astronomical_Almanac>;
        :unit_of_measure  :second-plane_angle , :millisecond-plane_angle , :microsecond-plane_angle , :degree .

:second-plane_angle  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The second (plane angle) is a unit of plane angle defined as 4.848137e-6 radian."@en;
        rdfs:label          "seconde (hoek)"@nl , "second (plane angle)"@en;
        :alternative_label  "second of arc"@en , "second (angle)"@en , "boogseconde"@nl , "arcsecond"@en;
        :definition         :_4.848137e-6_radian;
        :dimension          :dimension_one;
        :symbol             "\"" .

:revolution  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The revolution is a unit of plane angle defined as 6.283185 radian."@en;
        rdfs:label    "revolution"@en;
        :definition   :_6.283185_radian;
        :dimension    :dimension_one;
        :symbol       "r" .

:radian  rdf:type     owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The radian is a unit of plane angle defined as the plane angle subtended at the center of a circle by an arc that is equal in length to the radius of the circle."@en;
        rdfs:label    "弧度"@zh , "radian"@en , "radiaal"@nl;
        :definition   :metre_per_metre;
        :dimension    :dimension_one;
        :longcomment  "The radian is a unit of plane angle defined as the plane angle subtended at the center of a circle by an arc that is equal in length to the radius of the circle. The radian is a derived unit in the International System of Units.";
        :symbol       "rad" .

:minute-plane_angle  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The minute (plane angle) is a unit of plane angle defined as 2.908882e-4 radian."@en;
        rdfs:label          "minuut (hoek)"@nl , "minute (plane angle)"@en;
        :alternative_label  "minute of arc"@en , "minute (angle)"@en , "arcminuut"@nl , "arcminute"@en;
        :definition         :_2.908882e-4_radian;
        :dimension          :dimension_one;
        :symbol             "'" .

:millisecond-plane_angle
        rdf:type            owl:NamedIndividual , :Unit_multiple_or_submultiple;
        rdfs:comment        "The millisecond (plane angle) is a unit of length defined as 1.0e-3 second (plane angle). Gebruikt in de astronomie (metingen van posities van sterren/sterrenstelsels etc.) om de fout weer te geven."@en;
        rdfs:label          "milliseconde (hoek)"@nl , "millisecond (plane angle)"@en;
        :alternative_label  "millisecond of arc"@en , "millisecond (angle)"@en , "milliboogseconde"@nl , "milliarcsecond"@en;
        :dimension          :dimension_one;
        :prefix             :milli;
        :singular_unit      :second-plane_angle;
        :symbol             "mas" .

:mil-plane_angle  rdf:type  owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The mil (plane angle) is a unit of plane angle defined as 9.817477e-4 radian."@en;
        rdfs:label          "mil (plane angle)"@en;
        :alternative_label  "mil (angle)"@en;
        :definition         :_9.817477e-4_radian;
        :dimension          :dimension_one .

:microsecond-plane_angle
        rdf:type            owl:NamedIndividual , :Unit_multiple_or_submultiple;
        rdfs:comment        "The microsecond (plane angle) is a unit of length defined as 1.0e-6 second (plane angle). Gebruikt in de astronomie (metingen van posities van sterren/sterrenstelsels etc.) om de fout weer te geven. De nieuwe satellieten zijn zo nauwkeurig dat deze fout mogelijk is geworden (GAIA-satelliet)."@en;
        rdfs:label          "microseconde (hoek)"@nl , "microsecond (plane angle)"@en;
        :alternative_label  "microsecond of arc"@en , "microsecond (angle)"@en , "microboogseconde"@nl , "microarcsecond"@en;
        :dimension          :dimension_one;
        :prefix             :milli;
        :singular_unit      :second-plane_angle;
        :symbol             "μas" .

:metre_per_metre  rdf:type   owl:NamedIndividual , :Unit_division;
        rdfs:label           "metre per metre"@en , "meter per meter"@nl;
        :alternative_symbol  "m·m-1" , "m m-1";
        :denominator         :metre;
        :dimension           :dimension_one;
        :numerator           :metre;
        :symbol              "m/m" .

:gon    rdf:type            owl:NamedIndividual , :Singular_unit;
        rdfs:comment        "The gon is a unit of plane angle defined as 1.570796e-2 radian."@en;
        rdfs:label          "gon"@en;
        :alternative_label  "grade"@en;
        :definition         :_1.570796e-2_radian;
        :dimension          :dimension_one;
        :symbol             "gon" .

:degree  rdf:type     owl:NamedIndividual , :Singular_unit;
        rdfs:comment  "The degree is a unit of plane angle defined as 1.745329e-2 radian."@en;
        rdfs:label    "度"@zh , "graad"@nl , "degree"@en;
        :definition   :_1.745329e-2_radian;
        :dimension    :dimension_one;
        :symbol       "°" .

:Radian_multiple_or_submultiple
        rdf:type             owl:Class;
        rdfs:subClassOf      :Unit_multiple_or_submultiple;
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :radian;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ];
        owl:equivalentClass  [ rdf:type            owl:Class;
                               owl:intersectionOf  ( [ rdf:type           owl:Restriction;
                                                       owl:allValuesFrom  :SI_prefix;
                                                       owl:onProperty     :prefix
                                                     ]
                                                     [ rdf:type        owl:Restriction;
                                                       owl:hasValue    :radian;
                                                       owl:onProperty  :singular_unit
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :prefix
                                                     ]
                                                     [ rdf:type         owl:Restriction;
                                                       owl:cardinality  "1"^^xsd:nonNegativeInteger;
                                                       owl:onProperty   :singular_unit
                                                     ]
                                                   )
                             ] .

:Plane_angle_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Radian_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :degree :gon :metre_per_metre :microsecond-plane_angle :mil-plane_angle :millisecond-plane_angle :minute-plane_angle :radian :revolution :second-plane_angle )
                                              ]
                                            )
                             ];
        owl:equivalentClass  [ rdf:type     owl:Class;
                               owl:unionOf  ( :Radian_multiple_or_submultiple
                                              [ rdf:type   owl:Class;
                                                owl:oneOf  ( :degree :gon :metre_per_metre :microsecond-plane_angle :mil-plane_angle :millisecond-plane_angle :minute-plane_angle :radian :revolution :second-plane_angle )
                                              ]
                                            )
                             ] .

