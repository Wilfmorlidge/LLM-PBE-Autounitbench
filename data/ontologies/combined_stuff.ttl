        :unit_of_measure  :terametre_per_second-time , :picometre_per_second-time , :petametre_per_second-time , :nanometre_per_second-time , :millimetre_per_second-time , :micrometre_per_second-time , :metre_per_terasecond-time , :metre_per_picosecond-time , :metre_per_petasecond-time , :metre_per_nanosecond-time , :metre_per_millisecond-time , :metre_per_microsecond-time , :metre_per_megasecond-time , :metre_per_kilosecond-time , :metre_per_hectosecond-time , :metre_per_gigasecond-time , :metre_per_femtosecond-time , :metre_per_exasecond-time , :metre_per_decisecond-time , :metre_per_decasecond-time , :metre_per_centisecond-time , :metre_per_attosecond-time , :megametre_per_second-time , :kilometre_per_second-time , :hectometre_per_second-time , :gigametre_per_second-time , :femtometre_per_second-time , :centimetre_per_day , :kilometre_per_hour , :knot-international , :metre_per_day , :metre_per_second-time , :millimetre_per_day , :millimetre_per_hour , :nautical_mile-international_per_hour , :attometre_per_second-time , :centimetre_per_second-time , :decametre_per_second-time , :decimetre_per_second-time , :exametre_per_second-time .

