        :base         :metre;
        :dimension    :volume-dimension;
        :exponent     3;
        :longcomment  "Cubic metre is a unit of volume defined as the volume of a cube whose sides measure exactly one metre. Cubic metre is a derived unit in the International System of Units.";
        :symbol       "m3" .

:cubic_kiloparsec  rdf:type  owl:NamedIndividual , :Unit_exponentiation;
        rdfs:label  "kubieke kiloparsec"@nl , "cubic kiloparsec"@en;
