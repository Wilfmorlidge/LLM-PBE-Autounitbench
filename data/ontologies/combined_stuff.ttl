:Moment_of_inertia  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment         "Moment of inertia is a measure of the effectiveness of mass in rotation."@en;
        rdfs:label           "traagheidsmoment"@nl , "moment of inertia"@en;
        rdfs:subClassOf      :Quantity;
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Moment_of_inertia_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        rdfs:subClassOf      [ rdf:type           owl:Restriction;
                               owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                    owl:allValuesFrom  :Moment_of_inertia_unit;
                                                    owl:onProperty     :unit_of_measure_or_measurement_scale
                                                  ];
                               owl:onProperty     :value
                             ];
        :alternative_label   "massatraagheidsmoment"@nl;
        :alternative_symbol  "J";
        :symbol              "I";
        :unit_of_measure     :kilogram_square_metre .

