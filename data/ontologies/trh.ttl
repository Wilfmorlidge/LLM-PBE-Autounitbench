                               owl:onProperty fma:has_mass ;
                               owl:hasValue "true"^^xsd:boolean
                             ] ;

             fma:FMAID "67165" ;
             fma:definition "Physical anatomical entity which has mass. Examples: hemoglobin molecule, mitochondrion, hepatocyte, erythrocyte, heart, head, blood, urine." ;
