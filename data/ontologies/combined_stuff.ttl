        rdfs:subClassOf     :Quantity;
        :alternative_label  "electron ionization efficiency"@en;
        :symbol             "s_e" .

:Ionisation_temperature
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "The temperature of a gas or plasma derived from the relative numbers of neutral atoms and ions. Specifically, it is the temperature for which the Saha equations would predict these relative numbers, assuming the atoms and ions are in thermodynamic equilibrium."@en;
        rdfs:label        "ionisation temperature"@en;
        rdfs:subClassOf   :Temperature;
        :symbol           "T_ion";
        :unit_of_measure  :kelvin .

:Ion_temperature  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "ion temperature"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "T_i" .

:Ion_cyclotron_circular_frequency
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "ion cyclotron circular frequency"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "ω_ci" .

:Ion-ion_recombination_coefficient
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "ion-ion recombination coefficient"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "α_i" .

:Intrinsic_number_density
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:label        "intrinsic number density"@en;
        rdfs:subClassOf   :Number_density;
        :symbol           "n_i";
        :unit_of_measure  :reciprocal_cubic_metre .

:Intrinsic_colour_index
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "The colour index a star would have in the absence of interstellar extinction (reddening). It is assumed that all stars of the same spectral type and luminosity class have the same colour index."@en;
        rdfs:label        "intrinsic colour index"@en;
        rdfs:subClassOf   :Colour_index;
        :unit_of_measure  :magnitude .

:Interval_scale  rdf:type  owl:Class;
        rdfs:label       "interval scale"@en;
        rdfs:subClassOf  :Cardinal_scale .

:Internal_energy  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:comment      "The internal energy of a thermodynamic system, or a body with well-defined boundaries is the total of the kinetic energy due to the motion of molecules (translational, rotational, vibrational) and the potential energy associated with the vibrational and electric energy of atoms within molecules or crystals."@en;
        rdfs:label        "internal energy"@en , "inwendige energie"@nl;
        rdfs:subClassOf   :Energy;
        :symbol           "U";
        :unit_of_measure  :terajoule , :picojoule , :petajoule , :nanojoule , :millijoule , :microjoule , :megajoule , :megaerg , :kilojoule , :kilocalorie-mean , :hectojoule , :gigajoule , :femtojoule , :exajoule , :decijoule , :decajoule , :centijoule , :attojoule , :ton_of_TNT , :therm-US , :therm-EC , :terawatt_hour , :quad , :newton_metre , :millinewton_metre , :micronewton_metre , :megaelectronvolt , :kilowatt_hour , :kiloelectronvolt , :joule , :gigaelectronvolt , :foot_poundal , :erg , :calorie-thermochemical , :calorie-International_Table , :calorie-mean , :electronvolt , :British_thermal_unit-39_F , :British_thermal_unit-59_F , :British_thermal_unit-60_F , :British_thermal_unit-International_Table , :British_thermal_unit-mean , :British_thermal_unit-thermochemical , :calorie-15_C , :calorie-20_C .

:Internal_conversion_coefficient
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:label       "internal conversion coefficient"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "α" .

:Interaction_energy_between_particles_i_and_j
        rdf:type             owl:Class , owl:NamedIndividual;
