                                                 owl:onProperty     :unit_of_measure_or_measurement_scale
                                               ];
                            owl:onProperty     :value
                          ];
        :unit_of_measure  :zettabyte , :zettabit , :zebibyte , :zebibit , :yottabyte , :yottabit , :yobibyte , :yobibit , :terabyte , :terabit , :tebibyte , :tebibit , :petabyte , :petabit , :pebibyte , :pebibit , :megabyte , :megabit , :mebibyte , :mebibit , :kilobyte , :kilobit , :kibibyte , :kibibit , :bit , :byte , :hartley , :shannon , :exabit , :exabyte , :exbibit , :exbibyte , :gibibit , :gibibyte , :gigabit , :gigabyte .

:Inertia  rdf:type       owl:Class;
        rdfs:comment     "Inertia is the resistance of an object to a change in its state of motion"@en;
        rdfs:label       "inertia"@en;
        rdfs:subClassOf  :Quantity .

