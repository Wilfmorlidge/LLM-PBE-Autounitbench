                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty TrhOnt:hasTimespan ;
                                                                                    owl:allValuesFrom TrhOnt:Timespan
                                                                                  ]
                                                                                ) ;
                                                             rdf:type owl:Class
                                                           ] ;
