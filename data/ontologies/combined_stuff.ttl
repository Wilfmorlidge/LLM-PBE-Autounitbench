        rdfs:label           "zettagram per litre"@en , "zettagram per liter"@nl;
        :alternative_symbol  "Zg·l-1" , "Zg l-1";
        :denominator         :litre;
        :dimension           :density-dimension;
        :numerator           :zettagram;
        :symbol              "Zg/l" .

:zetta  rdf:type    owl:NamedIndividual , :SI_prefix;
        rdfs:label  "zetta"@nl , "zetta"@en;
