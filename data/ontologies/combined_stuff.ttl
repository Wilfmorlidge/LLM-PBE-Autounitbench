:Gibbs_function  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "Gibbs-functie"@nl , "Gibbs function"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "G" .

:Geometrical_albedo  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment        "Ratio between the brightness of an object as seen from the direction of a hypothetical white, diffusely reflecting sphere of the same size and at the same distance."@en;
        rdfs:label          "geometrical albedo"@en;
        rdfs:subClassOf     :Albedo;
        :alternative_label  "physical albedo"@en , "astronomical albedo"@en;
        :symbol             "A";
        :unit_of_measure    :one .

:Generalised_momentum
        rdf:type             owl:NamedIndividual , owl:Class;
        rdfs:label           "generalised momentum"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_symbol  "p_i";
        :symbol              "p" .

:Generalised_coordinate
        rdf:type             owl:NamedIndividual , owl:Class;
        rdfs:label           "generalised coordinate"@en , "gegeneraliseerde coördinaat"@nl;
        rdfs:subClassOf      :Quantity;
        :alternative_symbol  "q_i";
        :symbol              "q" .

:Gelatin_mass_fraction
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "The fraction of the mass of gelatin in a phenomenon"@en;
        rdfs:label        "gelatin mass fraction"@en;
        rdfs:subClassOf   :Mass_fraction;
        :unit_of_measure  :gram_per_gram , :percent , :one .

:joule_per_kelvin_mole
        rdf:type             owl:NamedIndividual , :Unit_division;
        rdfs:label           "joule per kelvin mole"@en , "joule per kelvin mol"@nl;
        :alternative_symbol  "J·K-1·mol-1" , "J/(K·mol)" , "J K-1 mol-1";
        :denominator         :kelvin_mole;
        :dimension           :molar_entropy_or_molar_heat_capacity_or_gas_constant-dimension;
        :numerator           :joule;
        :symbol              "J/(K mol)" .

:molar_entropy_or_molar_heat_capacity_or_gas_constant-dimension
        rdf:type                       owl:NamedIndividual , :Dimension;
        rdfs:label                     "molar entropy, molar heat capacity, or gas constant dimension"@en;
        :SI_amount_of_substance_dimension_exponent
                -1;
        :SI_electric_current_dimension_exponent
                0;
        :SI_length_dimension_exponent  2;
        :SI_luminous_intensity_dimension_exponent
                0;
        :SI_mass_dimension_exponent    1;
        :SI_thermodynamic_temperature_dimension_exponent
                -1;
        :SI_time_dimension_exponent    -2 .

:Gas_constant_unit  rdf:type  owl:Class;
        rdfs:subClassOf      :Unit_of_measure;
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :joule_per_kelvin_mole )
                             ];
        owl:equivalentClass  [ rdf:type   owl:Class;
                               owl:oneOf  ( :joule_per_kelvin_mole )
                             ] .

:Gas_constant  rdf:type     owl:NamedIndividual , owl:Class;
        rdfs:label          "gasconstante"@nl , "gas constant"@en;
        rdfs:subClassOf     :Quantity;
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :molar_entropy_or_molar_heat_capacity_or_gas_constant-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Gas_constant_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        rdfs:subClassOf     [ rdf:type        owl:Restriction;
                              owl:hasValue    :molar_entropy_or_molar_heat_capacity_or_gas_constant-dimension;
                              owl:onProperty  :dimension
                            ];
        rdfs:subClassOf     [ rdf:type           owl:Restriction;
                              owl:allValuesFrom  [ rdf:type           owl:Restriction;
                                                   owl:allValuesFrom  :Gas_constant_unit;
                                                   owl:onProperty     :unit_of_measure_or_measurement_scale
                                                 ];
                              owl:onProperty     :value
                            ];
        :alternative_label  "universele gasconstante"@nl , "universal gas constant"@en;
        :symbol             "R";
        :unit_of_measure    :joule_per_kelvin_mole .

:Galactic_longitude  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "The angular distance on the celestial sphere measured clockwise from the galactic centre (as defined by the International Astronomical Union (IAU)) along the galactic equator to the intersection with the great circle drawn from the galactic north pole through the object."@en;
        rdfs:label        "galactic longitude"@en;
        rdfs:subClassOf   :Plane_angle;
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/chapter13_Astronomical_Algorithms>;
        :symbol           "l";
        :unit_of_measure  :second-plane_angle , :minute-plane_angle , :degree .

:Galactic_latitude  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "The angular distance on the celestial sphere north or south of the galactic equator. It is measured along the great circle passing through the object and the galactic poles and perpendicular to the galactic equator."@en;
        rdfs:label        "galactic latitude"@en;
        rdfs:subClassOf   :Plane_angle;
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/chapter13_Astronomical_Algorithms>;
        :symbol           "b";
        :unit_of_measure  :second-plane_angle , :minute-plane_angle , :degree .

:Galactic_cylindrical_polar_angle_coordinate
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "The angle from the Galactic centre between the perpendicular projection of the Sun on the Galactic plane and the projection of the object. This is one of the three Galactic Cylindrical Polar Coordinates."@en;
        rdfs:label        "galactic cylindrical polar angle coordinate"@en;
        rdfs:subClassOf   :Plane_angle;
        :symbol           "φ";
        :unit_of_measure  :radian , :degree .

:G-factor  rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:comment        "The g-factor is a dimensionless quantity that characterises the magnetic moment and gyromagnetic ratio of a particle or nucleus."@en;
        rdfs:label          "g-factor"@en;
        rdfs:subClassOf     :Quantity;
        :alternative_label  "g-value"@en , "dimensionless magnetic moment"@en;
        :symbol             "g" .

:Fundamental_translation_vectors_where_δik_is_the_Kronecker_delta_symbol
        rdf:type             owl:Class;
        rdfs:label           "fundamental translation vectors where δik is the Kronecker delta symbol"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_label   "circular fundamental translation vectors where δik is the Kronecker delta symbol"@en;
        :alternative_symbol  "c*" , "b*";
        :symbol              "a*" .

:Fundamental_translation_vectors_for_the_reciprocal_lattice
        rdf:type             owl:NamedIndividual , owl:Class;
        rdfs:label           "fundamental translation vectors for the reciprocal lattice"@en;
        rdfs:subClassOf      :Quantity;
        :alternative_label   "circular fundamental translation vectors for the reciprocal lattice"@en;
        :alternative_symbol  "b_3" , "b_2";
        :symbol              "b_1" .

:Fundamental_translation_vectors_for_the_crystal_lattice
