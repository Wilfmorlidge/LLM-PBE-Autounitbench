:Normalised_detectivity
        rdf:type         owl:NamedIndividual , owl:Class;
        rdfs:comment     "The detectivity normalised by multiplying by the square root of the detector area, and by the electrical bandwidth. The units cm Hz(1/2)/W are commonly used and it then represents the signal-to-noise ratio when 1 W of radiation is incident on a detector with an area of 1 cm2, and the electrical bandwidth is 1 Hz."@en;
        rdfs:label       "normalised detectivity"@en;
        rdfs:subClassOf  :Quantity;
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/Astrophysical_Techniques_chapter1>;
        :symbol          "D*" .

:Normal_stress  rdf:type  owl:Class , owl:NamedIndividual;
        rdfs:label        "normaalspanning"@nl , "normal stress"@en;
        rdfs:subClassOf   :Stress;
        :unit_of_measure  :terapascal , :picopascal , :petapascal , :nanopascal , :millipascal , :micropascal , :megapascal , :kilopascal , :hectopascal , :gigapascal , :femtopascal , :exapascal , :decipascal , :decapascal , :centipascal , :attopascal , :torr , :newton_per_square_metre , :pascal , :atmosphere-standard , :atmosphere-technical , :bar , :barye , :centimetre_of_mercury , :decibar , :kilogram_second-time_to_the_power_-2_reciprocal_metre , :metre_of_mercury , :microbar , :millibar , :millimetre_of_mercury .

:Normal_strain  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label        "normal strain"@en , "normaalvervorming"@nl;
        rdfs:subClassOf   :Strain;
        :unit_of_measure  :percent , :one .

:Normal_coordinates  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:label       "normal coordinates"@en;
        rdfs:subClassOf  :Quantity;
        :symbol          "Q_i" .

:Normal_albedo  rdf:type  owl:NamedIndividual , owl:Class;
        rdfs:comment      "Ratio between radiation falling vertically onto an object and the radiation radiated back vertically."@en;
        rdfs:label        "normal albedo"@en;
        rdfs:subClassOf   :Albedo;
        :unit_of_measure  :one .

:Noise_equivalent_power
        rdf:type          owl:NamedIndividual , owl:Class;
        rdfs:comment      "Radiative flux on a detector needed for a signal/noise ratio of 1 (Kitchin, Astrophysical Techniques, IoP, Table 1.1.2)."@en;
        rdfs:label        "noise equivalent power"@en;
        rdfs:subClassOf   :Power;
        <http://www.wurvoc.org/bibliography/om-1.8/reference>
                <http://www.wurvoc.org/bibliography/om-1.8/Astrophysical_Techniques_chapter1>;
        :symbol           "NEP";
        :unit_of_measure  :watt .

